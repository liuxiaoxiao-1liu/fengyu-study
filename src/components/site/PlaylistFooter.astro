---
interface Props {
  trackCount: number;
  albumCount: number;
}

const { trackCount, albumCount } = Astro.props;
---

<div class="bg-surface-container-low rounded-xl p-5 shadow-sm flex flex-wrap items-center justify-between gap-space-sm border border-surface-container-high/40">
  <div class="flex items-center gap-space-sm min-w-0">
    <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-secondary shrink-0">
      <span class="material-symbols-outlined text-lg">library_music</span>
    </div>
    <div class="flex flex-col min-w-0">
      <span class="font-headline-sm text-sm text-primary font-medium truncate">酷狗歌单: 网文高燃与修仙BGM #02</span>
      <span class="font-label-sm text-xs text-on-surface-variant truncate">
        已收录 {trackCount} 首曲目 · {albumCount} 张唱片
      </span>
    </div>
  </div>
  <a
    class="px-space-sm py-1.5 bg-surface-container hover:bg-surface-container-high rounded text-primary font-label-sm text-xs transition-colors font-medium"
    href="https://www.kugou.com/"
    target="_blank"
    rel="noopener noreferrer external"
  >
    酷狗收听
  </a>
</div>
