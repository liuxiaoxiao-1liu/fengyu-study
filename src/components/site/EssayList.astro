---
import type { Essay } from '../../data/essays';
import { formatEssayDate } from '../../data/essays';

interface Props {
  essays: Essay[];
}

const { essays } = Astro.props;
---

{essays.map((essay, index) => (
  <article class="group border-b border-line py-7 first:pt-0" data-target={essay.kind} data-tags={essay.tags.join('|')}>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-label-sm text-muted">
      <span class="font-medium text-secondary">{essay.category}</span>
      <span aria-hidden="true">/</span>
      <time datetime={essay.date}>{formatEssayDate(essay.date)}</time>
      <span class="flex items-center gap-1">
        <span class="material-symbols-outlined text-sm" aria-hidden="true">
          schedule
        </span>
        {essay.readMinutes} 分钟阅读
      </span>
      <span class="ml-auto font-mono text-meta tracking-[0.08em]">
        #{String(essays.length - index).padStart(3, '0')}
      </span>
    </div>

    <h2 class="mt-2 font-headline-md text-headline-md text-primary">
      <a class="transition-colors group-hover:text-accent" href={`/essays/${essay.slug}/`}>
        {essay.title}
      </a>
    </h2>

    <blockquote class="mt-4 border-l-2 border-accent-decor pl-4 font-quote text-body-lg italic leading-relaxed text-on-surface">
      {essay.quote}
    </blockquote>

    <p class="mt-3 max-w-2xl text-body-md leading-relaxed text-on-surface-variant">{essay.summary}</p>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-space-sm text-label-sm text-muted">
        {essay.tags.map((tag) => (
          <button
            type="button"
            class="min-h-11 rounded-full px-2.5 transition-colors hover:bg-surface-container hover:text-primary"
            data-tag={tag}
          >
            #{tag}
          </button>
        ))}
      </div>
      <a
        class="inline-flex min-h-9 items-center gap-1 font-label-md text-label-md font-medium text-accent hover:underline"
        href={`/essays/${essay.slug}/`}
      >
        阅读全文
        <span
          class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          arrow_forward
        </span>
      </a>
    </div>
  </article>
))}
