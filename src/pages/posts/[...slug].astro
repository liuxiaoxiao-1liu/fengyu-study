---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, formatISO, getPosts, postPath, readingTime, tagPath, type Post } from '../../lib/posts';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: index > 0 ? posts[index - 1] : undefined,
      older: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const cover = post.data.cover;
const both = Boolean(newer && older);
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  image={cover}
  type="article"
  published={post.data.date}
  progress
>
  <div class="container container--narrow">
    <a class="back-link" href="/archive/"><span aria-hidden="true">←</span> 全部文章</a>

    <header class="post-header">
      {post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <a href={tagPath(tag)}>#{tag}</a>
          ))}
        </div>
      )}

      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-summary">{post.data.summary}</p>

      <div class="post-meta">
        <time datetime={formatISO(post.data.date)}>{formatDate(post.data.date)}</time>
        <span>约 {readingTime(post)} 分钟</span>
      </div>
    </header>

    {cover && (
      <figure class="post-cover">
        <img src={cover} alt={post.data.coverAlt ?? ''} loading="eager" decoding="async" />
        {post.data.coverCaption && <figcaption>{post.data.coverCaption}</figcaption>}
      </figure>
    )}

    <article class="prose">
      <Content />
    </article>

    <footer class="post-footer">
      <div class="post-footer__tags">
        <span>标记：</span>
        {post.data.tags.map((tag) => (
          <a href={tagPath(tag)}>#{tag}</a>
        ))}
      </div>

      {(newer || older) && (
        <nav class={`post-nav${both ? '' : ' post-nav--single'}`} aria-label="文章导航">
          {older && (
            <a href={postPath(older)}>
              <span class="post-nav__label">上一篇 · 更早</span>
              <span class="post-nav__title">{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a href={postPath(newer)}>
              <span class="post-nav__label">下一篇 · 更新</span>
              <span class="post-nav__title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </footer>
  </div>
</BaseLayout>
