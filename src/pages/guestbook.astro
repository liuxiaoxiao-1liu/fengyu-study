---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listLinks } from '../lib/content-db';
import ArchiveFilters from '../components/guestbook/ArchiveFilters.astro';
import BottleModal from '../components/guestbook/BottleModal.astro';
import FriendsPanel from '../components/guestbook/FriendsPanel.astro';
import GuestbookForm from '../components/guestbook/GuestbookForm.astro';
import GuestbookHero from '../components/guestbook/GuestbookHero.astro';
import LettersList from '../components/guestbook/LettersList.astro';

export const prerender = false;

const links = listLinks();
---

<BaseLayout current="guestbook" title="留言">
  <main class="w-full bg-surface" id="main">
    <div class="flex w-full flex-col pt-nav-h">
      <GuestbookHero />

      <section class="section pt-8">
        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
          <GuestbookForm />
          <FriendsPanel links={links} />
        </div>
      </section>

      <section class="section pt-0" id="archive">
        <ArchiveFilters />
        <div class="mt-4">
          <LettersList />
        </div>
      </section>

      <BottleModal />
    </div>
  </main>
  <script>
    import '../scripts/guestbook/index';
  </script>
</BaseLayout>
