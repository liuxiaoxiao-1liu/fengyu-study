---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatEssayDate } from '../../data/essays';
import { listEssays } from '../../lib/content-db';
import { SITE } from '../../lib/site';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const sorted = listEssays();
const index = sorted.findIndex((item) => item.slug === slug);
if (index < 0) return Astro.redirect('/essays/');

const essay = sorted[index]!;
const newer = index > 0 ? sorted[index - 1]! : null;
const older = index < sorted.length - 1 ? sorted[index + 1]! : null;
---

<BaseLayout current="essays" title={essay.title} description={essay.summary}>
  <main id="main" class="w-full pt-20 bg-surface min-h-[calc(100vh-14rem)] relative overflow-hidden">
    <div
      class="absolute -top-24 right-0 w-[28rem] h-[28rem] rounded-full bg-secondary-container/25 blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 w-full max-w-3xl mx-auto px-gutter pt-space-lg pb-space-xl">
      <a
        class="inline-flex items-center gap-space-xs font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors"
        href="/essays/"
      >
        <span class="material-symbols-outlined text-base">arrow_back</span>
        <span>回到随记</span>
      </a>

      <header class="mt-space-lg pb-space-lg border-b border-surface-container-high">
        <div class="flex flex-wrap items-center gap-x-space-sm gap-y-1 font-label-sm text-label-sm text-on-surface-variant">
          <span class="text-secondary font-medium tracking-wide">{essay.category}</span>
          <span class="text-outline-variant" aria-hidden="true">
            ·
          </span>
          <time datetime={essay.date}>{formatEssayDate(essay.date)}</time>
          <span class="text-outline-variant" aria-hidden="true">
            ·
          </span>
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">schedule</span>约 {essay.readMinutes} 分钟
          </span>
        </div>
        <h1 class="font-headline-lg text-headline-lg-mobile sm:text-headline-lg text-primary tracking-tight font-normal mt-space-sm text-balance">
          <Fragment set:html={essay.title.replace('：', '：<br class="hidden sm:block" />')} />
        </h1>
      </header>

      <figure class="mt-space-lg p-space-lg bg-surface-container-low rounded-xl border-l-2 border-secondary/50">
        <blockquote class="font-quote text-quote italic text-primary leading-relaxed">{essay.quote}</blockquote>
      </figure>

      <article class="prose-editorial mt-space-xl">
        <Fragment set:html={essay.body} />
      </article>

      <footer class="mt-space-xl pt-space-lg border-t border-surface-container-high flex flex-col gap-space-lg">
        <div class="flex flex-wrap items-center gap-space-sm font-label-sm text-label-sm text-on-surface-variant">
          <span>收录于</span>
          <span class="px-space-sm py-0.5 rounded bg-surface-container text-secondary">{essay.category}</span>
          {essay.tags.map((tag) => (
            <span class="px-space-sm py-0.5 rounded bg-surface-container text-on-surface-variant">#{tag}</span>
          ))}
        </div>

        <div class="flex items-center justify-between gap-space-md font-label-sm text-label-sm text-on-surface-variant">
          <span class="italic">
            写于 {formatEssayDate(essay.date)} · {SITE.name}
          </span>
          <a class="inline-flex items-center gap-1 hover:text-primary transition-colors" href="#main">
            <span>回到顶部</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>

        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-space-md pt-space-sm" aria-label="文章翻页">
          {older && (
            <a
              class="group flex flex-col gap-space-xs p-space-md rounded-lg bg-surface-container-low hover:bg-surface-container transition-colors"
              href={`/essays/${older.slug}/`}
            >
              <span class="font-label-sm text-label-sm text-on-surface-variant">上一篇 · 更早</span>
              <span class="font-headline-sm text-headline-sm text-primary leading-snug group-hover:text-on-tertiary-container transition-colors">
                {older.title}
              </span>
            </a>
          )}
          {newer && (
            <a
              class="group flex flex-col gap-space-xs p-space-md rounded-lg bg-surface-container-low hover:bg-surface-container transition-colors sm:text-right"
              href={`/essays/${newer.slug}/`}
            >
              <span class="font-label-sm text-label-sm text-on-surface-variant">下一篇 · 更新</span>
              <span class="font-headline-sm text-headline-sm text-primary leading-snug group-hover:text-on-tertiary-container transition-colors">
                {newer.title}
              </span>
            </a>
          )}
        </nav>
      </footer>
    </div>
  </main>
</BaseLayout>
