---
interface Props {
  photoCount: number;
}

const { photoCount } = Astro.props;
---

<article
  class="lg:col-span-5 bg-surface-container-low rounded-xl p-space-lg shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between"
  id="visual-gallery"
>
  <div class="flex items-center justify-between pb-space-sm border-b border-surface-container-high">
    <div class="flex items-center gap-2 font-label-sm text-label-sm text-secondary">
      <span class="material-symbols-outlined text-base">palette</span>
      <span class="uppercase tracking-widest font-semibold">光影图鉴 · Visual Mix</span>
    </div>
    <span class="font-label-sm text-label-sm text-on-surface-variant">动漫 / 摄影 / 3D虚拟</span>
  </div>
  <div class="my-space-md bg-surface-container p-space-md rounded-lg shadow-sm flex flex-col gap-space-sm">
    <div class="grid grid-cols-3 gap-2">
      <div class="rounded overflow-hidden aspect-square bg-surface-container-highest relative group">
        <img
          alt="Anime aesthetic sky"
          class="w-full h-full object-cover"
          decoding="async"
          height="279"
          loading="lazy"
          src="/images/anime-sky.jpg"
          width="512"
        />
        <span class="absolute bottom-1 left-1 px-1 rounded bg-primary/70 text-on-primary font-label-sm text-[0.625rem]">
          校园摄影
        </span>
      </div>
      <div class="rounded overflow-hidden aspect-square bg-surface-container-highest relative group">
        <img
          alt="Anime city night view"
          class="w-full h-full object-cover"
          decoding="async"
          height="279"
          loading="lazy"
          src="/images/photos/store.jpg"
          width="512"
        />
        <span class="absolute bottom-1 left-1 px-1 rounded bg-primary/70 text-on-primary font-label-sm text-[0.625rem]">
          动漫氛围
        </span>
      </div>
      <div class="rounded overflow-hidden aspect-square bg-primary/10 flex flex-col items-center justify-center p-2 text-center border border-dashed border-secondary">
        <span class="material-symbols-outlined text-secondary text-xl">token</span>
        <span class="font-label-sm text-[0.625rem] text-primary font-medium mt-1">虚拟CG探索</span>
        <span class="font-label-sm text-[0.625rem] text-on-surface-variant">Blender渲染</span>
      </div>
    </div>
    <div class="pt-1 flex items-end justify-between">
      <div>
        <p class="font-body-md text-body-md text-primary font-medium tracking-tight">现实与二次元的色彩交界</p>
        <p class="font-label-sm text-label-sm text-on-surface-variant mt-0.5">从校园余晖到新海诚风天空</p>
      </div>
      <span class="font-label-sm text-label-sm text-secondary tracking-widest font-mono"> {photoCount} 张收录 </span>
    </div>
  </div>
  <div class="flex items-center justify-between pt-space-xs">
    <div class="flex items-center gap-space-xs">
      <span class="font-label-sm text-label-sm bg-surface-container px-space-xs py-0.5 rounded text-on-surface-variant">
        #动漫壁纸
      </span>
      <span class="font-label-sm text-label-sm bg-surface-container px-space-xs py-0.5 rounded text-on-surface-variant">
        #扫街胶片
      </span>
    </div>
    <a
      class="font-label-sm text-label-sm text-on-tertiary-container hover:text-primary transition-colors flex items-center gap-1 font-medium"
      href="/photos/"
    >
      <span class="">浏览完整相册</span>
      <span class="material-symbols-outlined text-xs">arrow_forward</span>
    </a>
  </div>
</article>
