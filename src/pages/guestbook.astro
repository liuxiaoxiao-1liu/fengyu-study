---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listLinks } from '../lib/content-db';
import ArchiveFilters from '../components/guestbook/ArchiveFilters.astro';
import BottleModal from '../components/guestbook/BottleModal.astro';
import FriendsPanel from '../components/guestbook/FriendsPanel.astro';
import GuestbookForm from '../components/guestbook/GuestbookForm.astro';
import GuestbookHero from '../components/guestbook/GuestbookHero.astro';
import LettersList from '../components/guestbook/LettersList.astro';

export const prerender = false;

const links = listLinks();
---

<BaseLayout current="guestbook" title="留言">
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-14rem)]" id="main">
    <div class="flex flex-col w-full">
      <GuestbookHero />
      <!-- Section 2: Interactive Bento Section (Form + Owner's Board) -->
      <section class="w-full max-w-6xl mx-auto px-gutter pb-space-xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
          <GuestbookForm />
          <FriendsPanel links={links} />
        </div>
      </section>
      <!-- Section 3: Guestbook Stream / Letters Corridor -->
      <section class="w-full max-w-6xl mx-auto px-gutter pb-space-xl" id="archive">
        <ArchiveFilters />
        <LettersList />
      </section>
      <BottleModal />
    </div>
  </main>
  <script>
    import '../scripts/guestbook/index';
  </script>
</BaseLayout>
