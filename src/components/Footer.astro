---
import { SITE, NAV } from '../lib/site';

const year = new Date().getFullYear();
const span = year > SITE.startYear ? `${SITE.startYear}–${year}` : String(SITE.startYear);
---

<footer class="w-full border-t border-line bg-surface-container-low">
  <div class="mx-auto w-full max-w-7xl px-gutter py-section-sm">
    <div class="grid gap-space-xl md:grid-cols-12 md:gap-space-lg">
      <div class="md:col-span-5 flex flex-col gap-space-sm">
        <a class="inline-flex min-h-11 items-center gap-space-sm" href="/" aria-label="回到首页">
          <img alt="" class="h-7 w-auto object-contain" src="/images/logo.png" width="96" height="96" />
          <span class="font-headline-sm text-headline-sm text-primary">{SITE.name}</span>
        </a>
        <p class="max-w-sm font-body-sm text-body-sm leading-relaxed text-muted">{SITE.description}</p>
        <p class="font-quote text-body-md italic leading-relaxed text-on-surface-variant">
          “生活原本沉闷，但跑起来就有风。保持阅读，保持聆听。”
        </p>
      </div>

      <nav class="md:col-span-3" aria-label="页脚导航">
        <h2 class="eyebrow">板块</h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-space-md gap-y-1">
          {NAV.map((item) => (
            <li>
              <a
                class="inline-flex min-h-9 items-center font-body-sm text-body-sm text-on-surface-variant hover:text-primary"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-2">
        <h2 class="eyebrow">订阅</h2>
        <ul class="mt-3 flex flex-col gap-1">
          <li>
            <a
              class="inline-flex min-h-9 items-center font-body-sm text-body-sm text-on-surface-variant hover:text-primary"
              href="/rss.xml"
            >
              RSS
            </a>
          </li>
          <li>
            <a
              class="inline-flex min-h-9 items-center font-body-sm text-body-sm text-on-surface-variant hover:text-primary"
              href="/guestbook/"
            >
              写一封信
            </a>
          </li>
          <li>
            <a
              class="inline-flex min-h-9 items-center font-body-sm text-body-sm text-on-surface-variant hover:text-primary"
              href="/sitemap.xml"
            >
              站点地图
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h2 class="eyebrow">在别处</h2>
        <ul class="mt-3 flex flex-col gap-1">
          <li>
            <a
              class="inline-flex min-h-9 items-center font-body-sm text-body-sm text-on-surface-variant hover:text-primary"
              href="https://www.douban.com/"
              target="_blank"
              rel="noopener noreferrer external"
            >
              豆瓣
            </a>
          </li>
          <li>
            <a
              class="inline-flex min-h-9 items-center font-body-sm text-body-sm text-on-surface-variant hover:text-primary"
              href="https://music.163.com/"
              target="_blank"
              rel="noopener noreferrer external"
            >
              网易云音乐
            </a>
          </li>
          <li>
            <a
              class="inline-flex min-h-9 items-center font-body-sm text-body-sm text-on-surface-variant hover:text-primary"
              href="https://www.instagram.com/"
              target="_blank"
              rel="noopener noreferrer external"
            >
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-space-lg flex flex-col gap-2 border-t border-line pt-space-md sm:flex-row sm:items-center sm:justify-between">
      <p class="font-meta text-meta uppercase tracking-[0.12em] text-muted">
        © {span} {SITE.name} · {SITE.latin}
      </p>
      <p class="font-meta text-meta text-muted">Astro · Node · SQLite · 手工排版 · 部分内容为示例</p>
    </div>
  </div>
</footer>
