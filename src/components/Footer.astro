---
import { SITE } from '../lib/site';

const year = new Date().getFullYear();
const span = year > SITE.startYear ? `${SITE.startYear}–${year}` : String(SITE.startYear);
---

<footer class="w-full bg-surface-container-low py-space-xl mt-space-xl shadow-[0_-1px_6px_rgba(0,0,0,0.02)]">
  <div class="w-full max-w-5xl mx-auto px-gutter flex flex-col items-center text-center gap-space-lg">
    <div class="flex flex-col items-center gap-space-sm max-w-2xl">
      <span class="material-symbols-outlined text-secondary/70 text-2xl" aria-hidden="true">auto_stories</span>
      <p class="font-quote text-quote italic text-primary leading-relaxed">
        “生活原本沉闷，但跑起来就有风。保持阅读，保持聆听，用镜头与笔触留住微光。”
      </p>
      <span class="font-label-sm text-label-sm text-on-surface-variant tracking-wider uppercase">— Island of Solitude Journal Log</span>
    </div>

    <nav class="flex flex-wrap items-center justify-center gap-space-md text-on-surface-variant" aria-label="页脚导航">
      <a class="font-label-md text-label-md hover:text-on-surface transition-colors" href="https://www.douban.com/" target="_blank" rel="noopener noreferrer external">豆瓣 Douban</a>
      <span class="text-outline-variant text-xs" aria-hidden="true">·</span>
      <a class="font-label-md text-label-md hover:text-on-surface transition-colors" href="https://music.163.com/" target="_blank" rel="noopener noreferrer external">网易云音乐 Netease</a>
      <span class="text-outline-variant text-xs" aria-hidden="true">·</span>
      <a class="font-label-md text-label-md hover:text-on-surface transition-colors" href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer external">摄影录 Instagram</a>
      <span class="text-outline-variant text-xs" aria-hidden="true">·</span>
      <a class="font-label-md text-label-md hover:text-on-surface transition-colors" href="/rss.xml">RSS 订阅</a>
      <span class="text-outline-variant text-xs" aria-hidden="true">·</span>
      <a class="font-label-md text-label-md hover:text-on-surface transition-colors" href="/guestbook/">拾光留言箱</a>
    </nav>

    <div class="flex flex-wrap items-center justify-center gap-space-sm font-label-sm text-label-sm text-on-surface-variant">
      <span class="bg-surface-container px-space-sm py-0.5 rounded text-on-surface-variant">Built with Astro &amp; Tailwind</span>
      <span>© {span} {SITE.name} {SITE.latin}. All rights reserved.</span>
    </div>
  </div>
</footer>
