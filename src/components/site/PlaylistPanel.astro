---
interface Props {
  playlistSlug: string;
  playlistName: string;
}

const { playlistSlug, playlistName } = Astro.props;
---

<div class="lg:col-span-7 bg-surface-container-low rounded-xl p-6 shadow-sm border border-surface-container-high/40">
  <div class="flex flex-col gap-3 pb-3 mb-3 border-b border-surface-container-high/60">
    <div class="flex flex-wrap items-center justify-between gap-space-sm">
      <div class="flex flex-wrap items-center justify-between gap-space-sm">
        <div class="flex items-center gap-space-xs min-w-0">
          <span class="font-headline-sm text-headline-sm text-primary font-medium" data-playlist-title>
            {playlistName} · 我的歌单
          </span>
          <span class="font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant hidden sm:inline-block">
            <span data-playlist-count>—</span> 首 · 站内可播
          </span>
        </div>
        <span class="font-label-sm text-label-sm text-on-surface-variant">从酷狗账号自动同步</span>
      </div>
    </div>
    <div class="flex flex-col gap-1.5" id="playlist-tracks" data-slug={playlistSlug} data-page="1" data-total-pages="1">
      <p class="rounded-lg border border-dashed border-outline-variant p-6 text-center font-body-sm text-body-sm text-on-surface-variant">
        正在从酷狗同步歌单…
      </p>
    </div>
    <div class="flex items-center justify-between gap-space-sm pt-1" id="playlist-pager">
      <button
        type="button"
        class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface-variant font-label-sm text-xs hover:bg-surface-container-high disabled:opacity-40 disabled:cursor-not-allowed"
        data-page-prev
        disabled
      >
        上一页
      </button>
      <span class="font-label-sm text-xs text-on-surface-variant" data-page-info>
        {' '}
        正在同步…{' '}
      </span>
      <button
        type="button"
        class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface-variant font-label-sm text-xs hover:bg-surface-container-high disabled:opacity-40 disabled:cursor-not-allowed"
        data-page-next
        disabled
      >
        下一页
      </button>
    </div>
  </div>
</div>
