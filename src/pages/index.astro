---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroProfile from '../components/site/HeroProfile.astro';
import HobbyGrid from '../components/site/HobbyGrid.astro';
import StatsSection from '../components/site/StatsSection.astro';
import HomeGuestbook from '../components/site/HomeGuestbook.astro';
import { listBooks, listEssays, listPhotos, listTracks } from '../lib/content-db';

export const prerender = false;

const books = listBooks();
const tracks = listTracks();
const photos = listPhotos();
const essays = listEssays();
const featuredBook = books.find((book) => book.featured) ?? books[0]!;
const featuredTrack = tracks[0]!;
const latestEssay = essays[0]!;
---

<BaseLayout current="home">
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-14rem)]" id="main">
    <div class="flex flex-col w-full">
      <!-- Top Welcome & Ticker Header -->
      <HeroProfile />
      <!-- Four Highlight Feature Quadrants / Bento Grid -->
      <HobbyGrid
        featuredBook={featuredBook}
        featuredTrack={featuredTrack}
        tracks={tracks}
        photoCount={photos.length}
        latestEssay={latestEssay}
      />
      <!-- Quick Stats & Vibe Bar -->
      <StatsSection
        bookCount={books.length}
        trackCount={tracks.length}
        photoCount={photos.length}
        essayCount={essays.length}
      />
      <!-- Guestbook / Letterbox Mini Preview Section -->
      <HomeGuestbook />
    </div>
  </main>
  <script>
    import '../scripts/site/home.ts';
  </script>
</BaseLayout>
