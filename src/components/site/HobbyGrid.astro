---
import type { Book } from '../../data/books';
import type { Essay } from '../../data/essays';
import type { Track } from '../../data/music';
import ReadingCard from './ReadingCard.astro';
import MusicCard from './MusicCard.astro';
import VisualCard from './VisualCard.astro';
import NotesCard from './NotesCard.astro';

interface Props {
  featuredBook: Book;
  featuredTrack: Track;
  tracks: Track[];
  photoCount: number;
  latestEssay: Essay;
}

const { featuredBook, featuredTrack, tracks, photoCount, latestEssay } = Astro.props;
---

<section class="section" id="reading-music">
  <div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-line pb-3">
      <div>
        <p class="eyebrow">01 / Hobbies &amp; Passions</p>
        <h2 class="mt-1 font-headline-md text-headline-md text-primary">精神自留地四重奏</h2>
      </div>
      <p class="text-body-sm text-muted">网文追更 · 酷狗音乐 · 多元画境 · 杂谈笔记</p>
    </div>

    <div class="grid grid-cols-1 items-stretch gap-5 lg:grid-cols-12">
      <ReadingCard featuredBook={featuredBook} />
      <MusicCard featuredTrack={featuredTrack} tracks={tracks} />
      <VisualCard photoCount={photoCount} />
      <NotesCard essay={latestEssay} />
    </div>
  </div>
</section>
