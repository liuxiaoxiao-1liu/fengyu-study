---
// 站内播放器：由页面里的 [data-play] 按钮驱动（首页卡片、读听歌单、专辑归档共用）。
// 浏览器 <audio> 负责解码；音源地址只通过站内 /api/kugou/url 获取。
interface Props {
  audioCount?: number;
}

const { audioCount = 0 } = Astro.props;
const emptyHint = audioCount > 0 ? '选择曲目开始播放。' : '当前没有可播放的站内音源，可点曲目右侧外链去酷狗收听。';
---

<section
  class="mt-4 pt-3 bg-surface-container/50 p-3 rounded-lg flex flex-col gap-2"
  data-player
  id="site-player"
  aria-label="站内播放器"
>
  <div class="flex flex-wrap items-center justify-between gap-space-sm">
    <div class="flex flex-col min-w-0">
      <span class="font-label-sm text-xs flex items-center gap-1.5 text-on-surface-variant">
        <span class="w-1.5 h-1.5 rounded-full bg-on-tertiary-container" data-player-dot aria-hidden="true"></span>
        站内播放器
        <span data-player-state>· {audioCount > 0 ? '等待选择曲目' : '暂无站内音源'}</span>
      </span>
      <strong class="text-primary font-medium text-sm truncate" data-player-title>
        还没有选择曲目
      </strong>
      <span class="font-label-sm text-xs text-on-surface-variant truncate" data-player-artist>
        {emptyHint}
      </span>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        class="w-9 h-9 rounded-full bg-surface-container-high text-on-surface-variant hover:bg-primary hover:text-on-primary transition-colors flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed"
        data-player-toggle
        aria-label="播放或暂停"
        disabled
      >
        <span class="flex items-center justify-center" data-player-icon>
          <svg class="w-5 h-5" data-player-icon-play viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z"></path>
          </svg>
          <svg class="w-5 h-5 hidden" data-player-icon-pause viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
          </svg>
        </span>
      </button>
      <a
        class="hidden font-label-sm text-xs text-secondary hover:underline items-center gap-1"
        data-player-external
        href="https://www.kugou.com/"
        target="_blank"
        rel="noopener noreferrer external"
      >
        酷狗收听<span class="material-symbols-outlined text-xs">open_in_new</span>
      </a>
    </div>
  </div>
  <div class="flex items-center gap-3 text-on-surface-variant">
    <span class="font-label-sm text-xs tabular-nums w-10 text-right" data-player-current>
      00:00
    </span>
    <input
      class="flex-1 h-1 accent-secondary cursor-pointer disabled:cursor-not-allowed"
      data-player-seek
      type="range"
      min="0"
      max="0"
      step="0.1"
      value="0"
      aria-label="播放进度"
      disabled
    />
    <span class="font-label-sm text-xs tabular-nums w-10" data-player-duration>
      --:--
    </span>
  </div>
  <audio data-player-audio preload="auto"></audio>
</section>

<script>
  const player = document.querySelector<HTMLElement>('[data-player]');
  if (player) {
    const audio = player.querySelector<HTMLAudioElement>('[data-player-audio]');
    const toggle = player.querySelector<HTMLButtonElement>('[data-player-toggle]');
    const playIcon = player.querySelector<HTMLElement>('[data-player-icon-play]');
    const pauseIcon = player.querySelector<HTMLElement>('[data-player-icon-pause]');
    const title = player.querySelector<HTMLElement>('[data-player-title]');
    const artist = player.querySelector<HTMLElement>('[data-player-artist]');
    const state = player.querySelector<HTMLElement>('[data-player-state]');
    const current = player.querySelector<HTMLElement>('[data-player-current]');
    const duration = player.querySelector<HTMLElement>('[data-player-duration]');
    const seek = player.querySelector<HTMLInputElement>('[data-player-seek]');
    const external = player.querySelector<HTMLAnchorElement>('[data-player-external]');

    type TrackCommand = {
      hash?: string;
      audio?: string;
      title: string;
      artist: string;
      external: string;
    };

    let currentTrack: TrackCommand | null = null;
    let retried = false;
    let pendingResume = 0;

    const formatTime = (seconds: number) => {
      if (!Number.isFinite(seconds) || seconds < 0) return '00:00';
      const total = Math.floor(seconds);
      return `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
    };

    const setPlaying = (playing: boolean) => {
      playIcon?.classList.toggle('hidden', playing);
      pauseIcon?.classList.toggle('hidden', !playing);
      if (state) state.textContent = playing ? '· 正在播放' : '· 已暂停';
    };

    const updateDuration = () => {
      if (!audio) return;
      const known = Number.isFinite(audio.duration) && audio.duration > 0;
      if (duration) duration.textContent = known ? formatTime(audio.duration) : '--:--';
      if (seek) {
        seek.max = String(known ? audio.duration : 0);
        seek.disabled = !known;
      }
    };

    const readCommand = (button: HTMLButtonElement): TrackCommand => ({
      hash: button.dataset.hash || undefined,
      audio: button.dataset.audio || undefined,
      title: button.dataset.title || '未命名曲目',
      artist: button.dataset.artist || '',
      external: button.dataset.external || 'https://www.kugou.com/',
    });

    const setTrackMeta = (track: TrackCommand) => {
      if (title) title.textContent = track.title;
      if (artist) artist.textContent = track.artist;
      if (external) {
        external.href = track.external;
        external.classList.remove('hidden');
        external.classList.add('flex');
      }
      if (current) current.textContent = '00:00';
      if (seek) seek.value = '0';
      if (toggle) toggle.disabled = false;
      if (seek) seek.disabled = false;
    };

    function describeError(data: { error?: string } | null, status: number) {
      if (data?.error === 'rate_limited' || status === 429) return '· 播放请求太频繁，等几分钟再试';
      if (data?.error === 'kugou_disabled' || status === 503) return '· 站内音源未配置，可去酷狗收听';
      return '· 音源解析失败，可去酷狗收听';
    }

    async function fetchPlayUrl(hash: string) {
      let lastStatus = 0;
      let lastData: { ok?: boolean; url?: string; error?: string } | null = null;

      // 网络抖错误一次；限流、未配置、白名单外不重试，避免放大请求。
      for (let attempt = 0; attempt < 2; attempt += 1) {
        const response = await fetch(`/api/kugou/url?hash=${encodeURIComponent(hash)}`, {
          headers: { accept: 'application/json' },
        });
        lastStatus = response.status;
        lastData = (await response.json().catch(() => null)) as {
          ok?: boolean;
          url?: string;
          error?: string;
        } | null;
        if (response.ok && lastData?.ok === true && typeof lastData.url === 'string') {
          return lastData.url;
        }
        if (response.status === 429 || response.status === 503 || response.status === 404) break;
        if (attempt === 0) await new Promise((resolve) => setTimeout(resolve, 350));
      }

      throw new Error(describeError(lastData, lastStatus));
    }

    async function playKugou(hash: string, resumeAt = 0) {
      if (!audio) return;
      if (state) state.textContent = '· 正在解析酷狗音源…';
      const url = await fetchPlayUrl(hash);
      if (state) state.textContent = '· 正在加载音源…';
      pendingResume = resumeAt > 0 ? resumeAt : 0;
      audio.src = url;
      audio.load();
      try {
        await audio.play();
      } catch {
        if (state) state.textContent = '· 音源已就绪，点播放继续';
      }
    }

    async function handlePlay(button: HTMLButtonElement) {
      if (!audio) return;
      const track = readCommand(button);
      currentTrack = track;
      retried = false;
      setTrackMeta(track);
      if (state) state.textContent = '· 正在加载…';

      if (track.audio) {
        pendingResume = 0;
        audio.src = new URL(track.audio, window.location.href).href;
        audio.load();
        try {
          await audio.play();
        } catch {
          if (state) state.textContent = '· 音源已就绪，点播放继续';
        }
        return;
      }

      if (!track.hash) {
        if (state) state.textContent = '· 这首没有可播放的站内音源';
        return;
      }

      try {
        await playKugou(track.hash);
      } catch (error) {
        if (state) state.textContent = error instanceof Error ? error.message : '· 音源解析失败，可去酷狗收听';
        if (toggle) toggle.disabled = true;
      }
    }

    // 曲目按钮由服务端渲染或列表动态插入，统一用事件委托绑定播放。
    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-play]') : null;
      if (!target || target.disabled) return;
      void handlePlay(target);
    });

    toggle?.addEventListener('click', () => {
      if (!audio || !audio.src) return;
      if (audio.paused) {
        void audio.play();
      } else {
        audio.pause();
      }
    });

    audio?.addEventListener('play', () => setPlaying(true));
    audio?.addEventListener('pause', () => setPlaying(false));
    audio?.addEventListener('ended', () => setPlaying(false));
    audio?.addEventListener('loadedmetadata', () => {
      if (!audio) return;
      updateDuration();
      if (pendingResume > 0 && Number.isFinite(audio.duration)) {
        audio.currentTime = Math.min(pendingResume, Math.max(0, audio.duration - 0.5));
      }
      pendingResume = 0;
    });
    audio?.addEventListener('durationchange', updateDuration);
    audio?.addEventListener('timeupdate', () => {
      if (!audio) return;
      if (current) current.textContent = formatTime(audio.currentTime);
      if (seek && Number.isFinite(audio.duration) && audio.duration > 0) {
        seek.value = String(audio.currentTime);
      }
    });

    // 酷狗直链有 TTL：过期/断流时重新取一次地址，并尽量从原位置续播。
    audio?.addEventListener('error', () => {
      if (!audio) return;
      if (currentTrack?.hash && !retried) {
        retried = true;
        const resumeAt = Number.isFinite(audio.currentTime) ? audio.currentTime : 0;
        if (state) state.textContent = '· 音源过期，正在重新解析…';
        void playKugou(currentTrack.hash, resumeAt).catch((error) => {
          if (state) state.textContent = error instanceof Error ? error.message : '· 音源加载失败，可去酷狗收听';
          if (toggle) toggle.disabled = true;
        });
        return;
      }
      if (state) state.textContent = '· 音源加载失败，可去酷狗收听';
      if (toggle) toggle.disabled = true;
    });

    seek?.addEventListener('input', () => {
      if (!audio || !Number.isFinite(audio.duration)) return;
      audio.currentTime = Number(seek.value);
      // 知识库的播放管线约定：暂停中拖动进度条，语义是“继续听”。
      if (audio.paused) void audio.play().catch(() => {});
    });
  }
</script>
