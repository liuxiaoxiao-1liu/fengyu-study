---
import type { Book } from '../../data/books';

interface Props {
  featuredBook: Book;
}

const { featuredBook } = Astro.props;
const percent = Number(featuredBook.progress?.match(/(\d+)%/)?.[1] ?? 84);
---

<article class="card flex flex-col p-6 lg:col-span-7" id="reading">
  <header class="flex items-center justify-between gap-3 border-b border-line pb-3">
    <span class="flex items-center gap-2 font-label-md text-label-md font-medium text-on-surface">
      <span class="material-symbols-outlined text-base text-secondary" aria-hidden="true">
        menu_book
      </span>
      网文书架
    </span>
    <span class="meta">{featuredBook.words}</span>
  </header>

  <div class="grid flex-1 grid-cols-1 items-center gap-5 py-5 sm:grid-cols-12">
    <div class="flex justify-center sm:col-span-4">
      <a
        class="group relative block aspect-[3/4] w-32 overflow-hidden rounded-lg bg-surface-container-high shadow-md sm:w-36"
        href={featuredBook.url}
        target="_blank"
        rel="noopener noreferrer external"
        aria-label={`去起点中文网阅读${featuredBook.title}`}
      >
        <img
          alt={`${featuredBook.title}封面`}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          src={featuredBook.cover}
          width="360"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>

    <div class="flex flex-col sm:col-span-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip bg-surface-container-high text-on-surface">{featuredBook.genre}</span>
        <span class="meta">同步追读 · 道诡异仙</span>
      </div>
      <h3 class="mt-2 font-headline-sm text-headline-sm text-primary">
        <a class="hover:text-accent" href={featuredBook.url} target="_blank" rel="noopener noreferrer external">
          {featuredBook.title}
        </a>
      </h3>
      <p class="mt-0.5 text-body-sm text-muted">{featuredBook.author} 著</p>
      <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">{featuredBook.blurb}</p>

      <div class="mt-4">
        <div class="flex items-center justify-between text-label-sm">
          <span class="text-muted">{featuredBook.progress ?? '阅读中'}</span>
          <span class="font-medium text-primary">{percent}%</span>
        </div>
        <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-surface-container">
          <div class="h-full rounded-full bg-secondary" style={`width: ${percent}%`}></div>
        </div>
      </div>
    </div>
  </div>

  <blockquote class="border-l-2 border-accent-decor bg-surface-container/70 px-4 py-3 font-quote text-body-md italic leading-relaxed text-on-surface">
    {featuredBook.quote}
  </blockquote>

  <footer class="mt-4 flex items-center justify-between">
    <span class="meta">起点中文网 · 全书</span>
    <a
      class="inline-flex min-h-9 items-center gap-1 font-label-md text-label-md font-medium text-accent hover:underline"
      href={featuredBook.url}
      target="_blank"
      rel="noopener noreferrer external"
    >
      去起点读全书
      <span class="material-symbols-outlined text-sm" aria-hidden="true">
        open_in_new
      </span>
    </a>
  </footer>
</article>
