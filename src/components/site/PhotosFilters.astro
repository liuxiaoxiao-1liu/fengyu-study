---
import type { PhotoSeries } from '../../data/photos';

interface SeriesFilter {
  value: PhotoSeries;
  label: string;
  english: string;
  count: number;
}

interface Props {
  photoCount: number;
  series: ReadonlyArray<SeriesFilter>;
}

const { photoCount, series } = Astro.props;

const tabs = [
  { value: 'all', label: '全部', count: photoCount },
  ...series.map((item) => ({ value: item.value, label: item.label, count: item.count })),
];
---

<nav aria-label="按视觉系列筛选" class="mt-6 border-b border-line pb-4">
  <div class="flex flex-col gap-2">
    <div class="scroll-row" id="filter-container" role="group">
      {tabs.map((tab, index) => (
        <button
          class="filter-pill filter-btn"
          data-filter={tab.value}
          type="button"
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {tab.label}
          <span class="font-meta text-meta opacity-70 tabular-nums">{tab.count}</span>
        </button>
      ))}
    </div>
    <span class="hidden items-center gap-1.5 text-label-sm text-muted sm:flex">
      <span class="material-symbols-outlined text-sm" aria-hidden="true">
        tune
      </span>
      按视觉编目与色调倒序
    </span>
  </div>
</nav>
