---
interface Props {
  photoCount: number;
}

const { photoCount } = Astro.props;

const shots = [
  { src: '/images/anime-sky.jpg', alt: '校园上空的动漫感天空', label: '校园摄影', width: 512, height: 512 },
  { src: '/images/photos/store.jpg', alt: '雨夜便利店的霓虹倒影', label: '扫街胶片', width: 512, height: 512 },
];
---

<article class="card flex flex-col p-6 lg:col-span-5" id="visual-gallery">
  <header class="flex items-center justify-between gap-3 border-b border-line pb-3">
    <span class="flex items-center gap-2 font-label-md text-label-md font-medium text-on-surface">
      <span class="material-symbols-outlined text-base text-secondary" aria-hidden="true">
        palette
      </span>
      光影图鉴
    </span>
    <span class="meta">{photoCount} 张收录</span>
  </header>

  <div class="flex flex-1 flex-col justify-center py-5">
    <div class="grid grid-cols-3 gap-2">
      {shots.map((shot) => (
        <div class="relative aspect-square overflow-hidden rounded-lg bg-surface-container-high">
          <img
            alt={shot.alt}
            class="h-full w-full object-cover transition-transform duration-300 hover:scale-[1.03]"
            src={shot.src}
            width={shot.width}
            height={shot.height}
            loading="lazy"
            decoding="async"
          />
          <span class="absolute bottom-1 left-1 rounded bg-primary/70 px-1.5 py-0.5 font-meta text-meta text-on-primary">
            {shot.label}
          </span>
        </div>
      ))}
      <a
        class="flex aspect-square flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-line-strong bg-surface-container/60 p-2 text-center transition-colors hover:bg-surface-container"
        href="/photos/"
      >
        <span class="material-symbols-outlined text-xl text-secondary" aria-hidden="true">
          token
        </span>
        <span class="font-meta text-meta font-medium text-primary">虚拟 CG</span>
        <span class="font-meta text-meta text-muted">Blender 渲染</span>
      </a>
    </div>

    <div class="mt-4 flex items-end justify-between gap-3">
      <div>
        <p class="font-body-md font-medium tracking-tight text-primary">现实与二次元的色彩交界</p>
        <p class="mt-0.5 text-body-sm text-muted">从校园余晖到新海诚风天空</p>
      </div>
      <span class="meta shrink-0">动漫 / 摄影 / 3D</span>
    </div>
  </div>

  <footer class="flex items-center justify-between border-t border-line pt-3">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="chip bg-surface-container text-on-surface-variant">#动漫壁纸</span>
      <span class="chip bg-surface-container text-on-surface-variant">#扫街胶片</span>
    </div>
    <a
      class="inline-flex min-h-9 items-center gap-1 font-label-md text-label-md font-medium text-accent hover:underline"
      href="/photos/"
    >
      浏览相册
      <span class="material-symbols-outlined text-sm" aria-hidden="true">
        arrow_forward
      </span>
    </a>
  </footer>
</article>
