---
import type { Track } from '../../data/music';
import { kugouSearchUrl } from '../../data/music';

interface Props {
  featuredTrack: Track;
  tracks: Track[];
}

const { featuredTrack, tracks } = Astro.props;
const canPlay = Boolean(featuredTrack.kugou?.hash || featuredTrack.audio);
---

<article class="card flex flex-col p-6 lg:col-span-5" id="music">
  <header class="flex items-center justify-between gap-3 border-b border-line pb-3">
    <span class="flex items-center gap-2 font-label-md text-label-md font-medium text-on-surface">
      <span class="material-symbols-outlined text-base text-secondary" aria-hidden="true">
        graphic_eq
      </span>
      酷狗音乐
    </span>
    <span class="meta">蝰蛇全景声</span>
  </header>

  <button
    type="button"
    class="group mt-5 flex w-full items-center gap-4 rounded-lg bg-surface-container p-4 text-left transition-colors hover:bg-surface-container-high"
    data-play
    data-hash={featuredTrack.kugou?.hash}
    data-title={featuredTrack.title}
    data-artist={featuredTrack.artist}
    data-external={kugouSearchUrl(featuredTrack)}
    aria-label={canPlay ? `播放 ${featuredTrack.title}` : `在酷狗搜索 ${featuredTrack.title}`}
  >
    <span class="relative flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-primary shadow-md">
      <span class="flex h-12 w-12 items-center justify-center rounded-full border border-surface-container-highest/30 motion-safe:animate-[spin_8s_linear_infinite]">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-secondary font-meta text-on-secondary">
          KG
        </span>
      </span>
      <span class="absolute inset-0 flex items-center justify-center rounded-full bg-primary/60 text-on-primary opacity-0 transition-opacity group-hover:opacity-100">
        <span class="material-symbols-outlined text-2xl" aria-hidden="true">
          play_arrow
        </span>
      </span>
    </span>
    <span class="flex min-w-0 flex-1 flex-col">
      <span class="meta text-accent">{canPlay ? '酷狗歌单 · 点击播放' : '酷狗搜索 · 点击打开'}</span>
      <span class="mt-1 truncate font-headline-sm text-headline-sm leading-tight text-primary">
        {featuredTrack.title}
      </span>
      <span class="mt-0.5 truncate text-body-sm text-muted">
        {featuredTrack.artist} · {featuredTrack.note}
      </span>
      <span class="mt-2 flex items-center justify-between gap-2">
        <span class="text-label-sm text-secondary">{featuredTrack.tag}</span>
        <span class="meta">
          {featuredTrack.duration} · 共 {tracks.length} 首
        </span>
      </span>
    </span>
  </button>

  <div class="mt-4 border-t border-line pt-3">
    <p class="meta">歌单精选循环</p>
    <div class="mt-1 flex flex-col">
      {tracks.slice(1, 3).map((track) => (
        <button
          type="button"
          class="group flex min-h-11 w-full items-center justify-between gap-2 rounded-md px-2 text-left transition-colors hover:bg-surface-container"
          data-play
          data-hash={track.kugou?.hash}
          data-title={track.title}
          data-artist={track.artist}
          data-external={kugouSearchUrl(track)}
          aria-label={`播放 ${track.title}`}
        >
          <span class="truncate text-body-sm text-primary">
            {track.title} · {track.artist}
          </span>
          <span class="flex shrink-0 items-center gap-2">
            <span class="meta">{track.tag}</span>
            <span
              class="material-symbols-outlined text-sm text-secondary opacity-0 transition-opacity group-hover:opacity-100"
              aria-hidden="true"
            >
              play_arrow
            </span>
          </span>
        </button>
      ))}
    </div>
  </div>

  <footer class="mt-auto flex items-center justify-between border-t border-line pt-3">
    <span class="meta">酷狗歌单 · 实时同步</span>
    <a
      class="inline-flex min-h-9 items-center gap-1 font-label-md text-label-md font-medium text-accent hover:underline"
      href="/reading/#music"
    >
      查看完整歌单
      <span class="material-symbols-outlined text-sm" aria-hidden="true">
        arrow_forward
      </span>
    </a>
  </footer>
</article>
