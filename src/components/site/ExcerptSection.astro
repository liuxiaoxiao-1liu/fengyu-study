---
import type { Quote } from '../../data/quotes';

interface Props {
  quotes: Quote[];
}

const { quotes } = Astro.props;
---

<section class="mt-2" data-excerpt-section id="excerpt">
  <div class="flex flex-wrap items-end justify-between gap-space-sm border-b border-surface-container-high pb-3 mb-5">
    <div>
      <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest block mb-1">
        Excerpts · 台词摘录
      </span>
      <h2 class="font-headline-md text-headline-md text-primary font-normal">被划线的句子</h2>
    </div>
    <span class="font-label-sm text-label-sm text-on-surface-variant">{quotes.length} 条摘录 · 来自随记与歌单</span>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {quotes.map((quote) => (
      <article
        class="group bg-surface-container-low/70 rounded-xl p-5 border-l-2 border-secondary/50 shadow-sm transition-colors hover:bg-surface-container-low"
        data-target="excerpt"
      >
        <blockquote class="font-quote text-[1.05rem] leading-relaxed italic text-primary">{quote.text}</blockquote>
        <div class="mt-4 flex flex-col gap-1">
          <span class="font-label-sm text-label-sm text-secondary font-medium">{quote.source}</span>
          {quote.work && <span class="font-label-sm text-[0.625rem] text-on-surface-variant">{quote.work}</span>}
        </div>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {quote.tags.map((tag) => (
            <span class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant font-label-sm text-[0.625rem]">
              #{tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
