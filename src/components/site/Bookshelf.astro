---
import type { Book } from '../../data/books';

interface Props {
  books: Book[];
}

const { books } = Astro.props;

const groups = [
  { key: 'reading', label: '在读', tone: 'text-secondary', items: books.filter((book) => book.status === 'reading') },
  { key: 'finished', label: '读完', tone: 'text-accent', items: books.filter((book) => book.status === 'finished') },
  { key: 'paused', label: '暂放', tone: 'text-muted', items: books.filter((book) => book.status === 'paused') },
].filter((group) => group.items.length > 0);
---

<section class="section pt-0" id="shelf">
  <div class="flex flex-wrap items-end justify-between gap-3 border-b border-line pb-3">
    <div>
      <p class="eyebrow">Web Novels</p>
      <h2 class="mt-1 font-headline-md text-headline-md text-primary">追更书架与年度网文</h2>
    </div>
    <span class="hidden items-center gap-1 text-label-sm text-muted sm:flex">
      点击书卡跳转起点阅读
      <span class="material-symbols-outlined text-sm" aria-hidden="true">
        south_east
      </span>
    </span>
  </div>

  <div class="mt-6 flex flex-col gap-8">
    {groups.map((group) => (
      <section aria-label={`${group.label}的书`}>
        <div class="mb-3 flex items-center gap-2">
          <span class:list={['font-label-md text-label-md font-medium', group.tone]}>{group.label}</span>
          <span class="meta">{group.items.length} 本</span>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
          {group.items.map((book) => (
            <a
              class="card group flex flex-col justify-between p-5 transition-colors hover:bg-surface-container"
              data-card="book"
              data-category={book.category}
              href={book.url}
              rel="noopener noreferrer external"
              target="_blank"
              aria-label={`去起点中文网阅读${book.title}`}
            >
              <div class="flex items-start gap-4">
                <div class="aspect-[3/4] w-20 shrink-0 overflow-hidden rounded-md bg-surface-container-high">
                  <img
                    alt={`${book.title}封面`}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                    src={book.cover}
                    width="600"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="flex min-w-0 flex-col">
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="chip bg-surface-container text-secondary">{book.genre}</span>
                  </div>
                  <h3 class="mt-1.5 font-headline-sm text-headline-sm text-primary">{book.title}</h3>
                  <span class="mt-0.5 text-body-sm text-muted">{book.author} · 著</span>
                  <p class="mt-2 line-clamp-3 text-body-sm leading-relaxed text-on-surface-variant">{book.blurb}</p>
                </div>
              </div>

              <div class="mt-4 flex items-center justify-between gap-2 border-t border-line pt-3">
                <span class="flex min-w-0 items-center gap-1.5 text-label-sm font-medium text-secondary">
                  <span class="material-symbols-outlined shrink-0 text-sm" aria-hidden="true">
                    forum
                  </span>
                  <span class="truncate">{book.words ?? book.progress ?? '起点中文网'}</span>
                </span>
                <span
                  class="material-symbols-outlined shrink-0 text-sm text-muted transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  open_in_new
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</section>
