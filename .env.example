# 复制为 .env 后填写；.env 已在 .gitignore，不要提交
# 旧管理令牌（仅 Bearer 兼容与脚本；日常后台用 cookie）：至少 32 位随机串（openssl rand -hex 32）
ADMIN_TOKEN=

# 酷狗会员登录态：扫码登录 KuGouMusicApi 后写入；用于 /api/kugou/url 换播放直链。
# 这些值等于账号凭据，只放服务器 .env，绝不进仓库、不贴聊天。
KUGOU_TOKEN=
KUGOU_USERID=
KUGOU_VIP_TOKEN=
KUGOU_VIP_TYPE=
KUGOU_MID=
KUGOU_GUID=
KUGOU_DFID=

# 站内展示的酷狗歌单名（默认 maotouying）；后台设置优先。
# 仅后台还没选过歌单时，这个值才作为默认歌单名。
KUGOU_PLAYLIST_NAME=

# 内容后台登录（scrypt 哈希，不要填明文密码）；由 scripts/set-admin-password.mjs 生成
ADMIN_USER=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# 留言库、内容库与上传目录（本地默认 .data/；容器内固定 /data）
# 保持注释即使用代码默认值；需要改路径时取消注释并填写。
# GUESTBOOK_DB=./.data/guestbook.sqlite
# CONTENT_DB=./.data/content.sqlite
# CONTENT_UPLOADS=./.data/uploads

# 后台扫码登录后的酷狗会话与站内歌单选择（本地默认 .data/；容器内 /data）
# KUGOU_SESSION_FILE=./.data/kugou-session.json
# KUGOU_SETTINGS_FILE=./.data/kugou-settings.json
