---
interface Props {
  bookCount: number;
  trackCount: number;
  photoCount: number;
  essayCount: number;
}

const { bookCount, trackCount, photoCount, essayCount } = Astro.props;

const stats = [
  { label: '网文追读', value: bookCount, unit: '部在架' },
  { label: '酷狗收藏', value: trackCount, unit: '首循环' },
  { label: '视觉图集', value: photoCount, unit: '张收录' },
  { label: '随想随笔', value: essayCount, unit: '篇记录' },
];
---

<section class="section-tight" id="stats">
  <div class="flex flex-col gap-4 rounded-xl border border-line bg-surface-container-low p-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
    <div class="shrink-0">
      <p class="eyebrow">Life Artifacts</p>
      <h2 class="mt-1 font-headline-sm text-headline-sm text-primary">书房与精神刻度</h2>
    </div>

    <dl class="grid grid-cols-2 gap-3 sm:flex sm:flex-1 sm:justify-end">
      {stats.map((item) => (
        <div class="flex min-w-28 flex-col rounded-lg bg-surface-container px-4 py-3">
          <dt class="text-label-sm text-muted">{item.label}</dt>
          <dd class="mt-1 flex items-baseline gap-1.5">
            <span class="font-headline-md text-headline-md font-medium leading-none text-primary tabular-nums">
              {item.value}
            </span>
            <span class="text-label-sm text-secondary">{item.unit}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
