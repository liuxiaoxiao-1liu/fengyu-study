---
import type { Post } from '../lib/posts';
import { formatISO, formatShortDate, postPath } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<li class="post-item">
  <a class="post-row" href={postPath(post)}>
    <time class="post-row__date" datetime={formatISO(post.data.date)}>{formatShortDate(post.data.date)}</time>
    <div>
      <h3 class="post-row__title">{post.data.title}</h3>
      <p class="post-row__summary">{post.data.summary}</p>
      {post.data.tags.length > 0 && (
        <div class="post-row__tags">
          {post.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
    </div>
    <span class="post-row__arrow" aria-hidden="true">↗</span>
  </a>
</li>
