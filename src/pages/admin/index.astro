---
// 内容后台：静态页；登录态走 HttpOnly cookie，数据通过 /api/admin/* 读写。
import '../../styles/fonts.css';
import '../../styles/icons.css';
import '../../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fcf9f4" />
    <title>内容后台 · 风屿书房</title>
    <link rel="icon" href="/images/logo.png" type="image/png" />
  </head>

  <body class="bg-surface font-body-md text-body-md text-on-surface antialiased">
    <main id="main" class="mx-auto flex w-full max-w-6xl flex-col gap-space-lg px-gutter py-space-xl">
      <header class="flex flex-col gap-space-sm">
        <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary">
          OWNER CONSOLE · 房主专席
        </span>
        <h1 class="font-headline-lg text-headline-lg-mobile text-primary sm:text-headline-lg">
          内容后台
          <span class="font-display italic text-headline-md font-normal text-on-surface-variant">Content Desk</span>
        </h1>
        <p class="max-w-3xl font-body-sm leading-relaxed text-body-sm text-on-surface-variant">
          登录后直接在网页上维护影集、随笔、书籍、唱片、曲目、台词、友链、酷狗账号与留言，不需要改代码或重新部署。影集支持上传图片，唱片/曲目封面可填图片地址。
        </p>
        <div class="flex flex-wrap items-center gap-space-md font-label-sm text-label-sm">
          <a class="text-secondary underline decoration-outline-variant underline-offset-4 hover:text-primary" href="/">
            ← 返回书房
          </a>
        </div>
      </header>

      <section
        id="login-panel"
        class="rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm"
      >
        <h2 class="font-headline-sm text-headline-sm text-primary">登录</h2>
        <p class="mt-1 font-body-sm text-body-sm text-on-surface-variant">使用房主账号登录后管理内容。</p>
        <form id="login-form" class="mt-space-md grid max-w-md gap-space-sm">
          <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
            用户名
            <input id="login-user" class="field" autocomplete="username" required />
          </label>
          <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
            密码
            <input id="login-password" type="password" class="field" autocomplete="current-password" required />
          </label>
          <div class="flex items-center gap-space-sm pt-1">
            <button
              type="submit"
              class="rounded-lg bg-primary px-space-lg py-2 font-label-md text-label-md text-on-primary hover:bg-primary-container"
            >
              登录
            </button>
            <span
              id="login-message"
              class="font-label-sm text-label-sm text-error"
              role="status"
              aria-live="polite"
            ></span>
          </div>
        </form>
      </section>

      <section id="dashboard" class="flex flex-col gap-space-lg" hidden>
        <div class="flex flex-wrap items-center justify-between gap-space-sm rounded-xl bg-surface-container-low px-space-lg py-space-md shadow-sm">
          <div class="font-label-sm text-label-sm text-on-surface-variant">
            已登录：<strong class="text-primary" data-session-user></strong>
          </div>
          <div class="flex items-center gap-space-sm">
            <button
              type="button"
              id="logout-button"
              class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
            >
              退出
            </button>
          </div>
        </div>

        <nav
          aria-label="内容类型"
          class="flex flex-wrap gap-2 rounded-xl bg-surface-container-low p-space-sm shadow-sm"
        >
          <button
            type="button"
            data-admin-tab="photos"
            class="admin-tab rounded-lg bg-primary px-space-md py-1.5 font-label-sm text-label-sm text-on-primary"
          >
            影集
          </button>
          <button
            type="button"
            data-admin-tab="letters"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            留言
          </button>
          <button
            type="button"
            data-admin-tab="essays"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            随笔
          </button>
          <button
            type="button"
            data-admin-tab="books"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            书架
          </button>
          <button
            type="button"
            data-admin-tab="albums"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            唱片
          </button>
          <button
            type="button"
            data-admin-tab="tracks"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            曲目
          </button>
          <button
            type="button"
            data-admin-tab="quotes"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            台词
          </button>
          <button
            type="button"
            data-admin-tab="links"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            友链
          </button>
          <button
            type="button"
            data-admin-tab="kugou"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            酷狗
          </button>
        </nav>

        <div id="photos-section" class="grid grid-cols-1 items-start gap-space-lg lg:grid-cols-12">
          <form
            id="photo-form"
            class="flex flex-col gap-space-sm rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm lg:col-span-5"
          >
            <div class="flex items-center justify-between gap-space-sm">
              <h2 id="photo-form-title" class="font-headline-sm text-headline-sm text-primary">
                新增照片
              </h2>
              <button
                type="button"
                id="photo-reset"
                class="font-label-sm text-label-sm text-secondary hover:text-primary"
              >
                清空
              </button>
            </div>
            <input id="photo-id" type="hidden" />

            <div class="flex flex-col gap-2 rounded-lg bg-surface-container p-space-sm">
              <label class="font-label-sm text-label-sm text-on-surface-variant" for="photo-file">
                上传图片
              </label>
              <input
                id="photo-file"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/gif,image/avif"
                class="block w-full max-w-full text-xs text-on-surface-variant file:mr-2 file:rounded file:border-0 file:bg-primary file:px-3 file:py-1.5 file:font-label-sm file:text-label-sm file:text-on-primary"
              />
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="upload-button"
                  class="rounded-lg bg-surface-container-high px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-highest"
                >
                  上传并填入
                </button>
                <span
                  id="upload-status"
                  class="font-label-sm text-[0.625rem] text-on-surface-variant"
                  role="status"
                ></span>
              </div>
              <img id="photo-preview" alt="" class="mt-1 hidden h-28 w-full rounded object-cover" />
            </div>

            <div class="grid grid-cols-1 gap-space-sm sm:grid-cols-2">
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                标题
                <input id="photo-title" class="field" required />
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                slug（英文/数字/-）
                <input id="photo-slug" class="field" />
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                系列
                <select id="photo-series" class="field">
                  <option value="anime">动漫插画</option>
                  <option value="reality">现实纪实</option>
                  <option value="virtual">虚拟 CG</option>
                </select>
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                拍摄日期
                <input id="photo-taken-at" type="date" class="field" />
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                宽（px）
                <input id="photo-width" type="number" min="1" step="1" class="field" value="1200" />
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                高（px）
                <input id="photo-height" type="number" min="1" step="1" class="field" value="800" />
              </label>
            </div>

            <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
              图片地址（上传后自动填入，也可粘外链）
              <input id="photo-src" class="field" required />
            </label>
            <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
              图片描述（alt，必须有）<textarea id="photo-alt" class="field min-h-[4rem]" required></textarea>
            </label>
            <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
              手记 / 图注<textarea id="photo-note" class="field min-h-[4rem]"></textarea>
            </label>
            <div class="grid grid-cols-1 gap-space-sm sm:grid-cols-2">
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                角标（badge）
                <input id="photo-badge" class="field" />
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                排序（越小越靠前）
                <input id="photo-sort-order" type="number" step="1" class="field" value="0" />
              </label>
            </div>

            <details class="rounded-lg bg-surface-container p-space-sm">
              <summary class="cursor-pointer font-label-sm text-label-sm text-secondary">
                EXIF · 拍摄参数（可选）
              </summary>
              <div class="mt-2 grid grid-cols-1 gap-space-sm sm:grid-cols-2">
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  机身
                  <input id="exif-camera" class="field" />
                </label>
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  镜头
                  <input id="exif-lens" class="field" />
                </label>
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  光圈
                  <input id="exif-aperture" class="field" />
                </label>
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  快门
                  <input id="exif-shutter" class="field" />
                </label>
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  ISO
                  <input id="exif-iso" class="field" />
                </label>
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  地点
                  <input id="exif-location" class="field" />
                </label>
              </div>
            </details>

            <div class="flex flex-wrap items-center gap-space-sm pt-1">
              <button
                type="submit"
                class="rounded-lg bg-primary px-space-lg py-2 font-label-md text-label-md text-on-primary hover:bg-primary-container"
              >
                保存照片
              </button>
              <button
                type="button"
                id="photo-delete"
                class="hidden rounded-lg border border-error/40 px-space-md py-2 font-label-sm text-label-sm text-error hover:bg-error/10"
              >
                删除
              </button>
              <span
                id="photo-status"
                class="font-label-sm text-label-sm text-on-surface-variant"
                role="status"
                aria-live="polite"
              ></span>
            </div>
          </form>

          <div class="flex flex-col gap-space-sm lg:col-span-7">
            <div class="flex flex-wrap items-center justify-between gap-space-sm">
              <h2 class="font-headline-sm text-headline-sm text-primary">
                影集列表 <span id="photo-count" class="font-label-sm text-label-sm text-on-surface-variant"></span>
              </h2>
              <button
                type="button"
                id="refresh-button"
                class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
              >
                刷新
              </button>
            </div>
            <div id="photo-list" class="grid grid-cols-1 gap-space-sm sm:grid-cols-2"></div>
          </div>
        </div>

        <div id="records-section" class="flex flex-col gap-space-lg" style="display: none">
          <div class="flex flex-wrap items-center justify-between gap-space-sm">
            <h2 id="records-title" class="font-headline-sm text-headline-sm text-primary">
              随笔
            </h2>
            <div class="flex items-center gap-space-sm">
              <button
                type="button"
                id="record-refresh"
                class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
              >
                刷新
              </button>
              <button
                type="button"
                id="record-new"
                class="rounded-lg bg-primary px-space-md py-1.5 font-label-sm text-label-sm text-on-primary hover:bg-primary-container"
              >
                新增
              </button>
            </div>
          </div>
          <div class="grid grid-cols-1 items-start gap-space-lg lg:grid-cols-12">
            <form
              id="record-form"
              class="flex flex-col gap-space-sm rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm lg:col-span-7"
            >
              <div class="flex items-center justify-between gap-space-sm">
                <h3 id="record-form-title" class="font-headline-sm text-headline-sm text-primary">
                  新增
                </h3>
                <button
                  type="button"
                  id="record-reset"
                  class="font-label-sm text-label-sm text-secondary hover:text-primary"
                >
                  清空
                </button>
              </div>
              <input id="record-id" type="hidden" />
              <div id="record-fields" class="grid grid-cols-1 gap-space-sm sm:grid-cols-2"></div>
              <div class="flex flex-wrap items-center gap-space-sm pt-1">
                <button
                  type="submit"
                  class="rounded-lg bg-primary px-space-lg py-2 font-label-md text-label-md text-on-primary hover:bg-primary-container"
                >
                  保存
                </button>
                <button
                  type="button"
                  id="record-delete"
                  class="hidden rounded-lg border border-error/40 px-space-md py-2 font-label-sm text-label-sm text-error hover:bg-error/10"
                >
                  删除
                </button>
                <span
                  id="record-status"
                  class="font-label-sm text-label-sm text-on-surface-variant"
                  role="status"
                  aria-live="polite"
                ></span>
              </div>
            </form>
            <div class="flex flex-col gap-space-sm lg:col-span-5">
              <h3 id="record-list-title" class="font-headline-sm text-headline-sm text-primary">
                列表 <span id="record-count" class="font-label-sm text-label-sm text-on-surface-variant"></span>
              </h3>
              <div id="record-list" class="flex flex-col gap-space-xs"></div>
            </div>
          </div>
        </div>

        <div id="letters-section" class="flex flex-col gap-space-lg" style="display: none">
          <div class="flex flex-wrap items-center justify-between gap-space-sm">
            <div>
              <h2 class="font-headline-sm text-headline-sm text-primary">留言与悄悄话</h2>
              <p class="mt-1 font-label-sm text-label-sm text-on-surface-variant">
                公开留言、悄悄话与回复都在这里处理，不需要再另开页面。
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-space-sm">
              <button
                type="button"
                id="letters-refresh"
                class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
              >
                刷新
              </button>
              <a
                class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
                href="/api/admin/export?kind=letters&format=json"
                download
              >
                留言 JSON
              </a>
              <a
                class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
                href="/api/admin/export?kind=letters&format=csv"
                download
              >
                留言 CSV
              </a>
              <a
                class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
                href="/api/admin/export?kind=subscribers&format=csv"
                download
              >
                订阅 CSV
              </a>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-space-sm sm:grid-cols-4">
            <div class="rounded-xl bg-surface-container-low p-space-md shadow-sm">
              <span class="font-label-sm text-label-sm text-on-surface-variant">全部</span>
              <strong class="mt-1 block font-headline-sm text-headline-sm text-primary" data-letter-count="total">
                —
              </strong>
            </div>
            <div class="rounded-xl bg-surface-container-low p-space-md shadow-sm">
              <span class="font-label-sm text-label-sm text-on-surface-variant">待审核</span>
              <strong class="mt-1 block font-headline-sm text-headline-sm text-secondary" data-letter-count="pending">
                —
              </strong>
            </div>
            <div class="rounded-xl bg-surface-container-low p-space-md shadow-sm">
              <span class="font-label-sm text-label-sm text-on-surface-variant">已上墙</span>
              <strong class="mt-1 block font-headline-sm text-headline-sm text-primary" data-letter-count="approved">
                —
              </strong>
            </div>
            <div class="rounded-xl bg-surface-container-low p-space-md shadow-sm">
              <span class="font-label-sm text-label-sm text-on-surface-variant">已隐藏</span>
              <strong class="mt-1 block font-headline-sm text-headline-sm text-primary" data-letter-count="hidden">
                —
              </strong>
            </div>
          </div>

          <div class="flex flex-col gap-space-sm sm:flex-row sm:items-center sm:justify-between">
            <div
              class="flex flex-wrap items-center gap-space-xs rounded-full bg-surface-container-low p-1"
              id="letter-filters"
              role="group"
              aria-label="按留言状态筛选"
            >
              <button
                type="button"
                data-letter-filter="all"
                class="rounded-full px-space-md py-space-xs font-label-sm text-label-sm"
              >
                全部
              </button>
              <button
                type="button"
                data-letter-filter="pending"
                class="rounded-full px-space-md py-space-xs font-label-sm text-label-sm"
              >
                待审核
              </button>
              <button
                type="button"
                data-letter-filter="approved"
                class="rounded-full px-space-md py-space-xs font-label-sm text-label-sm"
              >
                已上墙
              </button>
              <button
                type="button"
                data-letter-filter="hidden"
                class="rounded-full px-space-md py-space-xs font-label-sm text-label-sm"
              >
                已隐藏
              </button>
            </div>
            <span
              id="letters-status"
              class="font-label-sm text-label-sm text-on-surface-variant"
              role="status"
              aria-live="polite"
            ></span>
          </div>

          <div id="letters-list" class="flex flex-col gap-space-md"></div>
          <p
            id="letters-empty"
            class="hidden rounded-xl border border-dashed border-outline-variant p-space-lg text-center font-body-sm text-body-sm text-on-surface-variant"
          >
            这个筛选下还没有留言。
          </p>
        </div>

        <div id="kugou-section" class="flex flex-col gap-space-lg" style="display: none">
          <div class="flex flex-wrap items-center justify-between gap-space-sm">
            <div>
              <h2 class="font-headline-sm text-headline-sm text-primary">酷狗账号与歌单</h2>
              <p id="kugou-status" class="mt-1 font-label-sm text-label-sm text-on-surface-variant">
                检查登录状态…
              </p>
            </div>
            <div class="flex items-center gap-space-sm">
              <button
                type="button"
                id="kugou-refresh"
                class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
              >
                刷新
              </button>
              <button
                type="button"
                id="kugou-logout"
                class="rounded-lg border border-error/40 px-space-md py-1.5 font-label-sm text-label-sm text-error hover:bg-error/10"
              >
                退出酷狗
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 items-start gap-space-lg lg:grid-cols-12">
            <div class="flex flex-col gap-space-lg lg:col-span-5">
              <div class="rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm">
                <h3 class="font-headline-sm text-headline-sm text-primary">扫码登录</h3>
                <p class="mt-1 font-body-sm text-body-sm text-on-surface-variant">
                  用手机酷狗 App 扫描二维码，确认后登录态只保存在服务器数据卷里，不下发浏览器。
                </p>
                <button
                  type="button"
                  id="kugou-qr-start"
                  class="mt-space-md rounded-lg bg-primary px-space-lg py-2 font-label-md text-label-md text-on-primary hover:bg-primary-container"
                >
                  生成登录二维码
                </button>
                <div id="kugou-qr-panel" class="mt-space-md flex flex-col items-center gap-2" style="display: none">
                  <img id="kugou-qr-image" alt="酷狗登录二维码" class="h-44 w-44 rounded bg-white p-2 shadow-sm" />
                  <p
                    id="kugou-qr-message"
                    class="font-label-sm text-label-sm text-on-surface-variant"
                    role="status"
                  ></p>
                  <a
                    id="kugou-qr-link"
                    class="font-label-sm text-label-sm text-secondary underline underline-offset-4"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    在酷狗打开
                  </a>
                </div>
              </div>

              <div class="rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm">
                <h3 class="font-headline-sm text-headline-sm text-primary">我的歌单</h3>
                <p class="mt-1 font-body-sm text-body-sm text-on-surface-variant">
                  点「设为站内歌单」切换 `/reading/` 展示的歌单；默认是 `maotouying`。
                </p>
                <div id="kugou-playlists" class="mt-space-sm flex flex-col gap-2"></div>
              </div>
            </div>

            <div class="flex flex-col gap-space-lg lg:col-span-7">
              <div class="rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="font-headline-sm text-headline-sm text-primary">
                    当前站内歌单{' '}
                    <span id="kugou-playlist-name" class="font-label-sm text-label-sm text-on-surface-variant"></span>
                  </h3>
                  <span id="kugou-track-count" class="font-label-sm text-label-sm text-on-surface-variant"></span>
                </div>
                <div id="kugou-tracks" class="mt-space-sm flex max-h-[32rem] flex-col gap-1 overflow-y-auto"></div>
              </div>

              <form
                id="kugou-add-form"
                class="flex flex-col gap-space-sm rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm"
              >
                <h3 class="font-headline-sm text-headline-sm text-primary">向当前歌单添加曲目</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                  酷狗添加接口需要曲目 hash；名称、albumId、albumAudioId
                  可留空。添加后会自动刷新，并让站内歌单缓存失效。
                </p>
                <div class="grid grid-cols-1 gap-space-sm sm:grid-cols-2">
                  <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                    hash *<input id="kugou-add-hash" class="field" required placeholder="32 位 hash" />
                  </label>
                  <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                    歌名
                    <input id="kugou-add-name" class="field" />
                  </label>
                  <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                    albumId
                    <input id="kugou-add-album" class="field" value="0" />
                  </label>
                  <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                    albumAudioId
                    <input id="kugou-add-audio" type="number" class="field" value="0" />
                  </label>
                </div>
                <div class="flex flex-wrap items-center gap-space-sm">
                  <button
                    type="submit"
                    class="rounded-lg bg-primary px-space-lg py-2 font-label-md text-label-md text-on-primary hover:bg-primary-container"
                  >
                    添加
                  </button>
                  <span
                    id="kugou-track-status"
                    class="font-label-sm text-label-sm text-on-surface-variant"
                    role="status"
                    aria-live="polite"
                  ></span>
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <style>
      .field {
        width: 100%;
        border-radius: 0.25rem;
        border: 1px solid #ebe8e3;
        background: #fcf9f4;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        line-height: 1.25rem;
        color: #1c1c19;
      }
      .field:focus {
        outline: none;
        border-color: #526354;
      }
    </style>

    <script>
      type PhotoRecord = {
        id: string;
        slug: string;
        title: string;
        src: string;
        alt: string;
        width: number;
        height: number;
        series: 'anime' | 'reality' | 'virtual';
        takenAt: string;
        note: string;
        badge: string;
        exif?: Record<string, string | undefined>;
        sortOrder: number;
      };

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
      const loginPanel = $('login-panel');
      const dashboard = $('dashboard');
      const loginForm = $<HTMLFormElement>('login-form');
      const loginUser = $<HTMLInputElement>('login-user');
      const loginPassword = $<HTMLInputElement>('login-password');
      const loginMessage = $('login-message');
      const sessionUser = document.querySelector<HTMLElement>('[data-session-user]');
      const photoForm = $<HTMLFormElement>('photo-form');
      const photoFormTitle = $('photo-form-title');
      const photoId = $<HTMLInputElement>('photo-id');
      const photoTitle = $<HTMLInputElement>('photo-title');
      const photoSlug = $<HTMLInputElement>('photo-slug');
      const photoSeries = $<HTMLSelectElement>('photo-series');
      const photoTakenAt = $<HTMLInputElement>('photo-taken-at');
      const photoWidth = $<HTMLInputElement>('photo-width');
      const photoHeight = $<HTMLInputElement>('photo-height');
      const photoSrc = $<HTMLInputElement>('photo-src');
      const photoAlt = $<HTMLTextAreaElement>('photo-alt');
      const photoNote = $<HTMLTextAreaElement>('photo-note');
      const photoBadge = $<HTMLInputElement>('photo-badge');
      const photoSortOrder = $<HTMLInputElement>('photo-sort-order');
      const photoFile = $<HTMLInputElement>('photo-file');
      const photoPreview = $<HTMLImageElement>('photo-preview');
      const uploadStatus = $('upload-status');
      const photoStatus = $('photo-status');
      const photoDelete = $<HTMLButtonElement>('photo-delete');
      const photoList = $('photo-list');
      const photoCount = $('photo-count');
      const exifFields = {
        camera: $<HTMLInputElement>('exif-camera'),
        lens: $<HTMLInputElement>('exif-lens'),
        aperture: $<HTMLInputElement>('exif-aperture'),
        shutter: $<HTMLInputElement>('exif-shutter'),
        iso: $<HTMLInputElement>('exif-iso'),
        location: $<HTMLInputElement>('exif-location'),
      };

      let photos: PhotoRecord[] = [];
      let wantSlug = new URLSearchParams(window.location.search).get('photo');

      function localToday(): string {
        const now = new Date();
        return new Date(now.getTime() - now.getTimezoneOffset() * 60_000).toISOString().slice(0, 10);
      }

      function setText(node: HTMLElement | null, value: string) {
        if (node) node.textContent = value;
      }

      function showLogin(message = '') {
        loginPanel?.removeAttribute('hidden');
        dashboard?.setAttribute('hidden', '');
        setText(loginMessage, message);
      }

      function showDashboard(user: string) {
        loginPanel?.setAttribute('hidden', '');
        dashboard?.removeAttribute('hidden');
        setText(sessionUser, user);
      }

      async function request(path: string, options: RequestInit = {}) {
        const response = await fetch(path, {
          ...options,
          headers: {
            ...(options.body instanceof FormData ? {} : { 'content-type': 'application/json' }),
            ...(options.headers ?? {}),
          },
        });
        let data: any = null;
        try {
          data = await response.json();
        } catch {
          data = null;
        }
        if (response.status === 401) {
          showLogin('登录已过期，请重新登录。');
          throw new Error('unauthorized');
        }
        if (!response.ok || (data && data.ok === false)) {
          throw new Error((data && (data.message || data.error)) || `HTTP ${response.status}`);
        }
        return data;
      }

      async function checkSession() {
        try {
          const data = await request('/api/admin/session');
          showDashboard(data.user);
          await loadSchemas();
          await loadPhotos();
        } catch (error) {
          if (error instanceof Error && error.message === 'unauthorized') return;
          showLogin();
        }
      }

      loginForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        setText(loginMessage, '');
        try {
          const data = await request('/api/admin/login', {
            method: 'POST',
            body: JSON.stringify({ username: loginUser?.value.trim() ?? '', password: loginPassword?.value ?? '' }),
          });
          showDashboard(data.user);
          if (loginPassword) loginPassword.value = '';
          await loadSchemas();
          await loadPhotos();
        } catch (error) {
          setText(loginMessage, error instanceof Error ? error.message : '登录失败');
        }
      });

      $('logout-button')?.addEventListener('click', async () => {
        await fetch('/api/admin/logout', { method: 'POST' });
        window.location.href = '/admin/';
      });

      function fillForm(photo: PhotoRecord) {
        if (photoId) photoId.value = photo.id;
        if (photoTitle) photoTitle.value = photo.title;
        if (photoSlug) photoSlug.value = photo.slug;
        if (photoSeries) photoSeries.value = photo.series;
        if (photoTakenAt) photoTakenAt.value = photo.takenAt;
        if (photoWidth) photoWidth.value = String(photo.width);
        if (photoHeight) photoHeight.value = String(photo.height);
        if (photoSrc) photoSrc.value = photo.src;
        if (photoAlt) photoAlt.value = photo.alt;
        if (photoNote) photoNote.value = photo.note;
        if (photoBadge) photoBadge.value = photo.badge;
        if (photoSortOrder) photoSortOrder.value = String(photo.sortOrder);
        for (const [key, input] of Object.entries(exifFields)) {
          if (input) input.value = photo.exif?.[key] ?? '';
        }
        setText(photoFormTitle, '编辑照片');
        photoDelete?.classList.remove('hidden');
        updatePreview();
        photoForm?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function resetForm() {
        photoForm?.reset();
        if (photoId) photoId.value = '';
        if (photoSeries) photoSeries.value = 'anime';
        if (photoTakenAt) photoTakenAt.value = localToday();
        if (photoWidth) photoWidth.value = '1200';
        if (photoHeight) photoHeight.value = '800';
        if (photoSortOrder) photoSortOrder.value = '0';
        setText(photoFormTitle, '新增照片');
        setText(photoStatus, '');
        setText(uploadStatus, '');
        photoDelete?.classList.add('hidden');
        updatePreview();
      }

      function updatePreview() {
        if (!photoPreview) return;
        const src = photoSrc?.value.trim() ?? '';
        if (src) {
          photoPreview.src = src;
          photoPreview.classList.remove('hidden');
        } else {
          photoPreview.classList.add('hidden');
        }
      }

      photoSrc?.addEventListener('input', updatePreview);
      $('photo-reset')?.addEventListener('click', resetForm);

      $('upload-button')?.addEventListener('click', async () => {
        const file = photoFile?.files?.[0];
        if (!file) {
          setText(uploadStatus, '先选择图片');
          return;
        }
        const form = new FormData();
        form.append('file', file);
        setText(uploadStatus, '上传中…');
        try {
          const data = await request('/api/admin/upload', { method: 'POST', body: form });
          if (photoSrc) photoSrc.value = data.url;
          if (photoSlug && !photoSlug.value.trim()) {
            const base = file.name
              .replace(/\.[^.]+$/, '')
              .replace(/[^a-zA-Z0-9-]+/g, '-')
              .replace(/^-+|-+$/g, '')
              .toLowerCase();
            if (base) photoSlug.value = base;
          }
          const image = new Image();
          image.onload = () => {
            if (photoWidth && (!photoWidth.value || Number(photoWidth.value) === 1200))
              photoWidth.value = String(image.naturalWidth);
            if (photoHeight && (!photoHeight.value || Number(photoHeight.value) === 800))
              photoHeight.value = String(image.naturalHeight);
          };
          image.src = data.url;
          updatePreview();
          setText(uploadStatus, '已上传，记得保存照片');
        } catch (error) {
          setText(uploadStatus, error instanceof Error ? error.message : '上传失败');
        }
      });

      photoForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        setText(photoStatus, '保存中…');
        const exif: Record<string, string> = {};
        for (const [key, input] of Object.entries(exifFields)) {
          if (input?.value.trim()) exif[key] = input.value.trim();
        }
        const payload = {
          title: photoTitle?.value.trim() ?? '',
          slug: photoSlug?.value.trim() ?? '',
          series: photoSeries?.value ?? 'anime',
          takenAt: photoTakenAt?.value ?? '',
          width: Number(photoWidth?.value ?? 1200),
          height: Number(photoHeight?.value ?? 800),
          src: photoSrc?.value.trim() ?? '',
          alt: photoAlt?.value.trim() ?? '',
          note: photoNote?.value.trim() ?? '',
          badge: photoBadge?.value.trim() ?? '',
          sortOrder: Number(photoSortOrder?.value ?? 0),
          exif,
        };

        try {
          const id = photoId?.value;
          if (id) {
            await request(`/api/admin/photos/${encodeURIComponent(id)}`, {
              method: 'PATCH',
              body: JSON.stringify(payload),
            });
          } else {
            await request('/api/admin/photos', { method: 'POST', body: JSON.stringify(payload) });
          }
          setText(photoStatus, '已保存');
          resetForm();
          await loadPhotos();
        } catch (error) {
          setText(photoStatus, error instanceof Error ? error.message : '保存失败');
        }
      });

      photoDelete?.addEventListener('click', async () => {
        const id = photoId?.value;
        if (!id || !window.confirm('确定删除这张照片吗？')) return;
        try {
          await request(`/api/admin/photos/${encodeURIComponent(id)}`, { method: 'DELETE' });
          resetForm();
          await loadPhotos();
          setText(photoStatus, '已删除');
        } catch (error) {
          setText(photoStatus, error instanceof Error ? error.message : '删除失败');
        }
      });

      $('refresh-button')?.addEventListener('click', () => void loadPhotos());

      function renderList() {
        if (!photoList) return;
        photoList.replaceChildren();
        setText(photoCount, `(${photos.length})`);
        for (const photo of photos) {
          const card = document.createElement('article');
          card.className =
            'flex gap-space-sm rounded-xl border border-surface-container-high bg-surface-container-low p-3 shadow-sm';

          const image = document.createElement('img');
          image.src = photo.src;
          image.alt = photo.alt;
          image.className = 'h-24 w-24 shrink-0 rounded object-cover';
          image.loading = 'lazy';

          const body = document.createElement('div');
          body.className = 'flex min-w-0 flex-1 flex-col gap-1';

          const title = document.createElement('strong');
          title.className = 'truncate text-sm font-medium text-primary';
          title.textContent = photo.title;

          const meta = document.createElement('span');
          meta.className = 'font-label-sm text-[0.625rem] text-on-surface-variant';
          meta.textContent = `${photo.series} · ${photo.takenAt} · ${photo.slug}`;

          const actions = document.createElement('div');
          actions.className = 'mt-auto flex items-center gap-2';
          const edit = document.createElement('button');
          edit.type = 'button';
          edit.className = 'text-xs text-secondary hover:text-primary';
          edit.textContent = '编辑';
          edit.addEventListener('click', () => fillForm(photo));
          const open = document.createElement('a');
          open.href = '/photos/';
          open.target = '_blank';
          open.rel = 'noopener';
          open.className = 'text-xs text-secondary hover:text-primary';
          open.textContent = '查看';
          actions.append(edit, open);

          body.append(title, meta, actions);
          card.append(image, body);
          photoList.append(card);
        }
      }

      async function loadPhotos() {
        try {
          const data = await request('/api/admin/photos');
          photos = data.photos;
          renderList();
          if (wantSlug) {
            const target = photos.find((photo) => photo.slug === wantSlug);
            wantSlug = null;
            if (target) fillForm(target);
          }
        } catch (error) {
          setText(photoStatus, error instanceof Error ? error.message : '加载失败');
        }
      }

      // ---- 通用内容编辑（随笔 / 书架 / 唱片 / 曲目 / 台词） ----
      type AdminField = {
        name: string;
        label: string;
        type: 'text' | 'textarea' | 'number' | 'date' | 'select' | 'checkbox' | 'tags';
        required?: boolean;
        options?: Array<{ value: string; label: string }>;
        help?: string;
      };
      type AdminSchema = { type: string; label: string; slugField: string; titleField: string; fields: AdminField[] };
      type ContentRecord = { id: string; slug: string; title: string; data: Record<string, unknown> };

      const photosSection = $('photos-section');
      const lettersSection = $('letters-section');
      const kugouSection = $('kugou-section');
      const recordsSection = $('records-section');
      const recordsTitle = $('records-title');
      const recordForm = $<HTMLFormElement>('record-form');
      const recordFormTitle = $('record-form-title');
      const recordId = $<HTMLInputElement>('record-id');
      const recordFields = $('record-fields');
      const recordStatus = $('record-status');
      const recordDelete = $<HTMLButtonElement>('record-delete');
      const recordList = $('record-list');
      const recordCount = $('record-count');
      const recordListTitle = $('record-list-title');
      const tabButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-admin-tab]')];

      let schemas: AdminSchema[] = [];
      let activeType = 'photos';
      let activeSchema: AdminSchema | null = null;
      let contentRecords: ContentRecord[] = [];

      function setTabStyle(type: string) {
        for (const button of tabButtons) {
          const active = button.dataset.adminTab === type;
          button.classList.toggle('bg-primary', active);
          button.classList.toggle('text-on-primary', active);
          button.classList.toggle('bg-surface-container', !active);
          button.classList.toggle('text-primary', !active);
        }
      }

      async function loadSchemas() {
        if (schemas.length) return;
        try {
          const data = await request('/api/admin/schema');
          schemas = data.schemas;
        } catch (error) {
          setText(recordStatus, error instanceof Error ? error.message : '加载内容类型失败');
        }
      }

      function fieldInputId(name: string) {
        return `record-field-${name}`;
      }

      function setRecordStatus(message: string) {
        setText(recordStatus, message);
      }

      function fillRecordForm(record: ContentRecord | null) {
        if (!activeSchema || !recordFields) return;
        recordFields.replaceChildren();
        for (const field of activeSchema.fields) {
          const label = document.createElement('label');
          label.className = 'flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant';
          if (field.type === 'textarea') label.classList.add('sm:col-span-2');
          label.textContent = field.required ? `${field.label} *` : field.label;

          let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
          if (field.type === 'textarea') {
            input = document.createElement('textarea');
            input.className = 'field min-h-[7rem]';
            input.value = String((record?.data[field.name] as string | undefined) ?? '');
          } else if (field.type === 'select') {
            input = document.createElement('select');
            input.className = 'field';
            const blank = document.createElement('option');
            blank.value = '';
            blank.textContent = field.required ? '请选择' : '（不填）';
            input.append(blank);
            for (const option of field.options ?? []) {
              const node = document.createElement('option');
              node.value = option.value;
              node.textContent = option.label;
              input.append(node);
            }
            input.value = String((record?.data[field.name] as string | undefined) ?? '');
            if (!input.value && field.required) input.value = field.options?.[0]?.value ?? '';
          } else if (field.type === 'checkbox') {
            input = document.createElement('input');
            input.type = 'checkbox';
            input.className = 'h-4 w-4 accent-secondary';
            input.checked = Boolean(record?.data[field.name]);
          } else if (field.type === 'number') {
            input = document.createElement('input');
            input.type = 'number';
            input.className = 'field';
            input.value = String((record?.data[field.name] as number | undefined) ?? 0);
          } else if (field.type === 'date') {
            input = document.createElement('input');
            input.type = 'date';
            input.className = 'field';
            input.value = String((record?.data[field.name] as string | undefined) ?? localToday());
          } else {
            input = document.createElement('input');
            input.type = 'text';
            input.className = 'field';
            let value = record?.data[field.name];
            if (activeType === 'tracks' && field.name === 'kugouHash') {
              value = (record?.data.kugou as { hash?: string } | undefined)?.hash;
            } else if (activeType === 'tracks' && field.name === 'kugouAlbumId') {
              value = (record?.data.kugou as { albumId?: string } | undefined)?.albumId;
            } else if (activeType === 'tracks' && field.name === 'kugouAlbumAudioId') {
              value = (record?.data.kugou as { albumAudioId?: number } | undefined)?.albumAudioId;
            }
            if (field.type === 'tags' && Array.isArray(value)) value = (value as string[]).join(', ');
            input.value = String(value ?? '');
            if (field.type === 'tags') input.placeholder = '用逗号分隔';
            if (field.help) input.title = field.help;
          }
          input.id = fieldInputId(field.name);
          input.required = Boolean(field.required);
          if (field.type === 'number') input.setAttribute('step', '1');
          label.append(input);
          recordFields.append(label);
        }
        if (recordId) recordId.value = record?.id ?? '';
        setText(recordFormTitle, record ? `编辑${activeSchema.label}` : `新增${activeSchema.label}`);
        recordDelete?.classList.toggle('hidden', !record);
        setRecordStatus('');
      }

      function collectRecord() {
        const payload: Record<string, unknown> = {};
        if (!activeSchema) return payload;
        for (const field of activeSchema.fields) {
          const input = document.getElementById(fieldInputId(field.name)) as
            HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
          if (!input) continue;
          if (field.type === 'checkbox') {
            payload[field.name] = (input as HTMLInputElement).checked;
          } else if (field.type === 'number') {
            payload[field.name] = Number((input as HTMLInputElement).value || 0);
          } else {
            payload[field.name] = (input as HTMLInputElement).value;
          }
        }
        return payload;
      }

      function resetRecordForm() {
        fillRecordForm(null);
      }

      async function loadRecords() {
        if (!activeSchema || !recordList) return;
        recordList.replaceChildren();
        setRecordStatus('加载中…');
        try {
          const data = await request(`/api/admin/content/${activeSchema.type}`);
          contentRecords = data.records;
          setText(recordCount, `(${contentRecords.length})`);
          setText(recordListTitle, `${activeSchema.label}列表`);
          for (const record of contentRecords) {
            const row = document.createElement('div');
            row.className =
              'flex items-center justify-between gap-2 rounded-lg border border-surface-container-high bg-surface-container-low px-3 py-2';
            const meta = document.createElement('div');
            meta.className = 'min-w-0';
            const title = document.createElement('strong');
            title.className = 'block truncate text-sm text-primary';
            title.textContent = record.title;
            const slug = document.createElement('span');
            slug.className = 'block truncate font-label-sm text-[0.625rem] text-on-surface-variant';
            slug.textContent = record.slug;
            meta.append(title, slug);
            const actions = document.createElement('div');
            actions.className = 'flex shrink-0 items-center gap-2';
            const edit = document.createElement('button');
            edit.type = 'button';
            edit.className = 'text-xs text-secondary hover:text-primary';
            edit.textContent = '编辑';
            edit.addEventListener('click', () => fillRecordForm(record));
            actions.append(edit);
            row.append(meta, actions);
            recordList.append(row);
          }
          setRecordStatus('');
        } catch (error) {
          setRecordStatus(error instanceof Error ? error.message : '加载失败');
        }
      }

      async function switchTab(type: string) {
        activeType = type;
        setTabStyle(type);
        if (type === 'photos') {
          stopKugouQr();
          if (photosSection) photosSection.style.display = '';
          if (recordsSection) recordsSection.style.display = 'none';
          if (kugouSection) kugouSection.style.display = 'none';
          if (lettersSection) lettersSection.style.display = 'none';
          await loadPhotos();
          return;
        }
        if (type === 'kugou') {
          if (photosSection) photosSection.style.display = 'none';
          if (recordsSection) recordsSection.style.display = 'none';
          if (kugouSection) kugouSection.style.display = '';
          if (lettersSection) lettersSection.style.display = 'none';
          await loadKugou();
          return;
        }
        if (type === 'letters') {
          stopKugouQr();
          if (photosSection) photosSection.style.display = 'none';
          if (recordsSection) recordsSection.style.display = 'none';
          if (kugouSection) kugouSection.style.display = 'none';
          if (lettersSection) lettersSection.style.display = '';
          await loadLetters();
          return;
        }
        stopKugouQr();
        if (photosSection) photosSection.style.display = 'none';
        if (recordsSection) recordsSection.style.display = '';
        if (kugouSection) kugouSection.style.display = 'none';
        if (lettersSection) lettersSection.style.display = 'none';
        await loadSchemas();
        activeSchema = schemas.find((schema) => schema.type === type) ?? null;
        setText(recordsTitle, activeSchema?.label ?? type);
        fillRecordForm(null);
        await loadRecords();
      }

      for (const button of tabButtons) {
        button.addEventListener('click', () => void switchTab(button.dataset.adminTab ?? 'photos'));
      }

      $('record-refresh')?.addEventListener('click', () => void loadRecords());
      $('record-new')?.addEventListener('click', resetRecordForm);
      $('record-reset')?.addEventListener('click', resetRecordForm);

      recordForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!activeSchema) return;
        setRecordStatus('保存中…');
        const payload = collectRecord();
        try {
          const id = recordId?.value;
          if (id) {
            await request(`/api/admin/content/${activeSchema.type}/${encodeURIComponent(id)}`, {
              method: 'PATCH',
              body: JSON.stringify(payload),
            });
          } else {
            await request(`/api/admin/content/${activeSchema.type}`, {
              method: 'POST',
              body: JSON.stringify(payload),
            });
          }
          setRecordStatus('已保存');
          resetRecordForm();
          await loadRecords();
        } catch (error) {
          setRecordStatus(error instanceof Error ? error.message : '保存失败');
        }
      });

      recordDelete?.addEventListener('click', async () => {
        if (!activeSchema || !recordId?.value) return;
        if (!window.confirm('确定删除这条内容吗？')) return;
        try {
          await request(`/api/admin/content/${activeSchema.type}/${encodeURIComponent(recordId.value)}`, {
            method: 'DELETE',
          });
          resetRecordForm();
          await loadRecords();
          setRecordStatus('已删除');
        } catch (error) {
          setRecordStatus(error instanceof Error ? error.message : '删除失败');
        }
      });

      // ---- 酷狗账号 / 歌单 ----
      const kugouStatus = $('kugou-status');
      const kugouPlaylists = $('kugou-playlists');
      const kugouTracks = $('kugou-tracks');
      const kugouPlaylistName = $('kugou-playlist-name');
      const kugouTrackCount = $('kugou-track-count');
      const kugouTrackStatus = $('kugou-track-status');
      const kugouQrPanel = $('kugou-qr-panel');
      const kugouQrImage = $<HTMLImageElement>('kugou-qr-image');
      const kugouQrMessage = $('kugou-qr-message');
      const kugouQrLink = $<HTMLAnchorElement>('kugou-qr-link');
      const kugouQrStart = $<HTMLButtonElement>('kugou-qr-start');
      const kugouAddForm = $<HTMLFormElement>('kugou-add-form');

      let kugouQrTimer: number | null = null;
      let kugouQrKey = '';

      function stopKugouQr() {
        if (kugouQrTimer !== null) {
          window.clearTimeout(kugouQrTimer);
          kugouQrTimer = null;
        }
        kugouQrKey = '';
      }

      function renderKugou(data: any) {
        const status = data.status ?? {};
        if (kugouStatus) {
          kugouStatus.textContent = status.configured
            ? `已登录 ${status.userid} · ${status.source === 'file' ? '后台扫码会话' : '服务器 .env'} · 站内歌单 ${status.playlistName}`
            : '未登录：生成二维码扫码，或继续使用服务器 .env 里的酷狗会话。';
        }
        if (kugouPlaylistName) kugouPlaylistName.textContent = data.playlist?.name ? `· ${data.playlist.name}` : '';
        if (kugouTrackCount) kugouTrackCount.textContent = data.playlist ? `${data.playlist.total} 首` : '';

        if (kugouPlaylists) {
          kugouPlaylists.replaceChildren();
          if (!status.configured) {
            const note = document.createElement('p');
            note.className = 'font-body-sm text-body-sm text-on-surface-variant';
            note.textContent = '登录后这里会列出账号里的全部歌单。';
            kugouPlaylists.append(note);
          } else if (!data.playlists?.length) {
            const note = document.createElement('p');
            note.className = 'font-body-sm text-body-sm text-on-surface-variant';
            note.textContent = data.error || '没有读到歌单。';
            kugouPlaylists.append(note);
          } else {
            for (const playlist of data.playlists) {
              const row = document.createElement('div');
              row.className = 'flex items-center justify-between gap-2 rounded-lg bg-surface-container px-3 py-2';
              const meta = document.createElement('div');
              meta.className = 'min-w-0';
              const name = document.createElement('strong');
              name.className = 'block truncate text-sm text-primary';
              name.textContent = playlist.name;
              const count = document.createElement('span');
              count.className = 'block font-label-sm text-[0.625rem] text-on-surface-variant';
              count.textContent = `${playlist.count} 首 · ${playlist.globalCollectionId}`;
              meta.append(name, count);
              const actions = document.createElement('div');
              actions.className = 'flex shrink-0 items-center gap-2';
              if (playlist.name === data.playlist?.name || playlist.name === status.playlistName) {
                const active = document.createElement('span');
                active.className = 'font-label-sm text-[0.625rem] text-secondary';
                active.textContent = '站内使用中';
                actions.append(active);
              } else {
                const use = document.createElement('button');
                use.type = 'button';
                use.className = 'text-xs text-secondary hover:text-primary';
                use.textContent = '设为站内歌单';
                use.addEventListener('click', async () => {
                  use.disabled = true;
                  try {
                    await request('/api/admin/kugou/settings', {
                      method: 'POST',
                      body: JSON.stringify({ playlistName: playlist.name }),
                    });
                    await loadKugou();
                  } catch (error) {
                    if (kugouTrackStatus)
                      kugouTrackStatus.textContent = error instanceof Error ? error.message : '切换失败';
                  } finally {
                    use.disabled = false;
                  }
                });
                actions.append(use);
              }
              row.append(meta, actions);
              kugouPlaylists.append(row);
            }
          }
        }

        if (kugouTracks) {
          kugouTracks.replaceChildren();
          const tracks = data.playlist?.tracks ?? [];
          if (!tracks.length) {
            const note = document.createElement('p');
            note.className = 'py-4 text-center font-body-sm text-body-sm text-on-surface-variant';
            note.textContent = status.configured ? '当前歌单没有曲目。' : '登录后显示当前歌单曲目。';
            kugouTracks.append(note);
          } else {
            for (const track of tracks) {
              const row = document.createElement('div');
              row.className =
                'flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 hover:bg-surface-container';
              const meta = document.createElement('div');
              meta.className = 'min-w-0';
              const title = document.createElement('span');
              title.className = 'block truncate text-sm text-primary';
              title.textContent = `${track.title} · ${track.artist}`;
              const detail = document.createElement('span');
              detail.className = 'block truncate font-label-sm text-[0.625rem] text-on-surface-variant';
              detail.textContent = `${track.duration} · ${track.hash}${track.fileid ? ` · fileid ${track.fileid}` : ''}`;
              meta.append(title, detail);
              const actions = document.createElement('div');
              actions.className = 'flex shrink-0 items-center gap-2';
              if (track.kugou?.hash || track.hash) {
                const open = document.createElement('a');
                open.className = 'text-xs text-secondary hover:text-primary';
                open.href = `https://www.kugou.com/song/#hash=${encodeURIComponent(track.hash)}`;
                open.target = '_blank';
                open.rel = 'noopener noreferrer';
                open.textContent = '打开';
                actions.append(open);
              }
              if (track.fileid) {
                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'text-xs text-error hover:underline';
                remove.textContent = '删除';
                remove.addEventListener('click', async () => {
                  if (!window.confirm(`从酷狗歌单删除《${track.title}》？`)) return;
                  remove.disabled = true;
                  try {
                    await request('/api/admin/kugou/tracks', {
                      method: 'DELETE',
                      body: JSON.stringify({ fileid: track.fileid }),
                    });
                    await loadKugou();
                  } catch (error) {
                    if (kugouTrackStatus)
                      kugouTrackStatus.textContent = error instanceof Error ? error.message : '删除失败';
                  } finally {
                    remove.disabled = false;
                  }
                });
                actions.append(remove);
              }
              row.append(meta, actions);
              kugouTracks.append(row);
            }
          }
        }
      }

      async function loadKugou() {
        if (kugouStatus) kugouStatus.textContent = '读取酷狗账号…';
        try {
          const data = await request('/api/admin/kugou/status');
          renderKugou(data);
          if (data.error && kugouTrackStatus) kugouTrackStatus.textContent = data.error;
          if (!kugouQrKey) {
            kugouQrPanel?.setAttribute('style', 'display: none');
          }
        } catch (error) {
          if (kugouStatus) kugouStatus.textContent = error instanceof Error ? error.message : '读取失败';
        }
      }

      async function startKugouQr() {
        stopKugouQr();
        if (kugouQrStart) kugouQrStart.disabled = true;
        try {
          const data = await request('/api/admin/kugou/qr', { method: 'POST' });
          kugouQrKey = data.qr.key;
          if (kugouQrImage) kugouQrImage.src = data.qr.image;
          if (kugouQrLink) kugouQrLink.href = data.qr.url;
          if (kugouQrMessage) kugouQrMessage.textContent = '等待扫码…';
          if (kugouQrPanel) kugouQrPanel.setAttribute('style', 'display: flex');
          pollKugouQr(kugouQrKey);
        } catch (error) {
          if (kugouQrMessage) kugouQrMessage.textContent = error instanceof Error ? error.message : '二维码生成失败';
          if (kugouQrPanel) kugouQrPanel.setAttribute('style', 'display: flex');
        } finally {
          if (kugouQrStart) kugouQrStart.disabled = false;
        }
      }

      async function pollKugouQr(key: string) {
        if (!kugouQrKey) return;
        try {
          const data = await request(`/api/admin/kugou/qr?key=${encodeURIComponent(key)}`);
          if (kugouQrMessage) kugouQrMessage.textContent = data.message ?? '';
          if (data.status === 'success') {
            stopKugouQr();
            if (kugouQrMessage) kugouQrMessage.textContent = '登录成功，正在刷新歌单…';
            await loadKugou();
            return;
          }
          if (data.status === 'expired') {
            stopKugouQr();
            return;
          }
        } catch (error) {
          if (kugouQrMessage) kugouQrMessage.textContent = error instanceof Error ? error.message : '轮询失败';
        }
        kugouQrTimer = window.setTimeout(() => void pollKugouQr(key), 2500);
      }

      $('kugou-refresh')?.addEventListener('click', () => void loadKugou());
      $('kugou-qr-start')?.addEventListener('click', () => void startKugouQr());
      $('kugou-logout')?.addEventListener('click', async () => {
        if (!window.confirm('退出后站内会停止读取该酷狗账号，确定吗？')) return;
        try {
          await request('/api/admin/kugou/logout', { method: 'POST' });
          await loadKugou();
        } catch (error) {
          if (kugouStatus) kugouStatus.textContent = error instanceof Error ? error.message : '退出失败';
        }
      });

      kugouAddForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const hash = $<HTMLInputElement>('kugou-add-hash')?.value.trim() ?? '';
        const name = $<HTMLInputElement>('kugou-add-name')?.value.trim() ?? '';
        const albumId = $<HTMLInputElement>('kugou-add-album')?.value.trim() ?? '0';
        const albumAudioId = Number($<HTMLInputElement>('kugou-add-audio')?.value ?? 0);
        if (kugouTrackStatus) kugouTrackStatus.textContent = '添加中…';
        try {
          await request('/api/admin/kugou/tracks', {
            method: 'POST',
            body: JSON.stringify({ hash, name, albumId, albumAudioId }),
          });
          if (kugouTrackStatus) kugouTrackStatus.textContent = '已添加，正在刷新…';
          if (kugouAddForm) kugouAddForm.reset();
          await loadKugou();
          if (kugouTrackStatus) kugouTrackStatus.textContent = '已添加';
        } catch (error) {
          if (kugouTrackStatus) kugouTrackStatus.textContent = error instanceof Error ? error.message : '添加失败';
        }
      });

      // ---- 留言与悄悄话 ----
      type LetterStatus = 'pending' | 'approved' | 'hidden';
      type AdminLetter = {
        id: string;
        name: string;
        station: string;
        message: string;
        tag: string;
        reply: string;
        replied_at: string | null;
        created_at: string;
        is_private: number;
        status: LetterStatus;
      };

      const lettersList = $('letters-list');
      const lettersEmpty = $('letters-empty');
      const lettersStatus = $('letters-status');
      let letterFilter: LetterStatus | 'all' = 'all';
      let letters: AdminLetter[] = [];

      function setLettersStatus(message: string) {
        setText(lettersStatus, message);
      }

      function letterStatusText(status: LetterStatus): string {
        return status === 'pending' ? '待审核' : status === 'approved' ? '已上墙' : '已隐藏';
      }

      function styleLetterFilters() {
        for (const button of document.querySelectorAll<HTMLButtonElement>('[data-letter-filter]')) {
          const on = button.dataset.letterFilter === letterFilter;
          button.classList.toggle('bg-primary', on);
          button.classList.toggle('text-on-primary', on);
          button.classList.toggle('bg-surface-container', !on);
          button.classList.toggle('text-primary', !on);
        }
      }

      function updateLetterCounts(counts: Record<string, number> | undefined) {
        if (!counts) return;
        for (const node of document.querySelectorAll<HTMLElement>('[data-letter-count]')) {
          const key = node.dataset.letterCount ?? '';
          node.textContent = String(counts[key] ?? 0);
        }
      }

      function renderLetters() {
        if (!lettersList) return;
        lettersList.replaceChildren();
        for (const letter of letters) {
          const card = document.createElement('article');
          card.className =
            'flex flex-col gap-space-sm rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm';

          const head = document.createElement('div');
          head.className = 'flex flex-wrap items-center justify-between gap-space-sm';
          const who = document.createElement('div');
          who.className = 'flex flex-wrap items-center gap-2';
          const name = document.createElement('strong');
          name.className = 'text-sm font-medium text-primary';
          name.textContent = letter.name;
          who.append(name);
          if (letter.is_private) {
            const priv = document.createElement('span');
            priv.className =
              'rounded-full bg-secondary-container/60 px-2 py-0.5 font-label-sm text-[0.625rem] text-primary';
            priv.textContent = '悄悄话 · 仅房主可见';
            who.append(priv);
          }
          if (letter.tag) {
            const tag = document.createElement('span');
            tag.className =
              'rounded-full bg-surface-container px-2 py-0.5 font-label-sm text-[0.625rem] text-on-surface-variant';
            tag.textContent = letter.tag;
            who.append(tag);
          }
          const meta = document.createElement('div');
          meta.className = 'flex items-center gap-2 font-label-sm text-[0.625rem] text-on-surface-variant';
          const status = document.createElement('span');
          status.className = letter.status === 'pending' ? 'text-secondary' : 'text-on-surface-variant';
          status.textContent =
            letter.is_private && letter.status === 'approved' ? '已通过 · 不公开' : letterStatusText(letter.status);
          const date = document.createElement('span');
          date.textContent = new Date(letter.created_at).toLocaleString('zh-CN');
          meta.append(status, date);
          head.append(who, meta);

          const message = document.createElement('p');
          message.className = 'whitespace-pre-wrap font-body-md text-body-md leading-relaxed text-on-surface';
          message.textContent = letter.message;

          card.append(head, message);

          if (letter.reply) {
            const reply = document.createElement('div');
            reply.className = 'rounded-lg bg-surface-container p-space-sm';
            const replyLabel = document.createElement('span');
            replyLabel.className = 'font-label-sm text-[0.625rem] text-secondary';
            replyLabel.textContent = '房主回复';
            const replyText = document.createElement('p');
            replyText.className = 'mt-1 whitespace-pre-wrap font-body-sm text-body-sm text-primary';
            replyText.textContent = letter.reply;
            reply.append(replyLabel, replyText);
            card.append(reply);
          }

          const actions = document.createElement('div');
          actions.className = 'flex flex-wrap items-center gap-2';
          if (letter.status !== 'approved') {
            const approve = document.createElement('button');
            approve.type = 'button';
            approve.className = 'rounded-lg bg-primary px-space-md py-1.5 font-label-sm text-label-sm text-on-primary';
            approve.textContent = '通过';
            approve.addEventListener('click', () => void updateLetter(letter.id, { status: 'approved' }));
            actions.append(approve);
          }
          if (letter.status !== 'hidden') {
            const hide = document.createElement('button');
            hide.type = 'button';
            hide.className =
              'rounded-lg border border-error/40 px-space-md py-1.5 font-label-sm text-label-sm text-error';
            hide.textContent = '隐藏';
            hide.addEventListener('click', () => void updateLetter(letter.id, { status: 'hidden' }));
            actions.append(hide);
          }

          const replyBox = document.createElement('textarea');
          replyBox.className = 'field min-h-[4rem] flex-1';
          replyBox.placeholder = letter.is_private
            ? '写一句回复（悄悄话仅房主可见）'
            : '写一句回复，保存后显示在公开留言下面';
          replyBox.value = letter.reply;
          const saveReply = document.createElement('button');
          saveReply.type = 'button';
          saveReply.className =
            'rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary';
          saveReply.textContent = '保存回复';
          saveReply.addEventListener('click', () => void updateLetter(letter.id, { reply: replyBox.value }));
          actions.append(replyBox, saveReply);
          card.append(actions);
          lettersList.append(card);
        }
        lettersEmpty?.classList.toggle('hidden', letters.length !== 0);
      }

      async function updateLetter(id: string, patch: { status?: LetterStatus; reply?: string }) {
        setLettersStatus('保存中…');
        try {
          await request(`/api/admin/letters/${encodeURIComponent(id)}`, {
            method: 'PATCH',
            body: JSON.stringify(patch),
          });
          setLettersStatus('已保存');
          await loadLetters();
        } catch (error) {
          setLettersStatus(error instanceof Error ? error.message : '保存失败');
        }
      }

      async function loadLetters() {
        styleLetterFilters();
        setLettersStatus('加载中…');
        try {
          const data = await request(`/api/admin/letters?status=${encodeURIComponent(letterFilter)}&limit=200`);
          letters = data.letters;
          updateLetterCounts(data.counts);
          renderLetters();
          setLettersStatus(`共 ${letters.length} 条`);
        } catch (error) {
          setLettersStatus(error instanceof Error ? error.message : '加载失败');
        }
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-letter-filter]')) {
        button.addEventListener('click', () => {
          const value = button.dataset.letterFilter;
          if (value === 'pending' || value === 'approved' || value === 'hidden' || value === 'all') {
            letterFilter = value;
            void loadLetters();
          }
        });
      }
      $('letters-refresh')?.addEventListener('click', () => void loadLetters());
      if (photoTakenAt) photoTakenAt.value = localToday();
      void checkSession();
    </script>
  </body>
</html>
