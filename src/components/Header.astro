---
import SearchDialog from './SearchDialog.astro';
import { SITE, NAV, type NavKey } from '../lib/site';

interface Props {
  current: NavKey;
}

const { current } = Astro.props;

const navBase =
  'inline-flex min-h-9 items-center rounded-full px-3.5 font-label-md text-label-md transition-colors duration-150';
const navActive = 'bg-surface-container-high text-on-surface shadow-sm';
const navIdle = 'text-on-surface-variant hover:bg-surface-container hover:text-on-surface';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-surface/85 backdrop-blur-md"
  data-header
  style="padding-top: var(--safe-top)"
>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-space-md px-gutter" data-nav-row>
    <a class="flex min-h-11 min-w-0 items-center gap-space-sm" href="/" aria-label="风屿书房 · 首页">
      <img alt="" class="h-8 w-auto shrink-0 object-contain" src="/images/logo.png" width="96" height="96" />
      <span class="flex min-w-0 flex-col">
        <span class="truncate font-headline-sm text-headline-sm leading-none tracking-tight text-primary">
          {SITE.name}
        </span>
        <span class="mt-1 hidden truncate font-meta text-meta uppercase tracking-[0.16em] text-muted sm:block">
          {SITE.tagline}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 rounded-full bg-surface-container-low p-1 lg:flex" aria-label="主导航">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={current === item.key ? 'page' : undefined}
          class:list={[navBase, current === item.key ? navActive : navIdle]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <a
        class="hidden min-h-11 max-w-[220px] items-center gap-2 rounded-full border border-line bg-surface-container-lowest/70 px-3 py-1.5 transition-colors hover:bg-surface-container-low md:flex"
        href="/reading/#music"
        data-now
        aria-label="查看酷狗歌单"
      >
        <span class="material-symbols-outlined shrink-0 text-base text-secondary" data-now-icon aria-hidden="true">
          album
        </span>
        <span class="flex min-w-0 flex-col">
          <span class="truncate font-label-sm text-label-sm leading-tight text-primary" data-now-title>
            未在播放
          </span>
          <span class="truncate font-meta text-meta leading-tight text-muted" data-now-sub>
            打开酷狗歌单
          </span>
        </span>
      </a>

      <button type="button" class="btn-icon" aria-label="搜索文字、书与歌（快捷键 Ctrl+K）" data-search-open>
        <span class="material-symbols-outlined text-lg" aria-hidden="true">
          search
        </span>
      </button>

      <a class="btn-icon" href="/#profile" aria-label="关于岛屿同学">
        <img
          alt="岛屿同学的头像"
          class="h-8 w-8 rounded-full object-cover ring-1 ring-line-strong"
          src="/images/profile.jpg"
          width="160"
          height="160"
        />
      </a>

      <button
        type="button"
        class="btn-icon lg:hidden"
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-line bg-surface px-gutter pb-3 pt-2 lg:hidden"
    aria-label="移动端导航"
  >
    <ul class="grid grid-cols-2 gap-2">
      {NAV.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={current === item.key ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center rounded-lg px-4 font-label-lg text-label-lg transition-colors',
              current === item.key
                ? 'bg-surface-container-high text-on-surface'
                : 'text-on-surface-variant hover:bg-surface-container-low',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<SearchDialog />

<script>
  import '../scripts/site/header';
</script>

<style is:global>
  [data-header] {
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  [data-header] [data-nav-row] {
    height: var(--nav-h);
    transition: height 0.2s ease;
  }

  [data-header][data-scrolled] {
    background-color: rgb(252 249 244 / 0.94);
    box-shadow:
      0 1px 0 var(--line),
      0 12px 24px -24px rgb(42 36 33 / 0.35);
  }

  [data-header][data-scrolled] [data-nav-row] {
    height: 3.75rem;
  }
</style>
