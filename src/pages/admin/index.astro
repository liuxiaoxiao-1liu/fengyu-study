---
// 内容后台：静态页；登录态走 HttpOnly cookie，数据通过 /api/admin/* 读写。
import '../../styles/fonts.css';
import '../../styles/icons.css';
import '../../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fcf9f4" />
    <title>内容后台 · 风屿书房</title>
    <link rel="icon" href="/images/logo.png" type="image/png" />
  </head>

  <body class="bg-surface font-body-md text-body-md text-on-surface antialiased">
    <main id="main" class="mx-auto flex w-full max-w-6xl flex-col gap-space-lg px-gutter py-space-xl">
      <header class="flex flex-col gap-space-sm">
        <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary">
          OWNER CONSOLE · 房主专席
        </span>
        <h1 class="font-headline-lg text-headline-lg-mobile text-primary sm:text-headline-lg">
          内容后台
          <span class="font-display italic text-headline-md font-normal text-on-surface-variant">Content Desk</span>
        </h1>
        <p class="max-w-3xl font-body-sm leading-relaxed text-body-sm text-on-surface-variant">
          登录后直接在网页上维护影集、随笔、书籍、唱片、曲目、台词与友链，不需要改代码或重新部署。影集支持上传图片，唱片/曲目封面可填图片地址。
        </p>
        <div class="flex flex-wrap items-center gap-space-md font-label-sm text-label-sm">
          <a class="text-secondary underline decoration-outline-variant underline-offset-4 hover:text-primary" href="/">
            ← 返回书房
          </a>
          <a
            class="text-secondary underline decoration-outline-variant underline-offset-4 hover:text-primary"
            href="/admin/letters/"
          >
            留言审核
          </a>
        </div>
      </header>

      <section
        id="login-panel"
        class="rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm"
      >
        <h2 class="font-headline-sm text-headline-sm text-primary">登录</h2>
        <p class="mt-1 font-body-sm text-body-sm text-on-surface-variant">使用房主账号登录后管理内容。</p>
        <form id="login-form" class="mt-space-md grid max-w-md gap-space-sm">
          <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
            用户名
            <input id="login-user" class="field" autocomplete="username" required />
          </label>
          <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
            密码
            <input id="login-password" type="password" class="field" autocomplete="current-password" required />
          </label>
          <div class="flex items-center gap-space-sm pt-1">
            <button
              type="submit"
              class="rounded-lg bg-primary px-space-lg py-2 font-label-md text-label-md text-on-primary hover:bg-primary-container"
            >
              登录
            </button>
            <span
              id="login-message"
              class="font-label-sm text-label-sm text-error"
              role="status"
              aria-live="polite"
            ></span>
          </div>
        </form>
      </section>

      <section id="dashboard" class="flex flex-col gap-space-lg" hidden>
        <div class="flex flex-wrap items-center justify-between gap-space-sm rounded-xl bg-surface-container-low px-space-lg py-space-md shadow-sm">
          <div class="font-label-sm text-label-sm text-on-surface-variant">
            已登录：<strong class="text-primary" data-session-user></strong>
          </div>
          <div class="flex items-center gap-space-sm">
            <a
              class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
              href="/admin/letters/"
            >
              留言审核
            </a>
            <button
              type="button"
              id="logout-button"
              class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
            >
              退出
            </button>
          </div>
        </div>

        <nav
          aria-label="内容类型"
          class="flex flex-wrap gap-2 rounded-xl bg-surface-container-low p-space-sm shadow-sm"
        >
          <button
            type="button"
            data-admin-tab="photos"
            class="admin-tab rounded-lg bg-primary px-space-md py-1.5 font-label-sm text-label-sm text-on-primary"
          >
            影集
          </button>
          <button
            type="button"
            data-admin-tab="essays"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            随笔
          </button>
          <button
            type="button"
            data-admin-tab="books"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            书架
          </button>
          <button
            type="button"
            data-admin-tab="albums"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            唱片
          </button>
          <button
            type="button"
            data-admin-tab="tracks"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            曲目
          </button>
          <button
            type="button"
            data-admin-tab="quotes"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            台词
          </button>
          <button
            type="button"
            data-admin-tab="links"
            class="admin-tab rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
          >
            友链
          </button>
        </nav>

        <div id="photos-section" class="grid grid-cols-1 items-start gap-space-lg lg:grid-cols-12">
          <form
            id="photo-form"
            class="flex flex-col gap-space-sm rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm lg:col-span-5"
          >
            <div class="flex items-center justify-between gap-space-sm">
              <h2 id="photo-form-title" class="font-headline-sm text-headline-sm text-primary">
                新增照片
              </h2>
              <button
                type="button"
                id="photo-reset"
                class="font-label-sm text-label-sm text-secondary hover:text-primary"
              >
                清空
              </button>
            </div>
            <input id="photo-id" type="hidden" />

            <div class="flex flex-col gap-2 rounded-lg bg-surface-container p-space-sm">
              <label class="font-label-sm text-label-sm text-on-surface-variant" for="photo-file">
                上传图片
              </label>
              <input
                id="photo-file"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/gif,image/avif"
                class="block w-full max-w-full text-xs text-on-surface-variant file:mr-2 file:rounded file:border-0 file:bg-primary file:px-3 file:py-1.5 file:font-label-sm file:text-label-sm file:text-on-primary"
              />
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="upload-button"
                  class="rounded-lg bg-surface-container-high px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-highest"
                >
                  上传并填入
                </button>
                <span
                  id="upload-status"
                  class="font-label-sm text-[0.625rem] text-on-surface-variant"
                  role="status"
                ></span>
              </div>
              <img id="photo-preview" alt="" class="mt-1 hidden h-28 w-full rounded object-cover" />
            </div>

            <div class="grid grid-cols-1 gap-space-sm sm:grid-cols-2">
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                标题
                <input id="photo-title" class="field" required />
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                slug（英文/数字/-）
                <input id="photo-slug" class="field" />
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                系列
                <select id="photo-series" class="field">
                  <option value="anime">动漫插画</option>
                  <option value="reality">现实纪实</option>
                  <option value="virtual">虚拟 CG</option>
                </select>
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                拍摄日期
                <input id="photo-taken-at" type="date" class="field" />
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                宽（px）
                <input id="photo-width" type="number" min="1" step="1" class="field" value="1200" />
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                高（px）
                <input id="photo-height" type="number" min="1" step="1" class="field" value="800" />
              </label>
            </div>

            <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
              图片地址（上传后自动填入，也可粘外链）
              <input id="photo-src" class="field" required />
            </label>
            <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
              图片描述（alt，必须有）<textarea id="photo-alt" class="field min-h-[4rem]" required></textarea>
            </label>
            <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
              手记 / 图注<textarea id="photo-note" class="field min-h-[4rem]"></textarea>
            </label>
            <div class="grid grid-cols-1 gap-space-sm sm:grid-cols-2">
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                角标（badge）
                <input id="photo-badge" class="field" />
              </label>
              <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                排序（越小越靠前）
                <input id="photo-sort-order" type="number" step="1" class="field" value="0" />
              </label>
            </div>

            <details class="rounded-lg bg-surface-container p-space-sm">
              <summary class="cursor-pointer font-label-sm text-label-sm text-secondary">
                EXIF · 拍摄参数（可选）
              </summary>
              <div class="mt-2 grid grid-cols-1 gap-space-sm sm:grid-cols-2">
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  机身
                  <input id="exif-camera" class="field" />
                </label>
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  镜头
                  <input id="exif-lens" class="field" />
                </label>
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  光圈
                  <input id="exif-aperture" class="field" />
                </label>
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  快门
                  <input id="exif-shutter" class="field" />
                </label>
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  ISO
                  <input id="exif-iso" class="field" />
                </label>
                <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">
                  地点
                  <input id="exif-location" class="field" />
                </label>
              </div>
            </details>

            <div class="flex flex-wrap items-center gap-space-sm pt-1">
              <button
                type="submit"
                class="rounded-lg bg-primary px-space-lg py-2 font-label-md text-label-md text-on-primary hover:bg-primary-container"
              >
                保存照片
              </button>
              <button
                type="button"
                id="photo-delete"
                class="hidden rounded-lg border border-error/40 px-space-md py-2 font-label-sm text-label-sm text-error hover:bg-error/10"
              >
                删除
              </button>
              <span
                id="photo-status"
                class="font-label-sm text-label-sm text-on-surface-variant"
                role="status"
                aria-live="polite"
              ></span>
            </div>
          </form>

          <div class="flex flex-col gap-space-sm lg:col-span-7">
            <div class="flex flex-wrap items-center justify-between gap-space-sm">
              <h2 class="font-headline-sm text-headline-sm text-primary">
                影集列表 <span id="photo-count" class="font-label-sm text-label-sm text-on-surface-variant"></span>
              </h2>
              <button
                type="button"
                id="refresh-button"
                class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
              >
                刷新
              </button>
            </div>
            <div id="photo-list" class="grid grid-cols-1 gap-space-sm sm:grid-cols-2"></div>
          </div>
        </div>

        <div id="records-section" class="flex flex-col gap-space-lg" style="display: none">
          <div class="flex flex-wrap items-center justify-between gap-space-sm">
            <h2 id="records-title" class="font-headline-sm text-headline-sm text-primary">
              随笔
            </h2>
            <div class="flex items-center gap-space-sm">
              <button
                type="button"
                id="record-refresh"
                class="rounded-lg bg-surface-container px-space-md py-1.5 font-label-sm text-label-sm text-primary hover:bg-surface-container-high"
              >
                刷新
              </button>
              <button
                type="button"
                id="record-new"
                class="rounded-lg bg-primary px-space-md py-1.5 font-label-sm text-label-sm text-on-primary hover:bg-primary-container"
              >
                新增
              </button>
            </div>
          </div>
          <div class="grid grid-cols-1 items-start gap-space-lg lg:grid-cols-12">
            <form
              id="record-form"
              class="flex flex-col gap-space-sm rounded-xl border border-surface-container-high bg-surface-container-low p-space-lg shadow-sm lg:col-span-7"
            >
              <div class="flex items-center justify-between gap-space-sm">
                <h3 id="record-form-title" class="font-headline-sm text-headline-sm text-primary">
                  新增
                </h3>
                <button
                  type="button"
                  id="record-reset"
                  class="font-label-sm text-label-sm text-secondary hover:text-primary"
                >
                  清空
                </button>
              </div>
              <input id="record-id" type="hidden" />
              <div id="record-fields" class="grid grid-cols-1 gap-space-sm sm:grid-cols-2"></div>
              <div class="flex flex-wrap items-center gap-space-sm pt-1">
                <button
                  type="submit"
                  class="rounded-lg bg-primary px-space-lg py-2 font-label-md text-label-md text-on-primary hover:bg-primary-container"
                >
                  保存
                </button>
                <button
                  type="button"
                  id="record-delete"
                  class="hidden rounded-lg border border-error/40 px-space-md py-2 font-label-sm text-label-sm text-error hover:bg-error/10"
                >
                  删除
                </button>
                <span
                  id="record-status"
                  class="font-label-sm text-label-sm text-on-surface-variant"
                  role="status"
                  aria-live="polite"
                ></span>
              </div>
            </form>
            <div class="flex flex-col gap-space-sm lg:col-span-5">
              <h3 id="record-list-title" class="font-headline-sm text-headline-sm text-primary">
                列表 <span id="record-count" class="font-label-sm text-label-sm text-on-surface-variant"></span>
              </h3>
              <div id="record-list" class="flex flex-col gap-space-xs"></div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <style>
      .field {
        width: 100%;
        border-radius: 0.25rem;
        border: 1px solid #ebe8e3;
        background: #fcf9f4;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        line-height: 1.25rem;
        color: #1c1c19;
      }
      .field:focus {
        outline: none;
        border-color: #526354;
      }
    </style>

    <script>
      type PhotoRecord = {
        id: string;
        slug: string;
        title: string;
        src: string;
        alt: string;
        width: number;
        height: number;
        series: 'anime' | 'reality' | 'virtual';
        takenAt: string;
        note: string;
        badge: string;
        exif?: Record<string, string | undefined>;
        sortOrder: number;
      };

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
      const loginPanel = $('login-panel');
      const dashboard = $('dashboard');
      const loginForm = $<HTMLFormElement>('login-form');
      const loginUser = $<HTMLInputElement>('login-user');
      const loginPassword = $<HTMLInputElement>('login-password');
      const loginMessage = $('login-message');
      const sessionUser = document.querySelector<HTMLElement>('[data-session-user]');
      const photoForm = $<HTMLFormElement>('photo-form');
      const photoFormTitle = $('photo-form-title');
      const photoId = $<HTMLInputElement>('photo-id');
      const photoTitle = $<HTMLInputElement>('photo-title');
      const photoSlug = $<HTMLInputElement>('photo-slug');
      const photoSeries = $<HTMLSelectElement>('photo-series');
      const photoTakenAt = $<HTMLInputElement>('photo-taken-at');
      const photoWidth = $<HTMLInputElement>('photo-width');
      const photoHeight = $<HTMLInputElement>('photo-height');
      const photoSrc = $<HTMLInputElement>('photo-src');
      const photoAlt = $<HTMLTextAreaElement>('photo-alt');
      const photoNote = $<HTMLTextAreaElement>('photo-note');
      const photoBadge = $<HTMLInputElement>('photo-badge');
      const photoSortOrder = $<HTMLInputElement>('photo-sort-order');
      const photoFile = $<HTMLInputElement>('photo-file');
      const photoPreview = $<HTMLImageElement>('photo-preview');
      const uploadStatus = $('upload-status');
      const photoStatus = $('photo-status');
      const photoDelete = $<HTMLButtonElement>('photo-delete');
      const photoList = $('photo-list');
      const photoCount = $('photo-count');
      const exifFields = {
        camera: $<HTMLInputElement>('exif-camera'),
        lens: $<HTMLInputElement>('exif-lens'),
        aperture: $<HTMLInputElement>('exif-aperture'),
        shutter: $<HTMLInputElement>('exif-shutter'),
        iso: $<HTMLInputElement>('exif-iso'),
        location: $<HTMLInputElement>('exif-location'),
      };

      let photos: PhotoRecord[] = [];
      let wantSlug = new URLSearchParams(window.location.search).get('photo');

      function localToday(): string {
        const now = new Date();
        return new Date(now.getTime() - now.getTimezoneOffset() * 60_000).toISOString().slice(0, 10);
      }

      function setText(node: HTMLElement | null, value: string) {
        if (node) node.textContent = value;
      }

      function showLogin(message = '') {
        loginPanel?.removeAttribute('hidden');
        dashboard?.setAttribute('hidden', '');
        setText(loginMessage, message);
      }

      function showDashboard(user: string) {
        loginPanel?.setAttribute('hidden', '');
        dashboard?.removeAttribute('hidden');
        setText(sessionUser, user);
      }

      async function request(path: string, options: RequestInit = {}) {
        const response = await fetch(path, {
          ...options,
          headers: {
            ...(options.body instanceof FormData ? {} : { 'content-type': 'application/json' }),
            ...(options.headers ?? {}),
          },
        });
        let data: any = null;
        try {
          data = await response.json();
        } catch {
          data = null;
        }
        if (response.status === 401) {
          showLogin('登录已过期，请重新登录。');
          throw new Error('unauthorized');
        }
        if (!response.ok || (data && data.ok === false)) {
          throw new Error((data && (data.message || data.error)) || `HTTP ${response.status}`);
        }
        return data;
      }

      async function checkSession() {
        try {
          const data = await request('/api/admin/session');
          showDashboard(data.user);
          await loadSchemas();
          await loadPhotos();
        } catch (error) {
          if (error instanceof Error && error.message === 'unauthorized') return;
          showLogin();
        }
      }

      loginForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        setText(loginMessage, '');
        try {
          const data = await request('/api/admin/login', {
            method: 'POST',
            body: JSON.stringify({ username: loginUser?.value.trim() ?? '', password: loginPassword?.value ?? '' }),
          });
          showDashboard(data.user);
          if (loginPassword) loginPassword.value = '';
          await loadSchemas();
          await loadPhotos();
        } catch (error) {
          setText(loginMessage, error instanceof Error ? error.message : '登录失败');
        }
      });

      $('logout-button')?.addEventListener('click', async () => {
        await fetch('/api/admin/logout', { method: 'POST' });
        window.location.href = '/admin/';
      });

      function fillForm(photo: PhotoRecord) {
        if (photoId) photoId.value = photo.id;
        if (photoTitle) photoTitle.value = photo.title;
        if (photoSlug) photoSlug.value = photo.slug;
        if (photoSeries) photoSeries.value = photo.series;
        if (photoTakenAt) photoTakenAt.value = photo.takenAt;
        if (photoWidth) photoWidth.value = String(photo.width);
        if (photoHeight) photoHeight.value = String(photo.height);
        if (photoSrc) photoSrc.value = photo.src;
        if (photoAlt) photoAlt.value = photo.alt;
        if (photoNote) photoNote.value = photo.note;
        if (photoBadge) photoBadge.value = photo.badge;
        if (photoSortOrder) photoSortOrder.value = String(photo.sortOrder);
        for (const [key, input] of Object.entries(exifFields)) {
          if (input) input.value = photo.exif?.[key] ?? '';
        }
        setText(photoFormTitle, '编辑照片');
        photoDelete?.classList.remove('hidden');
        updatePreview();
        photoForm?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function resetForm() {
        photoForm?.reset();
        if (photoId) photoId.value = '';
        if (photoSeries) photoSeries.value = 'anime';
        if (photoTakenAt) photoTakenAt.value = localToday();
        if (photoWidth) photoWidth.value = '1200';
        if (photoHeight) photoHeight.value = '800';
        if (photoSortOrder) photoSortOrder.value = '0';
        setText(photoFormTitle, '新增照片');
        setText(photoStatus, '');
        setText(uploadStatus, '');
        photoDelete?.classList.add('hidden');
        updatePreview();
      }

      function updatePreview() {
        if (!photoPreview) return;
        const src = photoSrc?.value.trim() ?? '';
        if (src) {
          photoPreview.src = src;
          photoPreview.classList.remove('hidden');
        } else {
          photoPreview.classList.add('hidden');
        }
      }

      photoSrc?.addEventListener('input', updatePreview);
      $('photo-reset')?.addEventListener('click', resetForm);

      $('upload-button')?.addEventListener('click', async () => {
        const file = photoFile?.files?.[0];
        if (!file) {
          setText(uploadStatus, '先选择图片');
          return;
        }
        const form = new FormData();
        form.append('file', file);
        setText(uploadStatus, '上传中…');
        try {
          const data = await request('/api/admin/upload', { method: 'POST', body: form });
          if (photoSrc) photoSrc.value = data.url;
          if (photoSlug && !photoSlug.value.trim()) {
            const base = file.name
              .replace(/\.[^.]+$/, '')
              .replace(/[^a-zA-Z0-9-]+/g, '-')
              .replace(/^-+|-+$/g, '')
              .toLowerCase();
            if (base) photoSlug.value = base;
          }
          const image = new Image();
          image.onload = () => {
            if (photoWidth && (!photoWidth.value || Number(photoWidth.value) === 1200))
              photoWidth.value = String(image.naturalWidth);
            if (photoHeight && (!photoHeight.value || Number(photoHeight.value) === 800))
              photoHeight.value = String(image.naturalHeight);
          };
          image.src = data.url;
          updatePreview();
          setText(uploadStatus, '已上传，记得保存照片');
        } catch (error) {
          setText(uploadStatus, error instanceof Error ? error.message : '上传失败');
        }
      });

      photoForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        setText(photoStatus, '保存中…');
        const exif: Record<string, string> = {};
        for (const [key, input] of Object.entries(exifFields)) {
          if (input?.value.trim()) exif[key] = input.value.trim();
        }
        const payload = {
          title: photoTitle?.value.trim() ?? '',
          slug: photoSlug?.value.trim() ?? '',
          series: photoSeries?.value ?? 'anime',
          takenAt: photoTakenAt?.value ?? '',
          width: Number(photoWidth?.value ?? 1200),
          height: Number(photoHeight?.value ?? 800),
          src: photoSrc?.value.trim() ?? '',
          alt: photoAlt?.value.trim() ?? '',
          note: photoNote?.value.trim() ?? '',
          badge: photoBadge?.value.trim() ?? '',
          sortOrder: Number(photoSortOrder?.value ?? 0),
          exif,
        };

        try {
          const id = photoId?.value;
          if (id) {
            await request(`/api/admin/photos/${encodeURIComponent(id)}`, {
              method: 'PATCH',
              body: JSON.stringify(payload),
            });
          } else {
            await request('/api/admin/photos', { method: 'POST', body: JSON.stringify(payload) });
          }
          setText(photoStatus, '已保存');
          resetForm();
          await loadPhotos();
        } catch (error) {
          setText(photoStatus, error instanceof Error ? error.message : '保存失败');
        }
      });

      photoDelete?.addEventListener('click', async () => {
        const id = photoId?.value;
        if (!id || !window.confirm('确定删除这张照片吗？')) return;
        try {
          await request(`/api/admin/photos/${encodeURIComponent(id)}`, { method: 'DELETE' });
          resetForm();
          await loadPhotos();
          setText(photoStatus, '已删除');
        } catch (error) {
          setText(photoStatus, error instanceof Error ? error.message : '删除失败');
        }
      });

      $('refresh-button')?.addEventListener('click', () => void loadPhotos());

      function renderList() {
        if (!photoList) return;
        photoList.replaceChildren();
        setText(photoCount, `(${photos.length})`);
        for (const photo of photos) {
          const card = document.createElement('article');
          card.className =
            'flex gap-space-sm rounded-xl border border-surface-container-high bg-surface-container-low p-3 shadow-sm';

          const image = document.createElement('img');
          image.src = photo.src;
          image.alt = photo.alt;
          image.className = 'h-24 w-24 shrink-0 rounded object-cover';
          image.loading = 'lazy';

          const body = document.createElement('div');
          body.className = 'flex min-w-0 flex-1 flex-col gap-1';

          const title = document.createElement('strong');
          title.className = 'truncate text-sm font-medium text-primary';
          title.textContent = photo.title;

          const meta = document.createElement('span');
          meta.className = 'font-label-sm text-[0.625rem] text-on-surface-variant';
          meta.textContent = `${photo.series} · ${photo.takenAt} · ${photo.slug}`;

          const actions = document.createElement('div');
          actions.className = 'mt-auto flex items-center gap-2';
          const edit = document.createElement('button');
          edit.type = 'button';
          edit.className = 'text-xs text-secondary hover:text-primary';
          edit.textContent = '编辑';
          edit.addEventListener('click', () => fillForm(photo));
          const open = document.createElement('a');
          open.href = '/photos/';
          open.target = '_blank';
          open.rel = 'noopener';
          open.className = 'text-xs text-secondary hover:text-primary';
          open.textContent = '查看';
          actions.append(edit, open);

          body.append(title, meta, actions);
          card.append(image, body);
          photoList.append(card);
        }
      }

      async function loadPhotos() {
        try {
          const data = await request('/api/admin/photos');
          photos = data.photos;
          renderList();
          if (wantSlug) {
            const target = photos.find((photo) => photo.slug === wantSlug);
            wantSlug = null;
            if (target) fillForm(target);
          }
        } catch (error) {
          setText(photoStatus, error instanceof Error ? error.message : '加载失败');
        }
      }

      // ---- 通用内容编辑（随笔 / 书架 / 唱片 / 曲目 / 台词） ----
      type AdminField = {
        name: string;
        label: string;
        type: 'text' | 'textarea' | 'number' | 'date' | 'select' | 'checkbox' | 'tags';
        required?: boolean;
        options?: Array<{ value: string; label: string }>;
        help?: string;
      };
      type AdminSchema = { type: string; label: string; slugField: string; titleField: string; fields: AdminField[] };
      type ContentRecord = { id: string; slug: string; title: string; data: Record<string, unknown> };

      const photosSection = $('photos-section');
      const recordsSection = $('records-section');
      const recordsTitle = $('records-title');
      const recordForm = $<HTMLFormElement>('record-form');
      const recordFormTitle = $('record-form-title');
      const recordId = $<HTMLInputElement>('record-id');
      const recordFields = $('record-fields');
      const recordStatus = $('record-status');
      const recordDelete = $<HTMLButtonElement>('record-delete');
      const recordList = $('record-list');
      const recordCount = $('record-count');
      const recordListTitle = $('record-list-title');
      const tabButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-admin-tab]')];

      let schemas: AdminSchema[] = [];
      let activeType = 'photos';
      let activeSchema: AdminSchema | null = null;
      let contentRecords: ContentRecord[] = [];

      function setTabStyle(type: string) {
        for (const button of tabButtons) {
          const active = button.dataset.adminTab === type;
          button.classList.toggle('bg-primary', active);
          button.classList.toggle('text-on-primary', active);
          button.classList.toggle('bg-surface-container', !active);
          button.classList.toggle('text-primary', !active);
        }
      }

      async function loadSchemas() {
        if (schemas.length) return;
        try {
          const data = await request('/api/admin/schema');
          schemas = data.schemas;
        } catch (error) {
          setText(recordStatus, error instanceof Error ? error.message : '加载内容类型失败');
        }
      }

      function fieldInputId(name: string) {
        return `record-field-${name}`;
      }

      function setRecordStatus(message: string) {
        setText(recordStatus, message);
      }

      function fillRecordForm(record: ContentRecord | null) {
        if (!activeSchema || !recordFields) return;
        recordFields.replaceChildren();
        for (const field of activeSchema.fields) {
          const label = document.createElement('label');
          label.className = 'flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant';
          if (field.type === 'textarea') label.classList.add('sm:col-span-2');
          label.textContent = field.required ? `${field.label} *` : field.label;

          let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
          if (field.type === 'textarea') {
            input = document.createElement('textarea');
            input.className = 'field min-h-[7rem]';
            input.value = String((record?.data[field.name] as string | undefined) ?? '');
          } else if (field.type === 'select') {
            input = document.createElement('select');
            input.className = 'field';
            const blank = document.createElement('option');
            blank.value = '';
            blank.textContent = field.required ? '请选择' : '（不填）';
            input.append(blank);
            for (const option of field.options ?? []) {
              const node = document.createElement('option');
              node.value = option.value;
              node.textContent = option.label;
              input.append(node);
            }
            input.value = String((record?.data[field.name] as string | undefined) ?? '');
            if (!input.value && field.required) input.value = field.options?.[0]?.value ?? '';
          } else if (field.type === 'checkbox') {
            input = document.createElement('input');
            input.type = 'checkbox';
            input.className = 'h-4 w-4 accent-secondary';
            input.checked = Boolean(record?.data[field.name]);
          } else if (field.type === 'number') {
            input = document.createElement('input');
            input.type = 'number';
            input.className = 'field';
            input.value = String((record?.data[field.name] as number | undefined) ?? 0);
          } else if (field.type === 'date') {
            input = document.createElement('input');
            input.type = 'date';
            input.className = 'field';
            input.value = String((record?.data[field.name] as string | undefined) ?? localToday());
          } else {
            input = document.createElement('input');
            input.type = 'text';
            input.className = 'field';
            let value = record?.data[field.name];
            if (activeType === 'tracks' && field.name === 'kugouHash') {
              value = (record?.data.kugou as { hash?: string } | undefined)?.hash;
            } else if (activeType === 'tracks' && field.name === 'kugouAlbumId') {
              value = (record?.data.kugou as { albumId?: string } | undefined)?.albumId;
            } else if (activeType === 'tracks' && field.name === 'kugouAlbumAudioId') {
              value = (record?.data.kugou as { albumAudioId?: number } | undefined)?.albumAudioId;
            }
            if (field.type === 'tags' && Array.isArray(value)) value = (value as string[]).join(', ');
            input.value = String(value ?? '');
            if (field.type === 'tags') input.placeholder = '用逗号分隔';
            if (field.help) input.title = field.help;
          }
          input.id = fieldInputId(field.name);
          input.required = Boolean(field.required);
          if (field.type === 'number') input.setAttribute('step', '1');
          label.append(input);
          recordFields.append(label);
        }
        if (recordId) recordId.value = record?.id ?? '';
        setText(recordFormTitle, record ? `编辑${activeSchema.label}` : `新增${activeSchema.label}`);
        recordDelete?.classList.toggle('hidden', !record);
        setRecordStatus('');
      }

      function collectRecord() {
        const payload: Record<string, unknown> = {};
        if (!activeSchema) return payload;
        for (const field of activeSchema.fields) {
          const input = document.getElementById(fieldInputId(field.name)) as
            HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
          if (!input) continue;
          if (field.type === 'checkbox') {
            payload[field.name] = (input as HTMLInputElement).checked;
          } else if (field.type === 'number') {
            payload[field.name] = Number((input as HTMLInputElement).value || 0);
          } else {
            payload[field.name] = (input as HTMLInputElement).value;
          }
        }
        return payload;
      }

      function resetRecordForm() {
        fillRecordForm(null);
      }

      async function loadRecords() {
        if (!activeSchema || !recordList) return;
        recordList.replaceChildren();
        setRecordStatus('加载中…');
        try {
          const data = await request(`/api/admin/content/${activeSchema.type}`);
          contentRecords = data.records;
          setText(recordCount, `(${contentRecords.length})`);
          setText(recordListTitle, `${activeSchema.label}列表`);
          for (const record of contentRecords) {
            const row = document.createElement('div');
            row.className =
              'flex items-center justify-between gap-2 rounded-lg border border-surface-container-high bg-surface-container-low px-3 py-2';
            const meta = document.createElement('div');
            meta.className = 'min-w-0';
            const title = document.createElement('strong');
            title.className = 'block truncate text-sm text-primary';
            title.textContent = record.title;
            const slug = document.createElement('span');
            slug.className = 'block truncate font-label-sm text-[0.625rem] text-on-surface-variant';
            slug.textContent = record.slug;
            meta.append(title, slug);
            const actions = document.createElement('div');
            actions.className = 'flex shrink-0 items-center gap-2';
            const edit = document.createElement('button');
            edit.type = 'button';
            edit.className = 'text-xs text-secondary hover:text-primary';
            edit.textContent = '编辑';
            edit.addEventListener('click', () => fillRecordForm(record));
            actions.append(edit);
            row.append(meta, actions);
            recordList.append(row);
          }
          setRecordStatus('');
        } catch (error) {
          setRecordStatus(error instanceof Error ? error.message : '加载失败');
        }
      }

      async function switchTab(type: string) {
        activeType = type;
        setTabStyle(type);
        if (type === 'photos') {
          if (photosSection) photosSection.style.display = '';
          if (recordsSection) recordsSection.style.display = 'none';
          await loadPhotos();
          return;
        }
        if (photosSection) photosSection.style.display = 'none';
        if (recordsSection) recordsSection.style.display = '';
        await loadSchemas();
        activeSchema = schemas.find((schema) => schema.type === type) ?? null;
        setText(recordsTitle, activeSchema?.label ?? type);
        fillRecordForm(null);
        await loadRecords();
      }

      for (const button of tabButtons) {
        button.addEventListener('click', () => void switchTab(button.dataset.adminTab ?? 'photos'));
      }

      $('record-refresh')?.addEventListener('click', () => void loadRecords());
      $('record-new')?.addEventListener('click', resetRecordForm);
      $('record-reset')?.addEventListener('click', resetRecordForm);

      recordForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!activeSchema) return;
        setRecordStatus('保存中…');
        const payload = collectRecord();
        try {
          const id = recordId?.value;
          if (id) {
            await request(`/api/admin/content/${activeSchema.type}/${encodeURIComponent(id)}`, {
              method: 'PATCH',
              body: JSON.stringify(payload),
            });
          } else {
            await request(`/api/admin/content/${activeSchema.type}`, {
              method: 'POST',
              body: JSON.stringify(payload),
            });
          }
          setRecordStatus('已保存');
          resetRecordForm();
          await loadRecords();
        } catch (error) {
          setRecordStatus(error instanceof Error ? error.message : '保存失败');
        }
      });

      recordDelete?.addEventListener('click', async () => {
        if (!activeSchema || !recordId?.value) return;
        if (!window.confirm('确定删除这条内容吗？')) return;
        try {
          await request(`/api/admin/content/${activeSchema.type}/${encodeURIComponent(recordId.value)}`, {
            method: 'DELETE',
          });
          resetRecordForm();
          await loadRecords();
          setRecordStatus('已删除');
        } catch (error) {
          setRecordStatus(error instanceof Error ? error.message : '删除失败');
        }
      });

      if (photoTakenAt) photoTakenAt.value = localToday();
      void checkSession();
    </script>
  </body>
</html>
