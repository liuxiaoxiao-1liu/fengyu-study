---
import type { Album, Track } from '../../data/music';
import AlbumGrid from './AlbumGrid.astro';
import PlaylistPanel from './PlaylistPanel.astro';
import KugouLog from './KugouLog.astro';
import TrackList from './TrackList.astro';
import PlaylistFooter from './PlaylistFooter.astro';

interface Props {
  albums: Album[];
  tracks: Track[];
  playlistSlug: string;
  playlistName: string;
  bookCount: number;
}

const { albums, tracks, playlistSlug, playlistName, bookCount } = Astro.props;
---

<section class="w-full max-w-7xl mx-auto px-gutter" id="music">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-sm mb-6 pb-2">
    <div class="flex items-center gap-space-sm">
      <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
        <span class="material-symbols-outlined text-base">headphones</span>
      </div>
      <div>
        <h2 class="font-headline-md text-headline-md text-primary leading-tight font-normal">酷狗音乐专属归档</h2>
        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
          Kugou Music · Viper Audio &amp; Campus Playlist Archive
        </span>
      </div>
    </div>
    <div class="flex items-center gap-space-xs font-label-sm text-label-sm text-on-surface-variant">
      <span class="inline-block w-2 h-2 rounded-full bg-secondary animate-ping"></span>酷狗播放源:
      <span class="text-primary font-medium">蝰蛇全景声 · 国风流行与动漫ACG</span>
    </div>
  </div>
  <AlbumGrid albums={albums} tracks={tracks} />
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <PlaylistPanel playlistSlug={playlistSlug} playlistName={playlistName} />
    <div class="lg:col-span-5 flex flex-col gap-6">
      <KugouLog bookCount={bookCount} trackCount={tracks.length} albumCount={albums.length} />
      <TrackList tracks={tracks} />
      <PlaylistFooter trackCount={tracks.length} albumCount={albums.length} />
    </div>
  </div>
</section>
