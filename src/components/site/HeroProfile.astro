---
// 首页首屏：欢迎语、个人名片与 NOW 状态广播。状态广播接真实内容，不再写死。
interface Props {
  essayTitle: string;
  essayDate: string;
  bookTitle: string;
  trackTitle: string;
  photoCount: number;
}

const { essayTitle, essayDate, bookTitle, trackTitle, photoCount } = Astro.props;

const tags = ['#网文迷', '#酷狗老粉', '#动漫控', '#现实捕捉', '#虚拟漫游'];
---

<section class="section pb-0">
  <div class="grid grid-cols-1 items-start gap-space-lg lg:grid-cols-12 lg:gap-space-xl">
    <div class="lg:col-span-7">
      <p class="eyebrow flex items-center gap-2">
        <span class="material-symbols-outlined text-base text-secondary" aria-hidden="true">
          waving_hand
        </span>
        你好，欢迎光临我的数字秘密基地
      </p>
      <h1 class="mt-space-md font-display text-display text-primary">沉迷网文修仙，在酷狗声浪里漫游现实与异次元。</h1>
      <p class="mt-space-md max-w-2xl text-body-lg leading-relaxed text-on-surface-variant">
        白天是穿梭于教室与自习室的大学生，夜晚是在网文世界修仙斩妖、在酷狗音乐里找回平静的数字漫游者。这里收纳了我追过的网文、循环的歌单，以及搜罗的动漫、现实与虚拟世界的画面。
      </p>
      <div class="mt-space-lg flex flex-wrap items-center gap-space-sm">
        <a class="btn-primary" href="/guestbook/">
          <span class="material-symbols-outlined text-base" aria-hidden="true">
            forum
          </span>
          投递留言
        </a>
        <a class="btn-secondary" href="#reading-music">
          看看四重奏
        </a>
      </div>
    </div>

    <aside class="card flex h-full flex-col justify-between gap-space-md p-6 lg:col-span-5" id="profile">
      <div class="flex items-center gap-space-sm">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-secondary-container font-headline-sm font-semibold text-on-secondary-container">
          屿
        </div>
        <div class="flex min-w-0 flex-col">
          <div class="flex items-center gap-1.5">
            <span class="font-headline-sm text-headline-sm leading-none text-primary">岛屿同学</span>
            <span class="chip bg-secondary text-on-secondary">在读大三</span>
          </div>
          <span class="mt-1 text-body-sm leading-snug text-muted">普通大学生 / 杂食性生活观察者</span>
        </div>
      </div>

      <p class="rounded-lg bg-surface-container p-4 font-quote text-body-md italic leading-relaxed text-on-surface-variant">
        “在充斥速食信息的节奏里，依然为几万字的网文高潮心潮澎湃，依然会在傍晚单曲循环酷狗里那首老歌。”
      </p>

      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="chip bg-surface-container-high text-on-surface">{tag}</span>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 border-t border-line pt-space-sm">
        <a
          class="inline-flex min-h-9 shrink-0 items-center gap-1 whitespace-nowrap font-label-sm text-label-sm text-accent hover:underline"
          href="#stats"
        >
          数字存根
          <span class="material-symbols-outlined text-sm" aria-hidden="true">
            arrow_forward
          </span>
        </a>
        <span class="meta text-right">
          {photoCount} 张影像 · 更新于 {essayDate}
        </span>
      </div>
    </aside>
  </div>

  <div class="mt-space-lg grid grid-cols-1 gap-space-sm rounded-xl border border-line bg-surface-container-low p-4 md:grid-cols-3">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-sm text-secondary" aria-hidden="true">
        menu_book
      </span>
      <span class="meta shrink-0">追读</span>
      <a class="truncate text-body-sm text-on-surface hover:text-accent" href="/reading/#books">
        {bookTitle}
      </a>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-sm text-accent" aria-hidden="true">
        headphones
      </span>
      <span class="meta shrink-0">单曲</span>
      <a class="truncate text-body-sm text-on-surface hover:text-accent" href="/reading/#music">
        {trackTitle}
      </a>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-sm text-secondary" aria-hidden="true">
        edit_note
      </span>
      <span class="meta shrink-0">随记</span>
      <a class="truncate text-body-sm text-on-surface hover:text-accent" href="/essays/">
        {essayTitle}
      </a>
    </div>
  </div>
</section>
