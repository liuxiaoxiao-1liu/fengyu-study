# 复制为 .env，或直接运行 `npm run setup` 自动生成管理员凭据。
# .env 已在 .gitignore，不要提交。

# 管理员（必填）：由 npm run setup 生成，不要手写明文密码。
ADMIN_USER=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# 站点地址（可选）：构建时写入 canonical / sitemap / RSS。
# PUBLIC_SITE_URL=https://your-domain.com

# 酷狗音乐（可选，不填也能正常浏览站点）。
# 优先在 /admin/ 的「酷狗」扫码登录，会话写到 .data/kugou-session.json；
# 也可以把账号登录态放在服务器 .env（这些值等于账号凭据，绝不进仓库）。
# 扫码登录后，站内展示哪个歌单由后台选择；KUGOU_PLAYLIST_NAME 只是后备默认值。
KUGOU_TOKEN=
KUGOU_USERID=
KUGOU_VIP_TOKEN=
KUGOU_VIP_TYPE=
KUGOU_MID=
KUGOU_GUID=
KUGOU_DFID=
KUGOU_PLAYLIST_NAME=

# 旧管理令牌：仅 Bearer/脚本兼容，开源版可留空。
ADMIN_TOKEN=

# 留言库、内容库与上传目录（本地默认 .data/；容器内固定 /data）
# 保持注释即使用代码默认值；需要改路径时取消注释并填写。
# GUESTBOOK_DB=./.data/guestbook.sqlite
# CONTENT_DB=./.data/content.sqlite
# CONTENT_UPLOADS=./.data/uploads

# 后台扫码登录后的酷狗会话与站内歌单选择（本地默认 .data/；容器内 /data）
# KUGOU_SESSION_FILE=./.data/kugou-session.json
# KUGOU_SETTINGS_FILE=./.data/kugou-settings.json
