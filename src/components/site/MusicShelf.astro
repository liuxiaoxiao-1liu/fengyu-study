---
import type { Album, Track } from '../../data/music';
import AlbumGrid from './AlbumGrid.astro';
import PlaylistPanel from './PlaylistPanel.astro';
import KugouLog from './KugouLog.astro';
import TrackList from './TrackList.astro';
import PlaylistFooter from './PlaylistFooter.astro';

interface Props {
  albums: Album[];
  tracks: Track[];
  playlistSlug: string;
  playlistName: string;
  configured: boolean;
  bookCount: number;
}

const { albums, tracks, playlistSlug, playlistName, configured, bookCount } = Astro.props;
---

<section class="section pt-0" id="music">
  <div class="flex flex-wrap items-end justify-between gap-3 border-b border-line pb-3">
    <div>
      <p class="eyebrow">Kugou Music</p>
      <h2 class="mt-1 font-headline-md text-headline-md text-primary">酷狗音乐专属归档</h2>
    </div>
    <div class="flex items-center gap-2 text-label-sm text-muted">
      <span class="inline-block h-2 w-2 rounded-full bg-secondary"></span>
      播放源
      <span class="font-medium text-primary">蝰蛇全景声 · 国风与 ACG</span>
    </div>
  </div>
  <div class="mt-6">
    <AlbumGrid albums={albums} tracks={tracks} />
  </div>
  <div class="mt-6 grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
    <PlaylistPanel playlistSlug={playlistSlug} playlistName={playlistName} configured={configured} />
    <div class="lg:col-span-5 flex flex-col gap-6">
      <KugouLog bookCount={bookCount} trackCount={tracks.length} albumCount={albums.length} />
      <TrackList tracks={tracks} />
      <PlaylistFooter trackCount={tracks.length} albumCount={albums.length} />
    </div>
  </div>
</section>
