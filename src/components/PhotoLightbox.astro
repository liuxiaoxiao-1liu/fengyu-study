---
import type { Photo } from '../data/photos';
import PhotoLightboxSlides from './site/PhotoLightboxSlides.astro';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<dialog class="photo-lightbox" data-lightbox aria-label="照片灯箱">
  <div class="bg-surface rounded-2xl overflow-hidden shadow-2xl w-[min(72rem,92vw)] max-h-[92vh] flex flex-col">
    <div class="flex items-center justify-between gap-space-sm px-space-lg py-space-sm border-b border-surface-container-high bg-surface-container-low">
      <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
        Visual Archive / <span data-lightbox-counter>1 / {photos.length}</span>
      </span>
      <div class="flex items-center gap-3">
        <a
          class="font-label-sm text-label-sm text-secondary hover:text-primary transition-colors"
          data-lightbox-download
          download
          href="#"
        >
          下载
        </a>
        <a
          class="font-label-sm text-label-sm text-secondary hover:text-primary transition-colors"
          data-lightbox-edit
          href="/admin/"
        >
          编辑
        </a>
        <button
          type="button"
          class="flex items-center justify-center p-space-xs text-on-surface-variant hover:text-primary transition-colors"
          data-lightbox-close
          aria-label="关闭灯箱"
        >
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>

    <PhotoLightboxSlides photos={photos} />

    <div class="flex items-center justify-between gap-space-sm px-space-lg py-space-sm border-t border-surface-container-high bg-surface-container-low">
      <button
        type="button"
        class="inline-flex items-center gap-1 px-space-md py-1.5 rounded-lg font-label-md text-label-md text-primary hover:bg-surface-container transition-colors"
        data-lightbox-prev
      >
        <span class="material-symbols-outlined text-sm">arrow_back</span>上一张
      </button>
      <span class="font-label-sm text-[0.625rem] text-on-surface-variant hidden sm:inline">← → 切换 · Esc 关闭</span>
      <button
        type="button"
        class="inline-flex items-center gap-1 px-space-md py-1.5 rounded-lg font-label-md text-label-md text-primary hover:bg-surface-container transition-colors"
        data-lightbox-next
      >
        下一张<span class="material-symbols-outlined text-sm">arrow_forward</span>
      </button>
    </div>
  </div>
</dialog>

<style>
  /* 原生 dialog 灯箱：遮罩与纸感主题保持一致 */
  .photo-lightbox {
    border: 0;
    padding: 0;
    margin: auto;
    background: transparent;
    max-width: none;
    max-height: none;
  }

  .photo-lightbox::backdrop {
    background: rgb(20 15 13 / 0.72);
    backdrop-filter: blur(6px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo-lightbox[open] {
      animation: lightbox-in 0.28s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes lightbox-in {
      from {
        opacity: 0;
        transform: translateY(10px) scale(0.99);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>

<script>
  import '../scripts/site/photo-lightbox';
</script>
