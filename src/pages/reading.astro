---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackRow from '../components/TrackRow.astro';
import { books } from '../data/books';
import { albums, tracks, kugouSearchUrl } from '../data/music';
import { playlists } from '../data/playlists';

const initialPlaylist = playlists[0]!;
const PAGE_SIZE = 30;
const initialTracks = initialPlaylist.tracks.slice(0, PAGE_SIZE);
const initialTotalPages = Math.max(1, Math.ceil(initialPlaylist.tracks.length / PAGE_SIZE));

function firstTrackOfAlbum(albumSlug: string) {
  return tracks.find((track) => track.albumSlug === albumSlug && track.kugou);
}
const accountTrackCount = playlists
  .filter((playlist) => playlist.slug !== 'featured')
  .reduce((total, playlist) => total + playlist.tracks.length, 0);
const webnovelCount = books.filter((book) => book.category === 'webnovel').length;
const suspenseCount = books.filter((book) => book.category === 'suspense').length;
const repeatCount = tracks.filter((track) => track.repeat).length;
---

<BaseLayout current="reading" title="读听">
  <main class="w-full pt-24 bg-surface min-h-[calc(100vh-14rem)] pb-16" id="main">
    <div class="flex flex-col w-full gap-16">
      <section class="w-full max-w-7xl mx-auto px-gutter">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pb-6 border-b border-surface-container-high/60">
          <div class="flex flex-col">
            <div class="flex items-center gap-space-sm mb-space-xs">
              <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-secondary"></span>
                Archival Vault · Vol. 04
              </span>
              <span class="text-on-surface-variant/40 font-label-sm text-label-sm">/</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">2024–2025 纸页与黑胶编目</span>
            </div>
            <h1 class="font-headline-lg text-primary tracking-tight text-headline-lg-mobile sm:text-headline-lg">
              书页与旋律
              <span class="font-headline-md text-headline-md italic text-on-surface-variant font-light ml-space-xs">
                Pages &amp; Frequencies
              </span>
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-space-xs max-w-2xl leading-relaxed">
              一个大学生在书桌台灯与耳机声场里的慢速收纳。收集纸页翻动时的沙砾质感，以及唱针划过内圈凹槽的轻微噼啪。
            </p>
          </div>
          <div class="flex items-center gap-space-md bg-surface-container-low px-space-md py-space-sm rounded-xl shadow-sm">
            <div class="flex flex-col">
              <span class="font-label-sm text-label-sm text-on-surface-variant">追更网文</span>
              <div class="flex items-baseline gap-1">
                <span class="font-headline-md text-headline-md text-primary font-medium">{books.length}</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">本在架</span>
              </div>
            </div>
            <div class="w-px h-8 bg-surface-container-highest"></div>
            <div class="flex flex-col">
              <span class="font-label-sm text-label-sm text-on-surface-variant">酷狗听歌</span>
              <div class="flex items-baseline gap-1">
                <span class="font-headline-md text-headline-md text-on-tertiary-container font-medium">
                  {accountTrackCount}
                </span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">首曲目</span>
              </div>
            </div>
            <div class="w-px h-8 bg-surface-container-highest"></div>
            <div class="flex flex-col">
              <span class="font-label-sm text-label-sm text-on-surface-variant">本章说标记</span>
              <div class="flex items-baseline gap-1">
                <span class="font-headline-md text-headline-md text-secondary font-medium">{albums.length}</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">张唱片</span>
              </div>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-between flex-wrap gap-space-sm pt-4 bg-surface-container-low/60 p-space-xs rounded-xl mt-4">
          <div class="flex items-center gap-space-xs overflow-x-auto py-1" id="filter-container">
            <button
              class="filter-btn active px-space-md py-space-xs rounded-lg font-label-md text-label-md bg-primary text-on-primary shadow-sm transition-all flex items-center gap-1.5"
              data-filter="all"
              type="button"
            >
              <span class="">全部 (All)</span>
            </button>
            <button
              class="filter-btn px-space-md py-space-xs rounded-lg font-label-md text-label-md text-on-surface-variant hover:bg-surface-container transition-all flex items-center gap-1.5"
              data-filter="webnovel"
              type="button"
            >
              <span class="">玄幻奇幻 (Web Novel)</span>
              <span class="font-label-sm text-xs opacity-60">{webnovelCount}</span>
            </button>
            <button
              class="filter-btn px-space-md py-space-xs rounded-lg font-label-md text-label-md text-on-surface-variant hover:bg-surface-container transition-all flex items-center gap-1.5"
              data-filter="suspense"
              type="button"
            >
              <span class="">悬疑志怪 (Cult)</span>
              <span class="font-label-sm text-xs opacity-60">{suspenseCount}</span>
            </button>
            <button
              class="filter-btn px-space-md py-space-xs rounded-lg font-label-md text-label-md text-on-surface-variant hover:bg-surface-container transition-all flex items-center gap-1.5"
              data-filter="kugou"
              type="button"
            >
              <span class="">编辑精选 (Kugou)</span>
              <span class="font-label-sm text-xs opacity-60">{tracks.length}</span>
            </button>
            <button
              class="filter-btn px-space-md py-space-xs rounded-lg font-label-md text-label-md text-on-surface-variant hover:bg-surface-container transition-all flex items-center gap-1.5"
              data-filter="repeat"
              type="button"
            >
              <span class="material-symbols-outlined text-xs text-on-tertiary-container">replay</span>
              <span class="">单曲循回</span>
              <span class="font-label-sm text-xs opacity-60">{repeatCount}</span>
            </button>
          </div>
        </div>
      </section>
      <section class="w-full max-w-7xl mx-auto px-gutter" id="shelf">
        <div class="flex items-center justify-between mb-6 pb-2">
          <div class="flex items-center gap-space-sm">
            <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-base">auto_stories</span>
            </div>
            <div>
              <h2 class="font-headline-md text-headline-md text-primary leading-tight font-normal">
                追更书架与年度网文
              </h2>
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                Web Novels · Serialized Masterpieces &amp; Reader Marginalia
              </span>
            </div>
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant hidden md:flex items-center gap-1 opacity-80">
            点击书卡跳转起点阅读
            <span class="material-symbols-outlined text-xs">south_east</span>
          </span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
          {books.map((book, index) => (
            <a
              aria-label={`去起点中文网阅读${book.title}`}
              class:list={[
                'bg-surface-container-low rounded-xl p-6 flex flex-col justify-between hover:shadow-md transition-shadow relative group cursor-pointer border border-surface-container-high/40 group/card',
                index === 0 ? 'lg:col-span-7' : index === 1 ? 'lg:col-span-5' : 'lg:col-span-4',
              ]}
              data-card="book"
              data-category={book.category}
              href={book.url}
              rel="noopener noreferrer external"
              target="_blank"
              title={`去起点中文网阅读${book.title}`}
            >
              <div class="flex flex-col gap-4">
                <div class="flex items-center justify-between gap-space-sm">
                  <span class="px-2 py-0.5 rounded font-label-sm text-label-sm bg-surface-container text-secondary font-medium">
                    {book.genre}
                  </span>
                  <span class="font-label-sm text-label-sm text-on-surface-variant text-right">{book.words}</span>
                </div>
                <div
                  class:list={[
                    index === 0 ? 'grid grid-cols-1 sm:grid-cols-12 gap-5 items-start' : 'flex gap-5 items-start',
                  ]}
                >
                  <div
                    class:list={[
                      'bg-surface-container-high rounded-lg overflow-hidden shadow-sm flex-shrink-0 group-hover:scale-[1.02] transition-transform aspect-[3/4]',
                      index === 0 ? 'sm:col-span-4 w-full' : index === 1 ? 'w-24' : 'w-20',
                    ]}
                  >
                    <img
                      alt={`${book.title}封面`}
                      class="w-full h-full object-cover"
                      decoding="async"
                      height="800"
                      loading="lazy"
                      src={book.cover}
                      width="600"
                    />
                  </div>
                  <div class:list={[index === 0 ? 'sm:col-span-8' : 'flex-1', 'flex flex-col min-w-0']}>
                    <h3
                      class:list={[
                        'text-primary tracking-tight font-normal mb-1.5',
                        index === 0 ? 'font-headline-md text-headline-md' : 'font-headline-sm text-headline-sm',
                      ]}
                    >
                      {book.title}
                    </h3>
                    <span class="font-body-sm text-body-sm text-on-surface-variant block mb-2">{book.author} · 著</span>
                    {index === 0 && book.quote && (
                      <p class="font-quote text-quote italic text-primary leading-relaxed bg-surface-container/50 p-3 rounded-lg mb-2">
                        {book.quote}
                      </p>
                    )}
                    <p
                      class:list={[
                        'font-body-sm text-body-sm text-on-surface-variant leading-relaxed',
                        index === 0 ? 'line-clamp-2' : 'line-clamp-3',
                      ]}
                    >
                      {book.blurb}
                    </p>
                  </div>
                </div>
              </div>
              <div class="flex items-center justify-between gap-space-sm pt-4 mt-2 border-t border-surface-container-high/60 text-on-surface-variant">
                <span class="font-label-sm text-label-sm flex items-center gap-1.5 text-secondary font-medium min-w-0">
                  <span class="material-symbols-outlined text-xs shrink-0">forum</span>
                  <span class="truncate">{book.footer ?? `去起点阅读${book.title}`}</span>
                </span>
                <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform shrink-0">
                  open_in_new
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
      <section class="w-full max-w-7xl mx-auto px-gutter" id="music">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-sm mb-6 pb-2">
          <div class="flex items-center gap-space-sm">
            <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-base">headphones</span>
            </div>
            <div>
              <h2 class="font-headline-md text-headline-md text-primary leading-tight font-normal">酷狗音乐专属归档</h2>
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                Kugou Music · Viper Audio &amp; Campus Playlist Archive
              </span>
            </div>
          </div>
          <div class="flex items-center gap-space-xs font-label-sm text-label-sm text-on-surface-variant">
            <span class="inline-block w-2 h-2 rounded-full bg-secondary animate-ping"></span>酷狗播放源:
            <span class="text-primary font-medium">蝰蛇全景声 · 国风流行与动漫ACG</span>
          </div>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
          {albums.map((album) => {
            const firstTrack = firstTrackOfAlbum(album.slug);
            return (
              <article class="group relative flex flex-col bg-surface-container-low p-5 rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-md border border-surface-container-high/40">
                <div class="relative aspect-square w-full rounded-lg overflow-hidden mb-3 bg-surface-container-high shadow-sm">
                  <img
                    alt={`${album.title} 专辑封面`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    decoding="async"
                    height="600"
                    loading="lazy"
                    src={album.cover}
                    width="600"
                  />
                  <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-primary/75 text-on-primary font-label-sm text-[0.625rem]">
                    {album.label}
                  </span>
                </div>
                <h4 class="font-headline-sm text-headline-sm text-primary tracking-tight truncate font-normal">
                  {album.title}
                </h4>
                <span class="font-body-sm text-body-sm text-on-surface-variant truncate mt-0.5">{album.artist}</span>
                <div class="flex items-center justify-between mt-3 pt-2 border-t border-surface-container-high/60 text-on-surface-variant">
                  <span class="font-label-sm text-label-sm text-secondary font-medium">{album.tag}</span>
                  {firstTrack ? (
                    <button
                      type="button"
                      class="material-symbols-outlined text-sm text-on-surface-variant transition-colors hover:text-primary"
                      data-play
                      data-hash={firstTrack.kugou?.hash}
                      data-title={firstTrack.title}
                      data-artist={firstTrack.artist}
                      data-external={kugouSearchUrl(firstTrack)}
                      aria-label={`播放 ${firstTrack.title}`}
                      title={`播放 ${firstTrack.title}`}
                    >
                      play_circle
                    </button>
                  ) : (
                    <a
                      class="material-symbols-outlined text-sm text-on-surface-variant transition-colors hover:text-primary"
                      href={kugouSearchUrl({ title: album.title, artist: album.artist })}
                      target="_blank"
                      rel="noopener noreferrer external"
                      aria-label={`在酷狗搜索 ${album.title}`}
                    >
                      open_in_new
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          <div class="lg:col-span-7 bg-surface-container-low rounded-xl p-6 shadow-sm border border-surface-container-high/40">
            <div class="flex flex-col gap-3 pb-3 mb-3 border-b border-surface-container-high/60">
              <div class="flex flex-wrap items-center justify-between gap-space-sm">
                <div class="flex items-center gap-space-xs min-w-0">
                  <span class="font-headline-sm text-headline-sm text-primary font-medium">酷狗音乐 · 我的歌单</span>
                  <span class="font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant hidden sm:inline-block">
                    {initialPlaylist.tracks.length} 首 · 站内可播
                  </span>
                </div>
                <label class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
                  歌单
                  <select
                    id="playlist-select"
                    class="bg-surface-container text-primary rounded-lg px-2 py-1.5 font-label-sm text-label-sm focus:outline-none focus:ring-1 focus:ring-secondary"
                  >
                    {playlists.map((playlist) => (
                      <option value={playlist.slug} selected={playlist.slug === initialPlaylist.slug}>
                        {playlist.name}（{playlist.tracks.length}）
                      </option>
                    ))}
                  </select>
                </label>
              </div>
              <div
                class="flex flex-col gap-1.5"
                id="playlist-tracks"
                data-slug={initialPlaylist.slug}
                data-page="1"
                data-total-pages={initialTotalPages}
              >
                {initialTracks.map((track) => (
                  <TrackRow
                    hash={track.hash}
                    title={track.title}
                    artist={track.artist}
                    duration={track.duration}
                    external={kugouSearchUrl(track)}
                  />
                ))}
              </div>
              <div class="flex items-center justify-between gap-space-sm pt-1" id="playlist-pager">
                <button
                  type="button"
                  class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface-variant font-label-sm text-xs hover:bg-surface-container-high disabled:opacity-40 disabled:cursor-not-allowed"
                  data-page-prev
                  disabled
                >
                  上一页
                </button>
                <span class="font-label-sm text-xs text-on-surface-variant" data-page-info>
                  第 1 / {initialTotalPages} 页
                </span>
                <button
                  type="button"
                  class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface-variant font-label-sm text-xs hover:bg-surface-container-high disabled:opacity-40 disabled:cursor-not-allowed"
                  data-page-next
                  disabled={initialTotalPages <= 1}
                >
                  下一页
                </button>
              </div>
            </div>
          </div>
          <div class="lg:col-span-5 flex flex-col gap-6">
            <div class="bg-surface-container-low rounded-xl p-6 shadow-sm relative overflow-hidden border border-surface-container-high/40">
              <div class="flex items-center justify-between mb-2">
                <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider font-medium">
                  KUGOU MUSIC LOG · ARCHIVE
                </span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">酷狗音乐档案</span>
              </div>
              <h3 class="font-headline-sm text-headline-sm text-primary mb-2 font-normal">
                听歌札记：蝰蛇音效与网文长夜
              </h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant mb-4 leading-relaxed">
                本月开启酷狗蝰蛇「3D丽音」与「纯净人声」，追读《诡秘之主》与《赤心巡天》的深夜总少不了周深与许嵩的声线回荡。伴随歌词滚动，沉浸式体验修真大界的壮阔风云。
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-space-sm py-1 rounded font-label-sm text-xs bg-surface-container text-primary flex items-center gap-1">
                  <span class="material-symbols-outlined text-xs text-on-tertiary-container">graphic_eq</span>
                  书架 {books.length} 本
                </span>
                <span class="px-space-sm py-1 rounded font-label-sm text-xs bg-surface-container text-primary flex items-center gap-1">
                  <span class="material-symbols-outlined text-xs text-secondary">headphones</span>
                  曲目 {tracks.length} 首
                </span>
                <span class="px-space-sm py-1 rounded font-label-sm text-xs bg-surface-container text-primary flex items-center gap-1">
                  <span class="material-symbols-outlined text-xs text-on-surface-variant">album</span>
                  唱片 {albums.length} 张
                </span>
              </div>
              <div class="w-full bg-surface-container/70 p-space-sm rounded-lg flex items-center justify-between gap-1 h-12 mb-4">
                <div class="w-1 bg-secondary/80 rounded-full h-4"></div>
                <div class="w-1 bg-secondary/80 rounded-full h-8"></div>
                <div class="w-1 bg-secondary/80 rounded-full h-6"></div>
                <div class="w-1 bg-primary/70 rounded-full h-10"></div>
                <div class="w-1 bg-primary/70 rounded-full h-7"></div>
                <div class="w-1 bg-on-tertiary-container/80 rounded-full h-9"></div>
                <div class="w-1 bg-on-tertiary-container/80 rounded-full h-5"></div>
                <div class="w-1 bg-secondary/80 rounded-full h-7"></div>
                <div class="w-1 bg-secondary/80 rounded-full h-3"></div>
                <div class="w-1 bg-primary/80 rounded-full h-8"></div>
                <div class="w-1 bg-primary/80 rounded-full h-6"></div>
                <div class="w-1 bg-secondary/80 rounded-full h-4"></div>
                <div class="w-1 bg-on-tertiary-container/80 rounded-full h-9"></div>
                <div class="w-1 bg-on-tertiary-container/80 rounded-full h-5"></div>
                <div class="w-1 bg-secondary/80 rounded-full h-7"></div>
                <div class="w-1 bg-secondary/80 rounded-full h-4"></div>
                <div class="w-1 bg-primary/80 rounded-full h-8"></div>
                <div class="w-1 bg-primary/80 rounded-full h-3"></div>
              </div>
              <div class="bg-surface-container-high/60 p-space-md rounded-lg relative">
                <span class="material-symbols-outlined absolute top-2 right-2 text-primary/10 text-3xl">
                  format_quote
                </span>
                <p class="font-quote text-quote italic text-primary leading-snug mb-1">
                  “看海天一色，听风起雨落，执子手吹散苍茫茫烟波。”
                </p>
                <div class="flex items-center justify-between font-label-sm text-label-sm text-on-surface-variant gap-space-sm">
                  <span class="">—— 周深《大鱼》酷狗精评</span>
                  <span class="text-xs shrink-0">摘自随记与歌单</span>
                </div>
              </div>
            </div>
            <div class="bg-surface-container-low rounded-xl p-5 shadow-sm flex flex-wrap items-center justify-between gap-space-sm border border-surface-container-high/40">
              <div class="flex items-center gap-space-sm min-w-0">
                <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-secondary shrink-0">
                  <span class="material-symbols-outlined text-lg">library_music</span>
                </div>
                <div class="flex flex-col min-w-0">
                  <span class="font-headline-sm text-sm text-primary font-medium truncate">
                    酷狗歌单: 网文高燃与修仙BGM #02
                  </span>
                  <span class="font-label-sm text-xs text-on-surface-variant truncate">
                    已收录 {tracks.length} 首曲目 · {albums.length} 张唱片
                  </span>
                </div>
              </div>
              <a
                class="px-space-sm py-1.5 bg-surface-container hover:bg-surface-container-high rounded text-primary font-label-sm text-xs transition-colors font-medium"
                href="https://www.kugou.com/"
                target="_blank"
                rel="noopener noreferrer external"
              >
                酷狗收听
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
  <script>
    const tabs = [...document.querySelectorAll<HTMLElement>('.filter-btn')];
    const shelf = document.getElementById('shelf');
    const music = document.getElementById('music');
    const bookCards = shelf ? [...shelf.querySelectorAll<HTMLElement>('[data-card="book"]')] : [];

    function setActive(active: HTMLElement) {
      for (const tab of tabs) {
        const on = tab === active;
        tab.classList.toggle('bg-primary', on);
        tab.classList.toggle('text-on-primary', on);
        tab.classList.toggle('shadow-sm', on);
        tab.classList.toggle('text-on-surface-variant', !on);
      }
    }

    function applyFilter(filter: string) {
      const isBook = filter === 'webnovel' || filter === 'suspense';
      const isMusic = filter === 'kugou' || filter === 'repeat';
      const matches = (card: HTMLElement) => {
        if (filter === 'all') return true;
        return (card.dataset.category || '').split(/\s+/).includes(filter);
      };
      if (shelf) shelf.classList.toggle('hidden', isMusic);
      if (music) music.classList.toggle('hidden', isBook);
      for (const card of bookCards) {
        card.style.display = !isMusic && matches(card) ? '' : 'none';
      }
      for (const card of music ? [...music.querySelectorAll<HTMLElement>('[data-card="track"]')] : []) {
        card.style.display = !isBook && matches(card) ? '' : 'none';
      }
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        setActive(tab);
        applyFilter(tab.dataset.filter || 'all');
      });
    }
  </script>

  <script>
    const playlistSelect = document.getElementById('playlist-select') as HTMLSelectElement | null;
    const playlistList = document.getElementById('playlist-tracks');
    const pager = document.getElementById('playlist-pager');
    const pagePrev = pager?.querySelector<HTMLButtonElement>('[data-page-prev]') ?? null;
    const pageNext = pager?.querySelector<HTMLButtonElement>('[data-page-next]') ?? null;
    const pageInfo = pager?.querySelector<HTMLElement>('[data-page-info]') ?? null;
    const PAGE_SIZE = 30;

    let activeSlug = playlistList?.dataset.slug ?? 'featured';
    let activePage = 1;
    let totalPages = Number(playlistList?.dataset.totalPages ?? 1);

    const make = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className: string,
      text?: string,
    ): HTMLElementTagNameMap[K] => {
      const node = document.createElement(tag);
      node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    };

    const searchUrl = (title: string, artist: string) =>
      `https://www.kugou.com/yy/html/search.html#searchType=song&searchKeyWord=${encodeURIComponent(`${title} ${artist}`.trim())}`;

    function buildRow(track: { hash: string; title: string; artist: string; duration: string }): HTMLElement {
      const row = make(
        'div',
        'group flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-lg hover:bg-surface-container transition-colors',
      );
      row.dataset.card = 'track';
      row.dataset.category = 'kugou';

      const left = make('div', 'flex items-center gap-3 min-w-0');
      const button = make(
        'button',
        'w-8 h-8 rounded-full bg-surface-container-high group-hover:bg-primary group-hover:text-on-primary flex items-center justify-center text-on-surface-variant transition-colors flex-shrink-0',
      );
      button.type = 'button';
      button.setAttribute('data-play', '');
      button.dataset.hash = track.hash;
      button.dataset.title = track.title;
      button.dataset.artist = track.artist;
      button.dataset.external = searchUrl(track.title, track.artist);
      button.setAttribute('aria-label', `播放 ${track.title}`);
      button.append(make('span', 'material-symbols-outlined text-sm', 'play_arrow'));

      const meta = make('div', 'flex flex-col min-w-0');
      meta.append(
        make(
          'span',
          'font-headline-sm text-base text-primary truncate group-hover:text-on-tertiary-container transition-colors',
          track.title,
        ),
        make('span', 'font-label-sm text-label-sm text-on-surface-variant truncate', track.artist),
      );
      left.append(button, meta);

      const right = make('div', 'flex items-center gap-3 flex-shrink-0 pl-11 sm:pl-0');
      right.append(
        make(
          'span',
          'px-2 py-0.5 rounded font-label-sm text-xs bg-secondary-container text-on-secondary-container hidden sm:inline-block',
          '站内播放',
        ),
        make('span', 'font-label-sm text-label-sm text-on-surface-variant tabular-nums', track.duration),
      );
      row.append(left, right);
      return row;
    }

    function render(data: {
      page: number;
      totalPages: number;
      playlist: { slug: string };
      tracks: Array<{ hash: string; title: string; artist: string; duration: string }>;
    }) {
      if (!playlistList) return;
      playlistList.replaceChildren(...data.tracks.map(buildRow));
      activeSlug = data.playlist.slug;
      activePage = data.page;
      totalPages = data.totalPages;
      if (playlistSelect) playlistSelect.value = data.playlist.slug;
      if (pageInfo) pageInfo.textContent = `第 ${data.page} / ${data.totalPages} 页`;
      if (pagePrev) pagePrev.disabled = data.page <= 1;
      if (pageNext) pageNext.disabled = data.page >= data.totalPages;
    }

    async function loadPlaylist(slug: string, page: number) {
      if (!playlistList) return;
      playlistList.setAttribute('aria-busy', 'true');
      try {
        const response = await fetch(
          `/api/kugou/playlist?slug=${encodeURIComponent(slug)}&page=${page}&pageSize=${PAGE_SIZE}`,
          { headers: { accept: 'application/json' } },
        );
        const data = await response.json();
        if (!response.ok || !data?.ok) throw new Error(data?.error || 'load_failed');
        render(data);
      } catch {
        playlistList.replaceChildren(
          make(
            'p',
            'rounded-lg border border-dashed border-outline-variant p-6 text-center font-body-sm text-body-sm text-on-surface-variant',
            '歌单加载失败，稍后再试。',
          ),
        );
      } finally {
        playlistList.removeAttribute('aria-busy');
      }
    }

    playlistSelect?.addEventListener('change', () => void loadPlaylist(playlistSelect.value, 1));
    pagePrev?.addEventListener('click', () => void loadPlaylist(activeSlug, Math.max(1, activePage - 1)));
    pageNext?.addEventListener('click', () => void loadPlaylist(activeSlug, Math.min(totalPages, activePage + 1)));
  </script>
</BaseLayout>
