<div class="rounded overflow-hidden aspect-square bg-surface-container-highest relative group">
<img alt="Anime aesthetic sky" class="w-full h-full object-cover" decoding="async" height="279" loading="lazy" src="/images/anime-sky.jpg" width="512"/><span class="absolute bottom-1 left-1 px-1 rounded bg-primary/70 text-on-primary font-label-sm text-[0.625rem]">校园摄影</span>
</div>
<div class="rounded overflow-hidden aspect-square bg-surface-container-highest relative group">
<img alt="Anime city night view" class="w-full h-full object-cover" decoding="async" height="279" loading="lazy" src="/images/photos/store.jpg" width="512"/><span class="absolute bottom-1 left-1 px-1 rounded bg-primary/70 text-on-primary font-label-sm text-[0.625rem]">动漫氛围</span>
</div>
<div class="rounded overflow-hidden aspect-square bg-primary/10 flex flex-col items-center justify-center p-2 text-center border border-dashed border-secondary">
