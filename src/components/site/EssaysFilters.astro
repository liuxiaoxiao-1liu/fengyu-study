---
interface Props {
  totalCount: number;
  essayCount: number;
  microCount: number;
  quoteCount: number;
}

const { totalCount, essayCount, microCount, quoteCount } = Astro.props;

const tabs = [
  { target: 'all', label: '全部随笔', count: totalCount },
  { target: 'essay', label: '网文与动漫', count: essayCount },
  { target: 'micro', label: '碎碎念', count: microCount },
  { target: 'excerpt', label: '台词摘录', count: quoteCount },
];
---

<div class="scroll-row" role="group" aria-label="按类型筛选随记">
  {tabs.map((tab, index) => (
    <button
      class="filter-pill filter-tab"
      type="button"
      data-target={tab.target}
      aria-pressed={index === 0 ? 'true' : 'false'}
    >
      {tab.label}
      <span class="font-meta text-meta opacity-70 tabular-nums">{tab.count}</span>
    </button>
  ))}
</div>
