---
import BaseLayout from '../layouts/BaseLayout.astro';
import { essays, formatEssayDate } from '../data/essays';
import { quotes } from '../data/quotes';

const sortedEssays = [...essays].sort((a, b) => b.date.localeCompare(a.date));
const essayCount = sortedEssays.filter((essay) => essay.kind === 'essay').length;
const microCount = sortedEssays.filter((essay) => essay.kind === 'micro').length;
const microEssays = sortedEssays.filter((essay) => essay.kind === 'micro');

// 正文是 HTML 字符串，统计字数前先去掉标签与空白。
const totalChars = essays.reduce(
  (sum, essay) => sum + essay.body.replace(/<[^>]*>/g, '').replace(/\s+/g, '').length,
  0,
);

const tagCounts = new Map<string, number>();
for (const essay of essays) {
  for (const tag of essay.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 8);

const archiveYears = [...new Set(sortedEssays.map((essay) => essay.date.slice(0, 4)))].sort().join('–');
---

<BaseLayout current="essays" title="随记">
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-14rem)]" id="main">
    <div class="flex flex-col w-full">
      <!-- Subtle Grain & Ambient Glow Canvas -->
      <div class="relative w-full overflow-hidden pb-space-xl">
        <div class="absolute -top-32 -left-20 w-96 h-96 rounded-full bg-secondary-container/30 blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/3 -right-24 w-80 h-80 rounded-full bg-tertiary-fixed/20 blur-3xl pointer-events-none"></div>
        <!-- Editorial Header Banner -->
        <section class="w-full max-w-7xl mx-auto px-gutter pt-space-lg mb-space-xl">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-lg pb-space-lg">
            <div class="flex flex-col max-w-2xl">
              <div class="flex items-center gap-space-xs text-secondary mb-space-xs">
                <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-semibold">
                  Folio Volume 04
                </span>
                <span class="text-xs text-on-surface-variant/40">/</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">
                  Archived Thoughts &amp; Ephemera
                </span>
              </div>
              <h1 class="font-display text-primary tracking-tight font-normal leading-none mb-space-sm text-display-mobile sm:text-display">
                漫步随记
                <span class="font-headline-md text-headline-md italic text-on-surface-variant font-light ml-space-xs">
                  Writings &amp; Ephemera
                </span>
              </h1>
              <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
                不设限的网文追更札记、酷狗歌单沉迷、二次元动漫与大学日常琐碎。记录穿梭在虚拟世界与现实操场晚风里的微小共鸣与精神避难所。
              </p>
            </div>
            <!-- Filter Pill Group -->
            <div class="flex flex-wrap items-center gap-space-xs bg-surface-container-low p-1.5 rounded-full shadow-sm">
              <button
                class="filter-tab active px-space-md py-space-xs rounded-full font-label-md text-label-md bg-primary-container text-on-primary shadow-sm transition-all"
                data-target="all"
                type="button"
              >
                全部随笔
                <span class="ml-1 opacity-70 font-label-sm text-[0.625rem]">{sortedEssays.length}</span>
              </button>
              <button
                class="filter-tab px-space-md py-space-xs rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all"
                data-target="essay"
                type="button"
              >
                网文与动漫
                <span class="ml-1 opacity-70 font-label-sm text-[0.625rem]">{essayCount}</span>
              </button>
              <button
                class="filter-tab px-space-md py-space-xs rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all"
                data-target="micro"
                type="button"
              >
                碎碎念
                <span class="ml-1 opacity-70 font-label-sm text-[0.625rem]">{microCount}</span>
              </button>
              <button
                class="filter-tab px-space-md py-space-xs rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all"
                data-target="excerpt"
                type="button"
              >
                台词摘录
                <span class="ml-1 opacity-70 font-label-sm text-[0.625rem]">{quotes.length}</span>
              </button>
            </div>
          </div>
        </section>
        <!-- Main Content Asymmetric 12-Column Grid -->
        <div class="w-full max-w-7xl mx-auto px-gutter">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            <div class="lg:col-span-8 flex flex-col gap-8" id="essays">
              {sortedEssays.map((essay, index) => (
                <article
                  class="group relative bg-surface-container-low/70 rounded-xl p-8 md:p-10 transition-all duration-300 hover:shadow-md hover:bg-surface-container-low"
                  data-target={essay.kind}
                >
                  <div class="flex items-center justify-between gap-space-md mb-2">
                    <div class="flex items-center gap-space-md text-on-surface-variant font-label-sm text-label-sm">
                      <span class="text-secondary font-medium tracking-wide">{essay.category}</span>
                      <span class="text-outline-variant text-xs">·</span>
                      <time datetime={essay.date}>{formatEssayDate(essay.date)}</time>
                      <span class="text-outline-variant text-xs">·</span>
                      <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">schedule</span>
                        {essay.readMinutes}分钟阅读
                      </span>
                    </div>
                    <span class="font-label-sm text-xs text-on-surface-variant/60 tracking-wider font-mono">
                      #{String(sortedEssays.length - index).padStart(3, '0')}
                    </span>
                  </div>
                  <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight font-normal mb-3 group-hover:text-primary-container transition-colors">
                    <a
                      class="hover:underline decoration-on-tertiary-container decoration-1 underline-offset-4"
                      href={`/essays/${essay.slug}/`}
                    >
                      {essay.title}
                    </a>
                  </h2>
                  <div class="mb-4 p-5 bg-surface-container/60 rounded-lg pl-6 border-l-2 border-secondary/40 flex items-start gap-space-sm">
                    <p class="font-quote text-quote italic text-primary leading-relaxed">{essay.quote}</p>
                  </div>
                  <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed mb-5">{essay.summary}</p>
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-md pt-4 border-t border-outline-variant/20">
                    <div class="flex items-center gap-space-sm flex-wrap text-on-surface-variant font-label-sm text-xs">
                      {essay.tags.map((tag) => (
                        <span class="hover:text-primary transition-colors cursor-pointer">#{tag}</span>
                      ))}
                    </div>
                    <a
                      class="inline-flex items-center gap-space-xs font-label-md text-label-md text-primary font-medium hover:text-on-tertiary-container transition-colors group/link"
                      href={`/essays/${essay.slug}/`}
                    >
                      <span class="">阅读全文</span>
                      <span class="material-symbols-outlined text-base transition-transform group-hover/link:translate-x-1">
                        arrow_forward
                      </span>
                    </a>
                  </div>
                </article>
              ))}
              <p
                class="hidden rounded-xl border border-dashed border-outline-variant p-8 text-center font-body-sm text-body-sm text-on-surface-variant"
                id="essays-empty"
              >
                这一类的文字还在整理中，先去翻翻别的吧。
              </p>
              <section class="mt-2" data-excerpt-section id="excerpt">
                <div class="flex flex-wrap items-end justify-between gap-space-sm border-b border-surface-container-high pb-3 mb-5">
                  <div>
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest block mb-1">
                      Excerpts · 台词摘录
                    </span>
                    <h2 class="font-headline-md text-headline-md text-primary font-normal">被划线的句子</h2>
                  </div>
                  <span class="font-label-sm text-label-sm text-on-surface-variant">
                    {quotes.length} 条摘录 · 来自随记与歌单
                  </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {quotes.map((quote) => (
                    <article
                      class="group bg-surface-container-low/70 rounded-xl p-5 border-l-2 border-secondary/50 shadow-sm transition-colors hover:bg-surface-container-low"
                      data-target="excerpt"
                    >
                      <blockquote class="font-quote text-[1.05rem] leading-relaxed italic text-primary">
                        {quote.text}
                      </blockquote>
                      <div class="mt-4 flex flex-col gap-1">
                        <span class="font-label-sm text-label-sm text-secondary font-medium">{quote.source}</span>
                        {quote.work && (
                          <span class="font-label-sm text-[0.625rem] text-on-surface-variant">{quote.work}</span>
                        )}
                      </div>
                      <div class="mt-3 flex flex-wrap gap-1.5">
                        {quote.tags.map((tag) => (
                          <span class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant font-label-sm text-[0.625rem]">
                            #{tag}
                          </span>
                        ))}
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            </div>
            <aside class="lg:col-span-4 flex flex-col gap-8">
              <div class="bg-surface-container-low/70 rounded-xl p-6 shadow-sm">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary text-base">edit_calendar</span>
                    <h3 class="font-headline-sm text-headline-sm text-primary font-normal">书写脉络</h3>
                  </div>
                  <span class="font-label-sm text-xs text-secondary font-mono font-medium tracking-wider">
                    {archiveYears} ARCHIVE
                  </span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant mb-5 leading-relaxed">
                  已沉淀
                  <span class="text-primary font-semibold">{totalChars.toLocaleString('zh-CN')}</span> 字 · 收录
                  <span class="text-secondary font-semibold">{essays.length}</span> 篇随笔
                </p>
                <div class="p-4 bg-surface-container/60 rounded-lg overflow-hidden flex items-center justify-center">
                  <svg
                    aria-label="Writing frequency activity map"
                    class="w-full max-w-full h-auto text-on-surface-variant"
                    viewBox="0 0 238 64"
                  >
                    <g class="fill-surface-variant">
                      <rect class="fill-secondary/80" height="12" rx="2" width="12" x="0" y="0"></rect>
                      <rect class="fill-secondary/30" height="12" rx="2" width="12" x="16" y="0"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="32" y="0"></rect>
                      <rect class="fill-secondary/60" height="12" rx="2" width="12" x="48" y="0"></rect>
                      <rect class="fill-secondary" height="12" rx="2" width="12" x="64" y="0"></rect>
                      <rect class="fill-secondary/40" height="12" rx="2" width="12" x="80" y="0"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="96" y="0"></rect>
                      <rect class="fill-secondary/80" height="12" rx="2" width="12" x="112" y="0"></rect>
                      <rect class="fill-secondary" height="12" rx="2" width="12" x="128" y="0"></rect>
                      <rect class="fill-secondary/60" height="12" rx="2" width="12" x="144" y="0"></rect>
                      <rect class="fill-secondary/20" height="12" rx="2" width="12" x="160" y="0"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="176" y="0"></rect>
                      <rect class="fill-secondary/70" height="12" rx="2" width="12" x="192" y="0"></rect>
                      <rect class="fill-secondary" height="12" rx="2" width="12" x="208" y="0"></rect>
                      <rect class="fill-secondary" height="12" rx="2" width="12" x="224" y="0"></rect>
                      <rect class="fill-secondary/40" height="12" rx="2" width="12" x="0" y="16"></rect>
                      <rect class="fill-secondary/90" height="12" rx="2" width="12" x="16" y="16"></rect>
                      <rect class="fill-secondary/50" height="12" rx="2" width="12" x="32" y="16"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="48" y="16"></rect>
                      <rect class="fill-secondary/20" height="12" rx="2" width="12" x="64" y="16"></rect>
                      <rect class="fill-secondary/80" height="12" rx="2" width="16" x="80" y="16"></rect>
                      <rect class="fill-secondary" height="12" rx="2" width="12" x="96" y="16"></rect>
                      <rect class="fill-secondary/60" height="12" rx="2" width="12" x="112" y="16"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="128" y="16"></rect>
                      <rect class="fill-secondary/30" height="12" rx="2" width="12" x="144" y="16"></rect>
                      <rect class="fill-secondary/90" height="12" rx="2" width="12" x="160" y="16"></rect>
                      <rect class="fill-secondary/40" height="12" rx="2" width="12" x="176" y="16"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="192" y="16"></rect>
                      <rect class="fill-secondary/80" height="12" rx="2" width="12" x="208" y="16"></rect>
                      <rect class="fill-secondary/60" height="12" rx="2" width="12" x="224" y="16"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="0" y="32"></rect>
                      <rect class="fill-secondary/40" height="12" rx="2" width="12" x="16" y="32"></rect>
                      <rect class="fill-secondary/70" height="12" rx="2" width="12" x="32" y="32"></rect>
                      <rect class="fill-secondary" height="12" rx="2" width="12" x="48" y="32"></rect>
                      <rect class="fill-secondary/60" height="12" rx="2" width="12" x="64" y="32"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="80" y="32"></rect>
                      <rect class="fill-secondary/40" height="12" rx="2" width="12" x="96" y="32"></rect>
                      <rect class="fill-secondary/80" height="12" rx="2" width="12" x="112" y="32"></rect>
                      <rect class="fill-secondary" height="12" rx="2" width="12" x="128" y="32"></rect>
                      <rect class="fill-secondary/50" height="12" rx="2" width="12" x="144" y="32"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="160" y="32"></rect>
                      <rect class="fill-secondary/70" height="12" rx="2" width="12" x="176" y="32"></rect>
                      <rect class="fill-secondary/90" height="12" rx="2" width="12" x="192" y="32"></rect>
                      <rect class="fill-secondary/30" height="12" rx="2" width="12" x="208" y="32"></rect>
                      <rect class="fill-secondary/50" height="12" rx="2" width="12" x="224" y="32"></rect>
                      <rect class="fill-secondary/30" height="12" rx="2" width="12" x="0" y="48"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="16" y="48"></rect>
                      <rect class="fill-secondary/80" height="12" rx="2" width="12" x="32" y="48"></rect>
                      <rect class="fill-secondary" height="12" rx="2" width="12" x="48" y="48"></rect>
                      <rect class="fill-secondary/40" height="12" rx="2" width="12" x="64" y="48"></rect>
                      <rect class="fill-secondary/70" height="12" rx="2" width="12" x="80" y="48"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="96" y="48"></rect>
                      <rect class="fill-secondary/30" height="12" rx="2" width="12" x="112" y="48"></rect>
                      <rect class="fill-secondary/90" height="12" rx="2" width="12" x="128" y="48"></rect>
                      <rect class="fill-secondary" height="12" rx="2" width="12" x="144" y="48"></rect>
                      <rect class="fill-secondary/50" height="12" rx="2" width="12" x="160" y="48"></rect>
                      <rect class="fill-surface-dim" height="12" rx="2" width="12" x="176" y="48"></rect>
                      <rect class="fill-secondary/60" height="12" rx="2" width="12" x="192" y="48"></rect>
                      <rect class="fill-secondary" height="12" rx="2" width="12" x="208" y="48"></rect>
                      <rect class="fill-secondary/80" height="12" rx="2" width="12" x="224" y="48"></rect>
                    </g>
                  </svg>
                </div>
                <div class="flex items-center justify-between text-[0.625rem] font-label-sm text-on-surface-variant/70 mt-3 px-1">
                  <span class="">少 (Quiet)</span>
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-xs bg-surface-dim"></span>
                    <span class="w-2 h-2 rounded-xs bg-secondary/30"></span>
                    <span class="w-2 h-2 rounded-xs bg-secondary/60"></span>
                    <span class="w-2 h-2 rounded-xs bg-secondary"></span>
                  </div>
                  <span class="">多 (Prolific)</span>
                </div>
              </div>
              <div class="bg-surface-container-low/70 rounded-xl p-6 shadow-sm">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-outline-variant/20">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary text-base">forum</span>
                    <h3 class="font-headline-sm text-headline-sm text-primary font-normal">即刻手记</h3>
                  </div>
                  <span class="flex h-2 w-2 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-secondary"></span>
                  </span>
                </div>
                <div class="flex flex-col gap-4">
                  {microEssays.slice(0, 3).map((essay) => (
                    <a
                      class="block p-5 bg-surface-container/60 rounded-lg relative overflow-hidden transition-all hover:bg-surface-container"
                      href={`/essays/${essay.slug}/`}
                    >
                      <div class="flex items-center justify-between mb-2 text-on-surface-variant">
                        <span class="font-label-sm text-xs text-secondary font-medium flex items-center gap-1.5">
                          <span class="material-symbols-outlined text-xs">pets</span>
                          {essay.category}
                        </span>
                        <time class="font-mono text-xs opacity-60" datetime={essay.date}>
                          {formatEssayDate(essay.date)}
                        </time>
                      </div>
                      <p class="font-body-sm text-body-sm text-primary leading-relaxed">{essay.summary}</p>
                    </a>
                  ))}
                </div>
                <a
                  class="w-full mt-4 py-2.5 px-4 bg-surface text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-lg text-center font-label-sm text-xs transition-colors flex items-center justify-center gap-2 border border-outline-variant/30"
                  href="/guestbook/"
                >
                  <span class="material-symbols-outlined text-sm">add_comment</span>
                  <span class="">去留言板写下片刻思绪</span>
                </a>
              </div>
              <div class="bg-surface-container-low/70 rounded-xl p-6 shadow-sm">
                <div class="flex items-center gap-2 mb-4">
                  <span class="material-symbols-outlined text-secondary text-base">label</span>
                  <h3 class="font-headline-sm text-headline-sm text-primary font-normal">主题检索</h3>
                </div>
                <div class="flex flex-wrap gap-2 text-xs font-label-sm">
                  {topTags.map(([tag, count]) => (
                    <span class="px-3 py-1.5 bg-surface-container/70 rounded-full text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors">
                      #{tag} {count}
                    </span>
                  ))}
                </div>
              </div>
              <div class="bg-primary-container text-on-primary rounded-xl p-6 relative overflow-hidden shadow-sm">
                <span class="font-label-sm text-[0.625rem] tracking-widest uppercase opacity-70 block mb-1 font-mono">
                  QUARTERLY ZINE
                </span>
                <h4 class="font-headline-sm text-headline-sm text-on-primary font-normal mb-2">风屿季刊投递</h4>
                <p class="font-body-sm text-body-sm text-inverse-primary/80 mb-5 leading-relaxed">
                  每季度末整理一份不公开的长文与私藏歌单，以信件形式投递至邮箱。
                </p>
                <form class="flex flex-col gap-space-sm" id="newsletter-form" novalidate>
                  <input
                    aria-hidden="true"
                    autocomplete="off"
                    class="hidden"
                    name="website"
                    tabindex="-1"
                    type="text"
                  />
                  <label class="sr-only" for="newsletter-email">
                    接收季刊的邮箱
                  </label>
                  <input
                    class="w-full px-4 py-2.5 rounded-lg bg-white/10 text-on-primary placeholder:text-white/40 font-label-md text-label-md focus:outline-none focus:bg-white/15 transition-colors"
                    placeholder="your-email@campus.edu"
                    type="email"
                    id="newsletter-email"
                    name="email"
                    required
                    aria-describedby="newsletter-note"
                  />
                  <button
                    class="w-full py-2.5 px-4 rounded-lg bg-surface text-primary font-label-md text-label-md font-medium hover:bg-surface-container transition-colors disabled:opacity-60 disabled:cursor-wait flex items-center justify-center gap-2"
                    type="submit"
                  >
                    <span class="">订阅候信</span>
                    <span class="material-symbols-outlined text-sm">outgoing_mail</span>
                  </button>
                </form>
                <p
                  class="font-label-sm text-[0.6875rem] text-white/60 leading-relaxed"
                  id="newsletter-note"
                  role="status"
                  aria-live="polite"
                >
                  每季度一封，随时可以退订。也可以先用{' '}
                  <a class="underline text-white/80" href="/rss.xml">
                    RSS
                  </a>{' '}
                  把书房装进口袋。
                </p>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script>
    const tabs = [...document.querySelectorAll<HTMLElement>('.filter-tab')];
    const cards = [...document.querySelectorAll<HTMLElement>('article[data-target]')];
    const empty = document.getElementById('essays-empty');
    const excerptSection = document.querySelector<HTMLElement>('[data-excerpt-section]');

    function apply(target: string) {
      let shown = 0;
      for (const card of cards) {
        const match = target === 'all' || card.dataset.target === target;
        card.classList.toggle('hidden', !match);
        if (match) shown += 1;
      }
      // 「台词摘录」是独立卡片区，切到随笔筛选时整块收起。
      excerptSection?.classList.toggle('hidden', target !== 'all' && target !== 'excerpt');
      empty?.classList.toggle('hidden', shown !== 0);
    }

    const newsletter = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
    const newsletterNote = document.getElementById('newsletter-note');
    const newsletterSubmit = newsletter?.querySelector<HTMLButtonElement>('button[type="submit"]');

    const setNote = (message: string) => {
      if (newsletterNote) newsletterNote.textContent = message;
    };

    newsletter?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = emailInput?.value.trim() ?? '';
      if (!email || !emailInput?.checkValidity()) {
        setNote('邮箱格式好像不太对，再检查一下。');
        emailInput?.focus();
        return;
      }
      newsletterSubmit?.setAttribute('disabled', '');
      setNote('正在投递…');
      try {
        const honeypot = newsletter?.querySelector<HTMLInputElement>('[name="website"]')?.value ?? '';
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ email, website: honeypot }),
        });
        const data = (await response.json().catch(() => ({ ok: false }))) as { ok?: boolean };
        if (response.ok && data.ok !== false) {
          setNote('已加入季刊名单，寄出前会先给你写信。');
          newsletter?.reset();
        } else if (response.status === 429) {
          setNote('投递太频繁了，请稍后再试。');
        } else if (response.status === 400) {
          setNote('邮箱格式好像不太对，再检查一下。');
        } else {
          setNote('订阅暂不可用，稍后再试，或先用 RSS 订阅。');
        }
      } catch {
        setNote('网络好像断了，稍后再试，或先用 RSS 订阅。');
      } finally {
        newsletterSubmit?.removeAttribute('disabled');
      }
    });

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        for (const t of tabs) {
          t.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-sm');
          t.classList.add('text-on-surface-variant');
        }
        tab.classList.remove('text-on-surface-variant');
        tab.classList.add('bg-primary-container', 'text-on-primary', 'shadow-sm');
        apply(tab.dataset.target || 'all');
      });
    }
  </script>
</BaseLayout>
