---
interface Props {
  webnovelCount: number;
  suspenseCount: number;
  trackCount: number;
  repeatCount: number;
}

const { webnovelCount, suspenseCount, trackCount, repeatCount } = Astro.props;

const tabs = [
  { filter: 'all', label: '全部', count: null },
  { filter: 'webnovel', label: '玄幻奇幻', count: webnovelCount },
  { filter: 'suspense', label: '悬疑志怪', count: suspenseCount },
  { filter: 'kugou', label: '编辑精选', count: trackCount },
  { filter: 'repeat', label: '单曲循环', count: repeatCount },
];
---

<div class="scroll-row mt-5" role="group" aria-label="筛选读听内容">
  {tabs.map((tab, index) => (
    <button
      class="filter-pill filter-btn"
      data-filter={tab.filter}
      type="button"
      aria-pressed={index === 0 ? 'true' : 'false'}
    >
      <span>{tab.label}</span>
      {tab.count !== null && <span class="font-meta text-meta opacity-70 tabular-nums">{tab.count}</span>}
    </button>
  ))}
</div>
