---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadingHero from '../components/site/ReadingHero.astro';
import ReadingFilters from '../components/site/ReadingFilters.astro';
import Bookshelf from '../components/site/Bookshelf.astro';
import MusicShelf from '../components/site/MusicShelf.astro';
import { listAlbums, listBooks, listTracks } from '../lib/content-db';
import { isKugouConfigured } from '../lib/kugou';

export const prerender = false;

const books = listBooks();
const albums = listAlbums();
const tracks = listTracks();

const PLAYLIST_SLUG = 'kugou';
const kugouConfigured = isKugouConfigured();

const webnovelCount = books.filter((book) => book.category === 'webnovel').length;
const suspenseCount = books.filter((book) => book.category === 'suspense').length;
const repeatCount = tracks.filter((track) => track.repeat).length;
---

<BaseLayout current="reading" title="读听">
  <main class="w-full bg-surface" id="main">
    <div class="flex w-full flex-col gap-12 pb-section pt-nav-h">
      <section class="section pb-0">
        <ReadingHero bookCount={books.length} albumCount={albums.length} kugouConfigured={kugouConfigured} />
        <ReadingFilters
          webnovelCount={webnovelCount}
          suspenseCount={suspenseCount}
          trackCount={tracks.length}
          repeatCount={repeatCount}
        />
      </section>
      <Bookshelf books={books} />
      <MusicShelf
        albums={albums}
        tracks={tracks}
        playlistSlug={PLAYLIST_SLUG}
        playlistName="酷狗歌单"
        configured={kugouConfigured}
        bookCount={books.length}
      />
    </div>
  </main>
  <script>
    import '../scripts/site/reading.ts';
  </script>
</BaseLayout>
