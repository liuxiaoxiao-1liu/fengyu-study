---
import type { Photo } from '../../data/photos';
import { SERIES_LABELS } from '../../data/photos';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<div class="mt-8" id="gallery">
  <div class="grid grid-cols-1 items-stretch gap-5 md:grid-cols-2 lg:grid-cols-3">
    {photos.map((photo, index) => (
      <article
        class="photo-card group flex cursor-pointer flex-col rounded-xl border border-line bg-surface-container-low p-3 transition-colors duration-200 hover:bg-surface-container focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-decor"
        data-series={photo.series}
        data-photo-open={photo.slug}
        role="button"
        tabindex="0"
        aria-label={`打开《${photo.title}》大图`}
      >
        <div class="relative aspect-[4/3] w-full overflow-hidden rounded-lg bg-surface-container">
          <img
            alt={photo.alt}
            class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
            decoding="async"
            height={photo.height}
            loading={index < 3 ? 'eager' : 'lazy'}
            src={photo.src}
            width={photo.width}
          />
          <span class="absolute left-2 top-2 rounded bg-primary/70 px-2 py-0.5 font-meta text-meta uppercase tracking-[0.12em] text-on-primary backdrop-blur-sm">
            {photo.badge}
          </span>
          <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-primary/85 via-primary/20 to-transparent p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            <p class="font-quote text-body-md italic leading-relaxed text-on-primary">“{photo.note}”</p>
            <span class="mt-1 font-meta text-meta text-on-primary/70">点击看大图 · 查看拍摄信息</span>
          </div>
        </div>
        <div class="flex items-baseline justify-between gap-3 px-1 pb-1 pt-3">
          <h2 class="truncate font-headline-sm text-headline-sm text-primary">{photo.title}</h2>
          <span class="shrink-0 font-label-sm text-secondary">{SERIES_LABELS[photo.series]}</span>
        </div>
      </article>
    ))}
  </div>
</div>
