---
const tags = ['网文同好', '音乐安利', '大学日常', '漂流寄语'];
---

<input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  <div class="flex flex-col gap-1.5">
    <label class="field-label flex items-center justify-between" for="author-name">
      <span>昵称 / 笔名</span>
      <span class="text-muted">必填</span>
    </label>
    <input class="field" id="author-name" name="author" placeholder="例：某位塔罗会潜水成员" required type="text" />
  </div>
  <div class="flex flex-col gap-1.5">
    <label class="field-label flex items-center justify-between" for="music-station">
      <span>常驻地 / 推荐单曲</span>
      <span class="text-muted">选填</span>
    </label>
    <input class="field" id="music-station" name="station" placeholder="例：成都 · 《大鱼》" type="text" />
  </div>
</div>

<div class="flex flex-col gap-1.5">
  <span class="field-label">信件类型 / 归档标签</span>
  <div class="flex flex-wrap gap-1.5" id="tag-capsules" role="group" aria-label="信件类型">
    {tags.map((tag, index) => (
      <button
        class="tag-pill min-h-11 rounded-full border border-line px-3.5 py-1 font-label-sm text-label-sm transition-colors"
        data-tag={tag}
        type="button"
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        {tag}
      </button>
    ))}
  </div>
</div>

<div class="flex flex-col gap-1.5">
  <label class="field-label flex items-center justify-between" for="message-content">
    <span>信笺正文 / 拾光感触</span>
    <span class="text-muted" id="char-counter">
      0 / 600
    </span>
  </label>
  <textarea
    class="field resize-y leading-relaxed"
    id="message-content"
    maxlength="600"
    name="message"
    placeholder="写下你眼前的日落，或是最近循环不休的旋律…"
    required
    rows="4"
  ></textarea>
</div>

<div class="flex flex-wrap items-center justify-between gap-3">
  <label class="flex min-h-11 cursor-pointer select-none items-center gap-2">
    <input class="h-4 w-4 accent-secondary" id="private-check" name="private" type="checkbox" />
    <span class="flex flex-col">
      <span class="flex items-center gap-1 text-body-sm text-primary">
        <span class="material-symbols-outlined text-sm text-muted" aria-hidden="true">
          lock
        </span>
        仅房主可见（悄悄话）
      </span>
      <span class="text-label-sm text-muted">勾选后不会公开上墙，仅在后台查阅</span>
    </span>
  </label>
  <span class="meta hidden italic sm:inline">Paper Texture Encrypted</span>
</div>

<div class="flex flex-col items-center justify-between gap-3 border-t border-line pt-4 sm:flex-row">
  <div class="flex w-full flex-wrap items-center gap-2 sm:w-auto">
    <button class="btn-primary flex-1 sm:flex-none" type="submit">
      <span class="material-symbols-outlined text-base" aria-hidden="true">
        send
      </span>
      投递信笺
    </button>
    <button class="btn-secondary" data-fish="" title="随机捞取一条前人留下的时光寄语" type="button">
      <span class="material-symbols-outlined text-base text-secondary" aria-hidden="true">
        explore
      </span>
      漂流瓶
    </button>
  </div>
  <p class="text-center text-label-sm text-muted sm:text-right">每晚 22:30 – 23:30 拆信回复</p>
</div>
