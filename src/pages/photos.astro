---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import PhotosHero from '../components/site/PhotosHero.astro';
import PhotosFilters from '../components/site/PhotosFilters.astro';
import PhotoGallery from '../components/site/PhotoGallery.astro';
import PhotosNotes from '../components/site/PhotosNotes.astro';
import { SERIES_FILTERS } from '../data/photos';
import { listPhotos } from '../lib/content-db';

export const prerender = false;

const photos = listPhotos();
const series = SERIES_FILTERS.map((item) => ({
  ...item,
  count: photos.filter((photo) => photo.series === item.value).length,
}));
const takenYears = [...new Set(photos.map((photo) => photo.takenAt.slice(0, 4)))].sort();
const yearRange =
  takenYears.length > 1 ? `${takenYears[0]}–${takenYears[takenYears.length - 1]}` : (takenYears[0] ?? '');
---

<BaseLayout current="photos" title="影集">
  <main class="w-full bg-surface" id="main">
    <div class="flex w-full flex-col pt-nav-h">
      <section class="section pb-0">
        <PhotosHero photoCount={photos.length} />
        <PhotosFilters photoCount={photos.length} series={series} />
      </section>

      <section class="section pt-8">
        <PhotoGallery photos={photos} />
        <PhotosNotes photoCount={photos.length} seriesCount={SERIES_FILTERS.length} yearRange={yearRange} />
      </section>
    </div>

    <PhotoLightbox photos={photos} />
  </main>
  <script>
    import '../scripts/site/photos.ts';
  </script>
</BaseLayout>
