<!-- Filter Bar & Section Header -->
<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-space-md pb-space-lg">
  <div class="flex flex-col gap-space-xs">
    <div class="flex items-center gap-space-xs text-secondary">
      <span class="material-symbols-outlined text-base">forum</span>
      <span class="font-label-sm text-label-sm uppercase tracking-wider font-semibold">LETTERS ARCHIVE</span>
    </div>
    <h2 class="font-headline-md text-headline-md text-primary">时光留言回廊</h2>
  </div>
  <!-- Filter Tabs -->
  <div
    class="flex items-center gap-space-xs bg-surface-container-low p-1 rounded-full overflow-x-auto"
    id="comment-filters"
    role="group"
    aria-label="留言分类筛选"
  >
    <button
      class="filter-btn px-space-md py-space-xs rounded-full font-label-sm text-label-sm bg-primary text-on-primary transition-all shadow-sm"
      data-filter-category="all"
      type="button"
      aria-pressed="true"
    >
      全部留言 (<span data-filter-count="all">0</span>)
    </button>
  </div>
</div>
