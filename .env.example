# 复制为 .env 后填写；.env 已在 .gitignore，不要提交
# 管理后台令牌：至少 32 位随机串（openssl rand -hex 32）
ADMIN_TOKEN=

# 酷狗会员登录态：扫码登录 KuGouMusicApi 后写入；用于 /api/kugou/url 换播放直链。
# 这些值等于账号凭据，只放服务器 .env，绝不进仓库、不贴聊天。
KUGOU_TOKEN=
KUGOU_USERID=
KUGOU_VIP_TOKEN=
KUGOU_VIP_TYPE=
KUGOU_MID=
KUGOU_GUID=
KUGOU_DFID=

# 站内展示的酷狗歌单名（默认 maotouying）；改这个不需要改代码
KUGOU_PLAYLIST_NAME=

# 内容后台登录（scrypt 哈希，不要填明文密码）；由 scripts/set-admin-password.mjs 生成
ADMIN_USER=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# 内容库与上传目录（容器内默认 /data）
CONTENT_DB=
CONTENT_UPLOADS=

# 后台扫码登录后的酷狗会话与站内歌单选择（容器内默认 /data）
KUGOU_SESSION_FILE=
KUGOU_SETTINGS_FILE=
