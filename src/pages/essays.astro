---
import BaseLayout from '../layouts/BaseLayout.astro';
import EssaysHero from '../components/site/EssaysHero.astro';
import EssaysFilters from '../components/site/EssaysFilters.astro';
import EssayList from '../components/site/EssayList.astro';
import ExcerptSection from '../components/site/ExcerptSection.astro';
import WritingArchive from '../components/site/WritingArchive.astro';
import NewsletterCard from '../components/site/NewsletterCard.astro';
import { listEssays, listQuotes } from '../lib/content-db';

export const prerender = false;

const essays = listEssays();
const quotes = listQuotes();

const sortedEssays = [...essays].sort((a, b) => b.date.localeCompare(a.date));
const essayCount = sortedEssays.filter((essay) => essay.kind === 'essay').length;
const microCount = sortedEssays.filter((essay) => essay.kind === 'micro').length;

// 正文是 HTML 字符串，统计字数前先去掉标签与空白。
const totalChars = essays.reduce(
  (sum, essay) => sum + essay.body.replace(/<[^>]*>/g, '').replace(/\s+/g, '').length,
  0,
);

const archiveYears = [...new Set(sortedEssays.map((essay) => essay.date.slice(0, 4)))].sort().join('–');
---

<BaseLayout current="essays" title="随记">
  <main class="w-full bg-surface" id="main">
    <div class="flex w-full flex-col pt-nav-h">
      <section class="section pb-0">
        <div class="flex flex-col gap-6 border-b border-line pb-6">
          <EssaysHero />
          <EssaysFilters
            totalCount={sortedEssays.length}
            essayCount={essayCount}
            microCount={microCount}
            quoteCount={quotes.length}
          />
        </div>
      </section>

      <section class="section pt-10">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12">
          <div class="flex flex-col gap-8 lg:col-span-8" id="essays">
            <EssayList essays={sortedEssays} />
            <p class="empty-state hidden" id="essays-empty">
              这一类的文字还在整理中，先去翻翻别的吧。
            </p>
            <ExcerptSection quotes={quotes} />
          </div>

          <aside class="flex flex-col gap-6 lg:col-span-4 lg:sticky lg:top-[calc(var(--nav-h)+1.5rem)]">
            <WritingArchive archiveYears={archiveYears} totalChars={totalChars} essayCount={essays.length} />
            <NewsletterCard />
          </aside>
        </div>
      </section>
    </div>
  </main>
  <script>
    import '../scripts/site/essays.ts';
  </script>
</BaseLayout>
