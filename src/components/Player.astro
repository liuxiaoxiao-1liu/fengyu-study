---
// 全站固定迷你播放器：由页面里的 [data-play] 按钮驱动，固定在视口底部。
// 浏览器 <audio> 负责解码；音源地址只通过站内 /api/kugou/url 获取。
---

<section
  id="site-player"
  class="fixed inset-x-0 bottom-0 z-[60] px-gutter pb-3 pointer-events-none"
  data-player
  transition:persist
  hidden
  aria-label="站内播放器"
>
  <div class="pointer-events-auto mx-auto flex w-full max-w-5xl flex-col gap-2 rounded-xl border border-surface-container-high bg-surface/95 p-3 shadow-[0_-8px_30px_rgba(0,0,0,0.12)] backdrop-blur-md sm:flex-row sm:items-center sm:gap-4">
    <div class="flex min-w-0 flex-1 items-center gap-3">
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary"
        aria-hidden="true"
      >
        <span class="material-symbols-outlined text-base">graphic_eq</span>
      </span>
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-2">
          <strong class="truncate text-sm font-medium text-primary" data-player-title>
            还没有选择曲目
          </strong>
          <span
            class="shrink-0 font-label-sm text-[0.625rem] text-on-surface-variant"
            data-player-state
            aria-live="polite"
          >
            · 等待选择
          </span>
        </div>
        <span class="mt-0.5 block truncate text-xs text-on-surface-variant" data-player-artist>
          选择曲目开始播放
        </span>
      </div>
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <span class="font-label-sm text-xs tabular-nums text-on-surface-variant" data-player-current>
        00:00
      </span>
      <input
        class="h-1 min-w-0 flex-1 cursor-pointer accent-secondary disabled:cursor-not-allowed sm:w-32 sm:flex-none"
        data-player-seek
        type="range"
        min="0"
        max="0"
        step="0.1"
        value="0"
        aria-label="播放进度"
        disabled
      />
      <span class="font-label-sm text-xs tabular-nums text-on-surface-variant" data-player-duration>
        --:--
      </span>
      <div class="ml-1 flex shrink-0 items-center gap-1.5">
        <button
          type="button"
          class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-container-high text-on-surface-variant transition-colors hover:bg-primary hover:text-on-primary disabled:opacity-50 disabled:cursor-not-allowed"
          data-player-toggle
          aria-label="播放或暂停"
          disabled
        >
          <span class="flex items-center justify-center" data-player-icon>
            <svg class="h-5 w-5" data-player-icon-play viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z"></path>
            </svg>
            <svg
              class="hidden h-5 w-5"
              data-player-icon-pause
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
            </svg>
          </span>
        </button>
        <a
          class="hidden font-label-sm text-xs text-secondary hover:underline sm:inline-flex items-center gap-1"
          data-player-external
          href="https://www.kugou.com/"
          target="_blank"
          rel="noopener noreferrer external"
        >
          酷狗<span class="material-symbols-outlined text-xs">open_in_new</span>
        </a>
        <button
          type="button"
          class="flex h-8 w-8 items-center justify-center rounded-full text-on-surface-variant transition-colors hover:text-primary"
          data-player-close
          aria-label="收起播放器"
        >
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>
  </div>
  <audio data-player-audio preload="auto"></audio>
</section>

<script>
  import '../scripts/site/player';
</script>

<style is:global>
  body.has-player {
    padding-bottom: 8.25rem;
  }

  @media (min-width: 640px) {
    body.has-player {
      padding-bottom: 5.75rem;
    }
  }
</style>
