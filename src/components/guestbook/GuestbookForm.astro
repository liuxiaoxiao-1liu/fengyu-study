---
import GuestbookFormFields from './GuestbookFormFields.astro';
import GuestbookToast from './GuestbookToast.astro';
---

<div class="card relative flex flex-col overflow-hidden p-6 lg:col-span-7" id="guestbook-form-panel">
  <div class="relative flex items-center justify-between gap-3 border-b border-line pb-3">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-xl text-secondary" aria-hidden="true">
        edit_note
      </span>
      <h2 class="font-headline-sm text-headline-sm text-primary">投递信笺</h2>
    </div>
    <span class="meta">实时同步</span>
  </div>

  <form class="relative mt-4 flex flex-col gap-4" id="guestbook-form-panel">
    <GuestbookFormFields />
  </form>
  <GuestbookToast />
</div>
