---
import type { Essay } from '../../data/essays';
import { formatEssayDate } from '../../data/essays';

interface Props {
  essay: Essay;
}

const { essay } = Astro.props;
---

<article class="card flex flex-col p-6 lg:col-span-7" id="notes">
  <header class="flex items-center justify-between gap-3 border-b border-line pb-3">
    <span class="flex items-center gap-2 font-label-md text-label-md font-medium text-on-surface">
      <span class="material-symbols-outlined text-base text-secondary" aria-hidden="true">
        history_edu
      </span>
      杂感随笔
    </span>
    <span class="meta">{essay.readMinutes} 分钟阅读</span>
  </header>

  <div class="flex flex-1 flex-col justify-center py-5">
    <div class="flex flex-wrap items-center gap-2 text-label-sm text-muted">
      <time datetime={essay.date}>{formatEssayDate(essay.date)}</time>
      <span aria-hidden="true">/</span>
      <span class="font-medium text-secondary">{essay.category}</span>
    </div>
    <h3 class="mt-2 font-headline-md text-headline-md text-primary">
      <a class="transition-colors hover:text-accent" href={`/essays/${essay.slug}/`}>
        {essay.title}
      </a>
    </h3>
    <p class="mt-2 line-clamp-3 text-body-md leading-relaxed text-on-surface-variant">{essay.summary}</p>
  </div>

  <blockquote class="flex items-center gap-2 border-l-2 border-accent-decor bg-surface-container/70 px-4 py-3">
    <span class="font-quote text-body-md italic leading-relaxed text-on-surface-variant">{essay.quote}</span>
  </blockquote>

  <footer class="mt-4 flex items-center justify-between border-t border-line pt-3">
    <span class="meta">随记 · 全文</span>
    <a
      class="inline-flex min-h-9 items-center gap-1 font-label-md text-label-md font-medium text-accent hover:underline"
      href={`/essays/${essay.slug}/`}
    >
      阅读随想全文
      <span class="material-symbols-outlined text-sm" aria-hidden="true">
        arrow_forward
      </span>
    </a>
  </footer>
</article>
